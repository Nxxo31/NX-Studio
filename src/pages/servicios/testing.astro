---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getT, getLocale, localeUrl } from "~/i18n";

const t = getT(Astro);
const locale = getLocale(Astro);

// Testing & QA as a service — tiers + platform fee (modelo OutpostQA).
// NUNCA publicar horas facturadas (regla AGENTS.md).
// Copy vía i18n: pages.serviciosTesting.tiers.<id>.*
const tiers = [
  { id: 'foundation', bulletCount: 4, featured: false },
  { id: 'accelerator', bulletCount: 6, featured: true },
  { id: 'strategic', bulletCount: 6, featured: false },
];
const idx = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<Base
  title={t('pages.serviciosTesting.title')}
  description={t('pages.serviciosTesting.description')}
>
  <Nav />
  <main>
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14 reveal">
          <span class="lava-tag mb-4">// qa.v1</span>
          <h1 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-4">
            {t('pages.serviciosTesting.headingA')} <span class="text-lava">{t('pages.serviciosTesting.headingEm')}</span>
          </h1>
          <p class="text-nx-muted max-w-2xl text-lg">
            {t('pages.serviciosTesting.sub')}
          </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-12">
          {tiers.map((tier) => (
            <article class={`lava-card p-6 lg:p-7 reveal flex flex-col ${tier.featured ? 'lava-card-accent' : ''}`}>
              <div class="flex items-start justify-between mb-3">
                <span class="lava-tag">{t(`pages.serviciosTesting.tiers.${tier.id}.tag`)}</span>
                {tier.featured && <span class="lava-tag" style="background: var(--lava-core); color: black;">{t('pages.serviciosTesting.featured')}</span>}
              </div>
              <h2 class="font-display text-2xl font-bold mb-2">{t(`pages.serviciosTesting.tiers.${tier.id}.name`)}</h2>
              <p class="text-sm text-nx-muted leading-relaxed mb-5">{t(`pages.serviciosTesting.tiers.${tier.id}.desc`)}</p>
              <ul class="space-y-2 mb-5 flex-1">
                {idx(tier.bulletCount).map((i) => (
                  <li class="flex gap-2 text-sm text-nx-muted">
                    <span class="text-lava-edge font-mono shrink-0">▸</span>
                    <span>{t(`pages.serviciosTesting.tiers.${tier.id}.bullets.${i}`)}</span>
                  </li>
                ))}
              </ul>
              <div class="hairline mb-3"></div>
              <p class="text-xs font-mono text-nx-dim">{t(`pages.serviciosTesting.tiers.${tier.id}.platformNote`)}</p>
            </article>
          ))}
        </div>

        <div class="lava-card p-6 lg:p-8 mb-12 reveal">
          <h2 class="font-display text-xl font-bold mb-3">{t('pages.serviciosTesting.pricingModel.title')}</h2>
          <p class="text-nx-muted leading-relaxed mb-3">
            {t('pages.serviciosTesting.pricingModel.p1a')}
            <b class="text-lava-edge">{t('pages.serviciosTesting.pricingModel.platformFee')}</b>
            {t('pages.serviciosTesting.pricingModel.p1b')}
          </p>
          <p class="text-nx-dim text-xs font-mono">
            {t('pages.serviciosTesting.pricingModel.warning')}
          </p>
        </div>

        <div class="lava-card lava-card-accent p-8 lg:p-10 reveal">
          <span class="lava-tag mb-3">// intake</span>
          <h2 class="font-display text-2xl lg:text-3xl font-bold mb-3">
            {t('pages.serviciosTesting.ctaBox.title')}
          </h2>
          <p class="text-nx-muted mb-6 max-w-2xl">
            {t('pages.serviciosTesting.ctaBox.desc')}
          </p>
          <a href={`${localeUrl('/contacto', locale)}?topic=qa`} class="lava-btn">{t('pages.serviciosTesting.ctaBox.cta')}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
