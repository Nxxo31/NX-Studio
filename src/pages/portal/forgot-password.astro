---
// /portal/forgot-password — recuperar acceso al portal.
//
// El POST va a /api/portal/auth/request-password-reset. better-auth genera el
// token y llama a `emailAndPassword.sendResetPassword` de createPortalAuth,
// que lo envía por Resend (o lo loguea si no hay RESEND_API_KEY).
//
// La respuesta SIEMPRE dice lo mismo ("si el correo existe, te enviamos el
// enlace") para no revelar qué emails están registrados.

import Base from '~/layouts/Base.astro';
import Input from '~/components/ui/Input.astro';
import Button from '~/components/ui/Button.astro';

export const prerender = false;
---

<Base title="Recuperar acceso — Portal cliente NX-Studio" description="Recupera el acceso a tu portal de cliente NX-Studio.">
  <main class="mx-auto max-w-md px-6 py-16">
    <div class="portal-login-card">
      <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--nx-primary);">Portal Cliente</p>
      <h1 class="mt-2 font-display text-2xl font-bold">Recupera tu acceso</h1>
      <p class="mt-1 text-sm text-nx-muted">Escribe tu email y te enviamos un enlace para crear una contraseña nueva.</p>

      <form id="portal-forgot-form" class="mt-4" data-testid="portal-forgot-form">
        <Input name="email" type="email" label="Email" required autocomplete="email" />
        <Button type="submit" variant="primary">Enviar enlace</Button>
      </form>

      <p id="portal-forgot-status" class="portal-flash portal-flash-ok hidden mt-4" role="status"></p>
      <p id="portal-forgot-error" class="portal-flash portal-flash-error hidden mt-4" role="alert"></p>

      <p class="mt-6 text-xs text-nx-muted">
        <a href="/portal/login" class="underline">Volver al inicio de sesión</a>
      </p>
    </div>
  </main>
</Base>

<style>
  .portal-login-card {
    background: var(--color-nx-surface, #11132a);
    border: 1px solid var(--color-nx-border, rgba(255,255,255,0.08));
    border-radius: 0.85rem;
    padding: 2rem;
    color: var(--color-nx-ink, #e8eaf6);
  }
  form { display: flex; flex-direction: column; gap: 0.75rem; }
  .portal-flash { padding: 0.5rem 0.75rem; border-radius: 0.4rem; }
  .portal-flash-error { background: rgba(239, 68, 68, 0.14); color: #ef4444; }
  .portal-flash-ok { background: rgba(34, 197, 94, 0.12); color: #86efac; }
</style>

<script>
  const AUTH_BASE = '/api/portal/auth';

  document.getElementById('portal-forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    const status = document.getElementById('portal-forgot-status');
    const error = document.getElementById('portal-forgot-error');

    const ocultar = () => {
      status?.classList.add('hidden');
      error?.classList.add('hidden');
    };

    try {
      const res = await fetch(`${AUTH_BASE}/request-password-reset`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: String(data.get('email') ?? ''),
          redirectTo: window.location.origin + '/portal/login',
        }),
      });
      ocultar();
      if (res.ok) {
        if (status) {
          status.textContent = 'Si ese correo tiene una cuenta, te enviamos el enlace para restablecer tu contraseña.';
          status.classList.remove('hidden');
        }
      } else {
        if (error) {
          error.textContent = 'No pudimos procesar la solicitud. Inténtalo de nuevo.';
          error.classList.remove('hidden');
        }
      }
    } catch {
      ocultar();
      if (error) {
        error.textContent = 'No pudimos conectar. Inténtalo de nuevo en un momento.';
        error.classList.remove('hidden');
      }
    }
  });
</script>
