---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { TEMPLATES } from "../../data/templates";
import { getT, getLocale, localeUrl } from "~/i18n";

const t = getT(Astro);
const locale = getLocale(Astro);
// String/t helpers para copy data-driven de templates.ts (keys por slug).
const tt = (slug: string, field: string) => t(`pages.templates.items.${slug}.${field}`);

// Marketplace de templates comprables — one-time payment, código MIT-licensed.
// Estructura modelo Arc.dev marketplace.
const featured = TEMPLATES.filter((tpl) => tpl.featured);
const rest = TEMPLATES.filter((tpl) => !tpl.featured);

const fmt = new Intl.NumberFormat('en-US');
---

<Base
  title={t('pages.templates.title')}
  description={t('pages.templates.description')}
>
  <Nav />
  <main>
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14 reveal">
          <span class="lava-tag mb-4">// marketplace.v1</span>
          <h1 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-4">
            {t('pages.templates.headingA')} <span class="text-lava">{t('pages.templates.headingEm')}</span>
          </h1>
          <p class="text-nx-muted max-w-2xl text-lg">
            {t('pages.templates.sub')}
          </p>
        </header>

        {featured.length > 0 && (
          <div class="mb-14">
            <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-5 reveal">
              {t('pages.templates.featuredTitle')}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {featured.map((tpl) => (
                <a href={localeUrl(`/templates/${tpl.slug}`, locale)} class="lava-card lava-card-accent p-6 lg:p-7 reveal flex flex-col card-hover">
                  <div class="flex items-start justify-between mb-3">
                    <span class="lava-tag">{tpl.category}</span>
                    <span class="font-display text-2xl font-bold">${fmt.format(tpl.price)}</span>
                  </div>
                  <h3 class="font-display text-2xl font-bold mb-2">{tt(tpl.slug, 'name')}</h3>
                  <p class="text-sm text-lava-edge font-mono mb-3">{tt(tpl.slug, 'tagline')}</p>
                  <p class="text-sm text-nx-muted leading-relaxed flex-1 mb-4">{tt(tpl.slug, 'desc')}</p>
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {tpl.stack.slice(0, 4).map((s) => (
                      <span class="text-xs font-mono text-nx-dim px-2 py-0.5 rounded border border-nx-border">{s}</span>
                    ))}
                    {tpl.stack.length > 4 && (
                      <span class="text-xs font-mono text-nx-dim px-2 py-0.5">+{tpl.stack.length - 4}</span>
                    )}
                  </div>
                  <span class="font-mono text-xs text-lava-edge">{t('pages.templates.viewDetail')}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {rest.length > 0 && (
          <div>
            <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-5 reveal">{t('pages.templates.othersTitle')}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {rest.map((tpl) => (
                <a href={localeUrl(`/templates/${tpl.slug}`, locale)} class="lava-card p-5 reveal flex flex-col card-hover">
                  <div class="flex items-start justify-between mb-3">
                    <span class="lava-tag">{tpl.category}</span>
                    <span class="font-display text-xl font-bold">${fmt.format(tpl.price)}</span>
                  </div>
                  <h3 class="font-display text-lg font-bold mb-2">{tt(tpl.slug, 'name')}</h3>
                  <p class="text-sm text-lava-edge font-mono mb-3">{tt(tpl.slug, 'tagline')}</p>
                  <p class="text-sm text-nx-muted leading-relaxed flex-1">{tt(tpl.slug, 'desc')}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mt-16 lava-card p-8 lg:p-10 reveal">
          <span class="lava-tag mb-3">// faq</span>
          <h2 class="font-display text-2xl font-bold mb-4">{t('pages.templates.faq.title')}</h2>
          <ol class="space-y-3 text-nx-muted">
            {[0, 1, 2, 3].map((i) => (
              <li><span class="text-lava-edge font-mono mr-2">{i + 1}.</span> {t(`pages.templates.faq.steps.${i}`)}</li>
            ))}
          </ol>
          <a href={`${localeUrl('/contacto', locale)}?topic=template`} class="lava-btn mt-6 inline-flex">{t('pages.templates.faq.cta')}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
