---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { TEMPLATES, getTemplateBySlug } from "../../data/templates";

export function getStaticPaths() {
  return TEMPLATES.map((t) => ({
    params: { slug: t.slug },
    props: { template: t },
  }));
}

const { template } = Astro.props;
if (!template) {
  return Astro.redirect('/NX-Studio/templates');
}

const fmt = new Intl.NumberFormat('en-US');
---

<Base
  title={`${template.name} · Templates NX-Studio`}
  description={template.tagline}
>
  <Nav />
  <main>
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-5xl">
        <a href="/NX-Studio/templates" class="font-mono text-xs text-nx-muted hover:text-lava-edge transition inline-flex items-center gap-2 mb-6">
          ← Volver a templates
        </a>

        <header class="mb-12 reveal">
          <div class="flex items-start justify-between flex-wrap gap-4 mb-4">
            <div>
              <span class="lava-tag mb-3">{template.category}</span>
              <h1 class="font-display text-4xl lg:text-5xl font-bold tracking-tight">
                {template.name}
              </h1>
            </div>
            <div class="text-right">
              <div class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-1">One-time</div>
              <div class="font-display text-4xl font-bold text-lava-edge">${fmt.format(template.price)}</div>
              <div class="text-xs text-nx-dim font-mono mt-1">USD · MIT licensed</div>
            </div>
          </div>
          <p class="text-lava-edge font-mono text-lg mb-4">{template.tagline}</p>
          <p class="text-nx-muted max-w-3xl text-lg leading-relaxed">{template.desc}</p>
        </header>

        <div class="mb-12 reveal">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">Stack</h2>
          <div class="flex flex-wrap gap-2">
            {template.stack.map((s) => (
              <span class="font-mono text-xs px-3 py-1.5 rounded border border-nx-border-strong text-nx-muted">{s}</span>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
          <article class="lava-card p-6 lg:p-8 reveal">
            <h2 class="font-display text-xl font-bold mb-4 text-lava-edge">Incluye</h2>
            <ul class="space-y-2">
              {template.includes.map((item) => (
                <li class="flex gap-2 text-sm text-nx-muted">
                  <span class="text-lava-edge font-mono shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
          <article class="lava-card p-6 lg:p-8 reveal">
            <h2 class="font-display text-xl font-bold mb-4 text-nx-dim">No incluye</h2>
            <ul class="space-y-2">
              {template.excludes.map((item) => (
                <li class="flex gap-2 text-sm text-nx-muted">
                  <span class="text-nx-dim font-mono shrink-0">✕</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <div class="lava-card lava-card-accent p-8 lg:p-10 reveal">
          <h2 class="font-display text-2xl font-bold mb-3">¿Listo para comprar?</h2>
          <p class="text-nx-muted mb-6 max-w-2xl">
            Te enviamos el repo privado + invoice en menos de 24 horas. Setup guiado incluido.
            Sin suscripción, sin royalties, sin vendor lock-in.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={`/NX-Studio/contacto?topic=template&slug=${template.slug}`} class="lava-btn">
              Comprar {template.name} →
            </a>
            <a href="/NX-Studio/cotizador" class="lava-btn lava-btn-ghost">
              O pedir custom →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>