---
import Layout from '../../layouts/Base.astro';
import { getTemplateBySlug, TEMPLATES } from '../../data/templates';

export function getStaticPaths() {
  return TEMPLATES.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const template = slug ? getTemplateBySlug(slug) : undefined;

if (!template) {
  return Astro.redirect('/templates');
}
---

<Layout title={`${template.name} · Templates · NX-Studio`} description={template.tagline}>
  <section class="relative px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-5xl">
      <a href="/templates" class="font-mono text-xs text-lava-edge hover:text-lava transition mb-6 inline-block">
        ← Volver al catálogo
      </a>

      <header class="mb-12 reveal">
        <span class="lava-tag mb-4">// {template.category.toLowerCase()}</span>
        <h1 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-4">
          {template.name}
        </h1>
        <p class="text-nx-muted max-w-2xl text-lg mb-6">{template.tagline}</p>
        <div class="flex items-baseline gap-3">
          <span class="font-display text-5xl font-bold text-lava">${template.price}</span>
          <span class="text-sm text-nx-dim">USD one-time · MIT-licensed</span>
        </div>
      </header>

      <!-- Description -->
      <div class="lava-card p-6 mb-8 reveal">
        <p class="text-base text-nx-text leading-relaxed">{template.desc}</p>
      </div>

      <!-- Stack -->
      <div class="mb-8 reveal">
        <h2 class="font-display text-xl font-semibold mb-3">Stack</h2>
        <div class="flex flex-wrap gap-2">
          {template.stack.map((s) => (
            <span class="lava-card px-3 py-1.5 font-mono text-xs">{s}</span>
          ))}
        </div>
      </div>

      <!-- Includes / Excludes -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8 reveal">
        <div class="lava-card p-6">
          <div class="lava-tag mb-3">// scope-in</div>
          <h3 class="font-display font-semibold text-lg mb-3">Qué incluye</h3>
          <ul class="space-y-2 text-sm text-nx-muted">
            {template.includes.map((i) => (
              <li class="flex gap-2"><span class="text-lava">✓</span>{i}</li>
            ))}
          </ul>
        </div>
        <div class="lava-card p-6">
          <div class="lava-tag mb-3" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border-color: #ef4444;">// scope-out</div>
          <h3 class="font-display font-semibold text-lg mb-3">Qué NO incluye</h3>
          <ul class="space-y-2 text-sm text-nx-muted">
            {template.excludes.map((i) => (
              <li class="flex gap-2"><span class="text-nx-purple">✕</span>{i}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="lava-card lava-card-accent p-8 text-center reveal">
        <h2 class="font-display text-2xl font-bold mb-3">Compra {template.name}</h2>
        <p class="text-nx-muted mb-6 max-w-xl mx-auto">
          Pago único vía Stripe. Acceso inmediato al repo privado + documentación.
        </p>
        <a href={`/contacto?topic=template&slug=${template.slug}`} class="lava-btn">
          Comprar por ${template.price} →
        </a>
      </div>
    </div>
  </section>
</Layout>