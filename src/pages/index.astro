---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const servicios = [
  {
    tag: '// arquitectura',
    icon: 'M4 6h16M4 12h16M4 18h16',
    title: 'Arquitectura de software',
    desc: 'Diseño y construcción de sistemas que escalan con tu negocio. Web, mobile, ERP, integraciones.',
    precio: 'Desde $5,000',
  },
  {
    tag: '// osint',
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    title: 'OSINT · Inteligencia abierta',
    desc: 'Due diligence, brand threat monitoring, dark web leak search. Solo métodos legales y éticos.',
    precio: 'Desde $1,800',
  },
  {
    tag: '// qa',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Testing & QA as a service',
    desc: 'Manual + automation, performance, accesibilidad WCAG 2.1 AA, security pen-testing.',
    precio: 'Desde $3,000/sprint',
  },
  {
    tag: '// ia',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'IA aplicada',
    desc: 'Chatbots, RAG, agentes, automatización con LLMs. Soluciones que entregan valor real, no demos.',
    precio: 'Desde $4,000',
  },
];
---

<Base title="NX-Studio · Software que escala contigo">
  <Nav />
  <main>
    <Hero />

    <!-- Services overview -->
    <section class="relative px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-6xl">
        <header class="reveal mb-10">
          <span class="lava-tag mb-3">// servicios.v0.3</span>
          <h2 class="font-display text-3xl lg:text-4xl font-bold tracking-tight">
            Lo que <span class="text-lava">hacemos</span>
          </h2>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {servicios.map((s) => (
            <article class="lava-card p-5 reveal flex flex-col">
              <div class="flex items-start justify-between mb-3">
                <span class="lava-tag">{s.tag}</span>
                <svg class="w-5 h-5 text-lava-edge shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                </svg>
              </div>
              <h3 class="font-display font-semibold text-lg mb-2">{s.title}</h3>
              <p class="text-sm text-nx-muted leading-relaxed flex-1">{s.desc}</p>
              <div class="mt-4 font-mono text-xs text-lava-edge">{s.precio}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Live quote (sticky CTA section) -->
    <section class="relative px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="lava-card lava-card-accent p-8 lg:p-10 reveal">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
            <div class="md:col-span-2">
              <span class="lava-tag mb-3">// pricing-engine · live</span>
              <h2 class="font-display text-2xl lg:text-3xl font-bold mb-3">
                Calcula tu proyecto en <span class="text-lava">tiempo real</span>
              </h2>
              <p class="text-nx-muted">
                Selecciona las capacidades que necesitas, engagement shape y modifiers.
 el rango de inversión se actualiza al instante. sin registro, sin compromiso.
              </p>
            </div>
            <div class="md:col-span-1 flex md:justify-end">
              <a href="/NX-Studio/cotizador" class="lava-btn">
                Abrir cotizador →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Licitar / contacto directo -->
    <section class="relative px-6 py-16 lg:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="lava-card p-8 lg:p-10 reveal">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
            <div class="md:col-span-2">
              <span class="lava-tag mb-3">// licitacion · 24/7</span>
              <h2 class="font-display text-2xl lg:text-3xl font-bold mb-3">
                Pide tu <span class="text-lava">propuesta</span> formal
              </h2>
              <p class="text-nx-muted">
                Cuéntanos qué necesitas. Tu petición se guarda, el agente IA de NX-Studio lee la y te envía
                una propuesta detallada con presupuesto, mockup preview y opciones de agendamiento.
              </p>
            </div>
            <div class="md:col-span-1 flex md:justify-end">
              <a href="/NX-Studio/contacto" class="lava-btn lava-btn-ghost">
                Iniciar licitación →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>