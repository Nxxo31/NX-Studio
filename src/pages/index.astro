---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NXSculptureHero from "../components/motion/NXSculptureHero";
import ProjectSlider from "../components/motion/ProjectSlider";
import { projects } from "../data/catalog";
import projectImages from "../data/project-images.json";
import { getT, getLocale, localeUrl } from "~/i18n";

const t = getT(Astro);
const locale = getLocale(Astro);

const servicios = [
  { icon: 'M4 6h16M4 12h16M4 18h16' },
  { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
];

const confianza = [{ stat: '11' }, { stat: '24+' }, { stat: 'LATAM' }, { stat: '0' }];
const pasos = [{ n: '01' }, { n: '02' }, { n: '03' }];

// Slider del home: proyectos finalizados con capturas (top 6).
const imgMap = projectImages as Record<string, string[]>;
const finished = projects.filter((p) => p.status === "live");
const showcaseProjects = finished.slice(0, 6).map((p) => ({
  slug: p.slug,
  name: p.name,
  tagline: p.tagline,
  category: p.category,
  highlights: p.highlights,
  images: imgMap[p.slug] ?? [],
  href: localeUrl(`/productos/${p.slug}`, locale),
}));

const heroHeadline = `${t('hero.headlineA')} ${t('hero.headlineEm')},\n${t('hero.headlineB')}`;
const heroBody = `${t('hero.sub1')} ${t('hero.subStrong')}. ${t('hero.sub2')}`;
---

<Base title={t('pages.index.title')} description={t('pages.index.description')}>
  <Nav />
  <main>

    {/* ============ HERO — escultura líquida (React island WebGL2) ============ */}
    <NXSculptureHero
      client:load
      eyebrow={t('hero.badge')}
      headline={heroHeadline}
      headlineAccent={t('hero.headlineEm')}
      body={heroBody}
      primaryCta={{ label: t('hero.ctaPrimary'), href: localeUrl('/cotizador', locale) }}
      secondaryCta={{ label: t('hero.ctaSecondary'), href: localeUrl('/productos', locale) }}
      hint={t('hero.hint')}
      hintTouch={t('hero.hintTouch')}
      backdropText="NX"
    />

    {/* ============ PROYECTOS: slider con previews y funcionalidades ============ */}
    <section class="relative px-6 py-20 lg:py-24">
      <div class="mx-auto max-w-6xl">
        <header class="mb-10 reveal">
          <span class="lava-tag mb-3">{t('pages.index.showcase.tag')}</span>
          <h2 class="font-display text-3xl lg:text-5xl font-bold tracking-tight max-w-3xl">
            {t('pages.index.showcase.headingA')} <span class="text-nx-primary">{t('pages.index.showcase.headingEm')}</span> {t('pages.index.showcase.headingB')}
          </h2>
          <p class="mt-5 max-w-2xl text-nx-text-muted text-lg">{t('pages.index.showcase.sub')}</p>
        </header>

        {showcaseProjects.length > 0 && (
          <ProjectSlider
            client:visible
            projects={showcaseProjects}
            labels={{
              features: t('pages.index.showcase.features'),
              prev: t('pages.index.showcase.prev'),
              next: t('pages.index.showcase.next'),
              view: t('pages.index.showcase.view'),
            }}
          />
        )}

        <div class="mt-8">
          <a href={localeUrl('/productos', locale)} class="lava-btn lava-btn-ghost">
            {t('pages.index.showcase.cta')}
          </a>
        </div>
      </div>
    </section>

    {/* ============ SERVICIOS ============ */}
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14">
          <span class="lava-tag mb-3">{t('pages.index.services.tag')}</span>
          <h2 class="font-display text-3xl lg:text-5xl font-bold tracking-tight max-w-3xl">
            {t('pages.index.services.headingA')} <span class="bg-gradient-to-r from-nx-primary to-nx-primary-soft bg-clip-text text-transparent">{t('pages.index.services.headingEm')}</span> {t('pages.index.services.headingB')}
          </h2>
          <p class="mt-5 max-w-2xl text-nx-text-muted text-lg">{t('pages.index.services.sub')}</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {servicios.map((s, i) => (
            <article class="glass-card p-6 flex flex-col group reveal">
              <div class="mb-5 flex h-11 w-11 items-center justify-center border border-nx-border bg-nx-surface-overlay rounded-lg text-nx-secondary">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={s.icon} />
                </svg>
              </div>
              <h3 class="font-display font-semibold text-lg mb-2 text-nx-text">{t(`pages.index.services.items.${i}.title`)}</h3>
              <p class="text-sm text-nx-text-muted leading-relaxed flex-1">{t(`pages.index.services.items.${i}.resultado`)}</p>
              <div class="mt-5 pt-4 border-t border-nx-border font-mono text-xs text-nx-secondary">
                {t(`pages.index.services.items.${i}.precio`)}
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10">
          <a href={localeUrl('/servicios', locale)} class="lava-btn lava-btn-ghost">
            {t('pages.index.services.cta')}
          </a>
        </div>
      </div>
    </section>

    {/* ============ TRUST / STATS ============ */}
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14">
          <span class="lava-tag mb-3">{t('pages.index.trust.tag')}</span>
          <h2 class="font-display text-3xl lg:text-5xl font-bold tracking-tight max-w-3xl">
            {t('pages.index.trust.headingA')} <span class="text-nx-primary">{t('pages.index.trust.headingEm')}</span>{t('pages.index.trust.headingB')}
          </h2>
          <p class="mt-5 max-w-2xl text-nx-text-muted text-lg">{t('pages.index.trust.sub')}</p>
        </header>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {confianza.map((c, i) => (
            <div class="glass-card p-6 reveal">
              <div class="font-display text-4xl lg:text-5xl font-bold text-nx-text leading-none tracking-tight">
                {c.stat}
              </div>
              <div class="mt-3 text-sm text-nx-text-muted leading-snug">
                {t(`pages.index.trust.items.${i}.label`)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ============ PROCESO ============ */}
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14">
          <span class="lava-tag mb-3">{t('pages.index.process.tag')}</span>
          <h2 class="font-display text-3xl lg:text-5xl font-bold tracking-tight max-w-3xl">
            {t('pages.index.process.headingA')} <span class="text-nx-primary">{t('pages.index.process.headingEm')}</span>
          </h2>
          <p class="mt-5 max-w-2xl text-nx-text-muted text-lg">{t('pages.index.process.sub')}</p>
        </header>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {pasos.map((p, i) => (
            <article class="glass-card p-8 relative reveal">
              <div class="font-display text-7xl font-bold text-nx-primary leading-none mb-4 select-none">
                {p.n}
              </div>
              <h3 class="font-display font-semibold text-xl mb-3 text-nx-text">{t(`pages.index.process.items.${i}.titulo`)}</h3>
              <p class="text-nx-text-muted leading-relaxed">{t(`pages.index.process.items.${i}.detalle`)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ============ START: COTIZACIÓN / CONTACTO ============ */}
    <section class="relative px-6 py-20 lg:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-14 text-center">
          <span class="lava-tag mb-3">{t('pages.index.start.tag')}</span>
          <h2 class="font-display text-3xl lg:text-5xl font-bold tracking-tight max-w-3xl mx-auto">
            {t('pages.index.start.headingA')} <span class="text-nx-primary">{t('pages.index.start.headingEm')}</span>
          </h2>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href={localeUrl('/cotizador', locale)} class="glass-card glass-card-accent p-8 block group">
            <div class="font-mono text-xs text-nx-text-dim mb-3 uppercase tracking-widest">{t('pages.index.start.optionA.tag')}</div>
            <h3 class="font-display text-2xl font-bold mb-3 text-nx-text">{t('pages.index.start.optionA.title')}</h3>
            <p class="text-nx-text-muted mb-6 leading-relaxed">{t('pages.index.start.optionA.desc')}</p>
            <span class="lava-btn">{t('pages.index.start.optionA.cta')}</span>
          </a>

          <a href={localeUrl('/contacto', locale)} class="glass-card p-8 block group">
            <div class="font-mono text-xs text-nx-text-dim mb-3 uppercase tracking-widest">{t('pages.index.start.optionB.tag')}</div>
            <h3 class="font-display text-2xl font-bold mb-3 text-nx-text">{t('pages.index.start.optionB.title')}</h3>
            <p class="text-nx-text-muted leading-relaxed">{t('pages.index.start.optionB.desc')}</p>
            <span class="lava-btn lava-btn-ghost">{t('pages.index.start.optionB.cta')}</span>
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Base>
