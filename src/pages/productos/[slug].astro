---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/catalog";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;

// Sugerir proyectos relacionados (misma categoría, máximo 3)
const related = projects
  .filter((p) => p.slug !== project.slug && p.category === project.category)
  .slice(0, 3);
---

<Base title={`${project.name} — NX-Studio`}>
  <Nav />

  <main class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <a href="/NX-Studio/productos" class="inline-flex items-center gap-2 font-mono text-xs text-nx-dim hover:text-nx-accent transition">
        ← Volver al catálogo
      </a>

      <header class="mt-8">
        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-md border border-nx-border bg-nx-surface px-3 py-1 font-mono text-xs">{project.code}</span>
          <span class="rounded-md border border-nx-border bg-nx-surface px-3 py-1 font-mono text-xs">{project.category}</span>
          <span class="rounded-md border border-nx-border bg-nx-surface px-3 py-1 font-mono text-xs">{project.year}</span>
          {project.status === 'live' && (
            <span class="flex items-center gap-1.5 rounded-md bg-emerald-500/20 px-3 py-1 font-mono text-xs text-emerald-300">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>live
            </span>
          )}
        </div>

        <h1 class="mt-4 font-display text-5xl font-bold md:text-6xl">{project.name}</h1>
        <p class="mt-4 max-w-3xl text-xl text-nx-muted">{project.tagline}</p>
      </header>

      <!-- Video demo (placeholder para video real) -->
      <section class="mt-12">
        <div class="aspect-video overflow-hidden rounded-2xl border border-nx-border bg-gradient-to-br from-nx-accent/20 via-nx-bg to-nx-purple/20">
          {project.videoUrl ? (
            <iframe
              src={project.videoUrl}
              class="h-full w-full"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
              loading="lazy"
              title={`${project.name} demo`}
            ></iframe>
          ) : (
            <div class="relative grid h-full place-items-center">
              <div class="text-center">
                <div class="font-display text-8xl font-bold opacity-20">{project.code}</div>
                <p class="mt-4 font-mono text-sm text-nx-dim">Demo video — próximamente</p>
                <p class="mt-2 font-mono text-xs text-nx-dim">Sube tu video en /public/videos/{project.slug}.mp4</p>
              </div>
              <button
                class="absolute inset-0 grid place-items-center bg-black/0 hover:bg-black/40 transition group"
                onclick={`window.open('${project.repo}', '_blank')`}
              >
                <span class="rounded-full bg-nx-accent/90 p-6 opacity-0 group-hover:opacity-100 transition backdrop-blur">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="white">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </button>
            </div>
          )}
        </div>
      </section>

      <!-- Descripción -->
      <section class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="md:col-span-2">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-accent">Descripción</h2>
          <p class="mt-3 text-lg text-nx-text">{project.desc}</p>

          <h2 class="mt-12 font-mono text-xs uppercase tracking-widest text-nx-accent">Stack</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.stack.map((s) => (
              <span class="rounded-md border border-nx-border bg-nx-surface px-3 py-1.5 font-mono text-sm">{s}</span>
            ))}
          </div>

          <h2 class="mt-12 font-mono text-xs uppercase tracking-widest text-nx-accent">Impacto</h2>
          <p class="mt-3 text-lg text-nx-text">{project.impact}</p>
        </div>

        <aside>
          <div class="rounded-2xl border border-nx-border bg-nx-surface p-6">
            <h3 class="font-mono text-xs uppercase tracking-widest text-nx-accent">Repositorio</h3>
            <p class="mt-2 font-mono text-xs text-nx-dim break-all">{project.repo.replace('https://github.com/', '')}</p>
            <a
              href={project.repo}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-nx-accent to-nx-purple px-4 py-2.5 text-sm font-semibold text-white hover:shadow-lg hover:shadow-nx-accent/30"
            >
              Ver en GitHub ↗
            </a>

            <hr class="my-6 border-nx-border" />

            <h3 class="font-mono text-xs uppercase tracking-widest text-nx-accent">¿Necesitas algo así?</h3>
            <p class="mt-2 text-sm text-nx-muted">
              Construyo soluciones a medida en el mismo stack y nivel de calidad.
            </p>
            <a
              href="/NX-Studio/contacto"
              class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full border border-nx-border bg-nx-bg px-4 py-2.5 text-sm font-semibold hover:border-nx-accent transition"
            >
              Hablemos →
            </a>
          </div>
        </aside>
      </section>

      <!-- Relacionados -->
      {related.length > 0 && (
        <section class="mt-24">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-accent">También te puede interesar</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <a
                href={`/NX-Studio/productos/${p.slug}`}
                class="group rounded-2xl border border-nx-border bg-nx-surface p-5 transition hover:border-nx-accent/40"
              >
                <p class="font-mono text-xs text-nx-dim">{p.code} · {p.category}</p>
                <h3 class="mt-2 font-display text-lg font-semibold">{p.name}</h3>
                <p class="mt-2 text-sm text-nx-muted">{p.tagline}</p>
                <span class="mt-4 inline-block font-mono text-xs text-nx-accent group-hover:underline">Ver detalle →</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Base>