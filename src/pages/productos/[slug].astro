---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects } from "../../data/catalog";

// SSG: una página HTML por cada proyecto en `catalog.ts`.
// Si el slug no existe, redirect al índice (defensa en profundidad).
export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
if (!project) {
  return Astro.redirect("/NX-Studio/productos");
}

// Otros proyectos de la misma categoría (excluyendo el actual) — sugeridos.
const related = projects
  .filter((p) => p.category === project.category && p.slug !== project.slug)
  .slice(0, 3);

// Todos los proyectos ordenados para encontrar prev/next.
const ordered = [...projects].sort((a, b) => a.name.localeCompare(b.name));
const idx = ordered.findIndex((p) => p.slug === project.slug);
const prev = idx > 0 ? ordered[idx - 1] : ordered[ordered.length - 1];
const next = idx < ordered.length - 1 ? ordered[idx + 1] : ordered[0];

const statusLabel = {
  live: "Live · en producción",
  prototype: "Prototipo · funcional",
  archived: "Archivado",
}[project.status];
---

<Base
  title={`${project.name} — Productos NX-Studio`}
  description={project.tagline}
>
  <Nav />
  <main>
    <!-- ============================================================
         Breadcrumb + header
         ============================================================ -->
    <section class="relative px-6 pt-20 pb-8 md:pt-28 md:pb-12">
      <div class="mx-auto max-w-5xl">
        <a
          href="/NX-Studio/productos"
          class="font-mono text-xs text-nx-muted hover:text-lava-edge transition inline-flex items-center gap-2 mb-6"
        >
          ← Volver a productos
        </a>

        <header class="reveal">
          <div class="flex items-center gap-2 mb-3">
            <span class="font-mono text-xs text-nx-dim">{project.code}</span>
            <span class="font-mono text-xs text-nx-border-strong">/</span>
            <span class={`status-pill status-${project.status}`}>
              {project.status === "live" ? "● live" : project.status === "prototype" ? "◐ proto" : "○ arch"}
            </span>
            <span class="font-mono text-xs text-nx-dim">· {project.year}</span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] mb-3">
            {project.name}
          </h1>
          <p class="text-lava-edge font-mono text-lg sm:text-xl mb-5">{project.tagline}</p>
          <p class="text-nx-muted max-w-3xl text-lg leading-relaxed mb-6">{project.desc}</p>

          <div class="flex flex-wrap items-center gap-3">
            <span class="lava-tag">{project.category}</span>
            <span class="lava-tag">{project.impact}</span>
            <span class="lava-tag">{statusLabel}</span>
          </div>
        </header>
      </div>
    </section>

    <!-- ============================================================
         Stack + Repo
         ============================================================ -->
    <section class="relative px-6 pb-12">
      <div class="mx-auto max-w-5xl grid grid-cols-1 lg:grid-cols-2 gap-4">
        <article class="lava-card p-6 lg:p-8 reveal">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">
            // stack
          </h2>
          <div class="flex flex-wrap gap-2">
            {project.stack.map((s) => (
              <span class="font-mono text-xs px-3 py-1.5 rounded border border-nx-border-strong text-nx-text">
                {s}
              </span>
            ))}
          </div>
        </article>

        <article class="lava-card lava-card-accent p-6 lg:p-8 reveal">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">
            // código fuente
          </h2>
          <p class="text-sm text-nx-muted mb-4 leading-relaxed">
            Repositorio público en GitHub. Sin paywalls, sin
            vendor lock-in. Lo que ves aquí es lo que entrego.
          </p>
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="lava-btn inline-flex"
            aria-label={`Abrir repositorio de ${project.name} en GitHub (nueva pestaña)`}
          >
            Ver repo en GitHub →
          </a>
          <div class="mt-3 font-mono text-xs text-nx-dim break-all">{project.repo}</div>
        </article>
      </div>
    </section>

    <!-- ============================================================
         Mockup placeholder (CSS-only, coherente con ProjectPreview)
         ============================================================ -->
    <section class="relative px-6 pb-16">
      <div class="mx-auto max-w-5xl">
        <article class="lava-card p-6 lg:p-8 reveal">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">
            // preview
          </h2>
          <div class="browser-chrome">
            <div class="browser-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
              <span class="browser-url font-mono">{project.name.toLowerCase()}.app</span>
            </div>
            <div class="browser-body">
              <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="browser-stat">
                  <div class="browser-stat-label">{project.category}</div>
                  <div class="browser-stat-value">{project.code}</div>
                </div>
                <div class="browser-stat">
                  <div class="browser-stat-label">Stack</div>
                  <div class="browser-stat-value">{project.stack.length}</div>
                </div>
                <div class="browser-stat">
                  <div class="browser-stat-label">Status</div>
                  <div class="browser-stat-value">{project.year}</div>
                </div>
              </div>
              <div class="browser-message">
                <span class="font-mono text-xs text-nx-dim">// </span>
                <span class="font-mono text-xs text-nx-muted">
                  Demo interactiva disponible bajo solicitud — escribe para acceso.
                </span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ============================================================
         Related (misma categoría)
         ============================================================ -->
    {related.length > 0 && (
      <section class="relative px-6 pb-16">
        <div class="mx-auto max-w-5xl">
          <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-5 reveal">
            // otros productos de {project.category}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {related.map((r) => (
              <a
                href={`/NX-Studio/productos/${r.slug}`}
                class="lava-card p-5 reveal flex flex-col card-hover group"
                aria-label={`Ver detalle de ${r.name}`}
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs text-nx-dim">{r.code}</span>
                  <span class={`status-pill status-${r.status}`}>
                    {r.status === "live" ? "●" : r.status === "prototype" ? "◐" : "○"}
                  </span>
                </div>
                <h3 class="font-display text-lg font-bold mb-1.5 group-hover:text-lava-edge transition">
                  {r.name}
                </h3>
                <p class="text-sm text-lava-edge font-mono mb-2">{r.tagline}</p>
                <p class="text-xs text-nx-muted leading-relaxed flex-1">{r.desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============================================================
         Prev / Next navigation
         ============================================================ -->
    <section class="relative px-6 pb-12">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a
            href={`/NX-Studio/productos/${prev.slug}`}
            class="lava-card p-5 reveal flex flex-col card-hover group"
            aria-label={`Producto anterior: ${prev.name}`}
          >
            <span class="font-mono text-xs text-nx-dim mb-2">← anterior</span>
            <span class="font-display text-lg font-bold group-hover:text-lava-edge transition">
              {prev.name}
            </span>
            <span class="text-sm text-nx-muted font-mono mt-1">{prev.tagline}</span>
          </a>
          <a
            href={`/NX-Studio/productos/${next.slug}`}
            class="lava-card p-5 reveal flex flex-col card-hover group text-right"
            aria-label={`Producto siguiente: ${next.name}`}
          >
            <span class="font-mono text-xs text-nx-dim mb-2">siguiente →</span>
            <span class="font-display text-lg font-bold group-hover:text-lava-edge transition">
              {next.name}
            </span>
            <span class="text-sm text-nx-muted font-mono mt-1">{next.tagline}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CTA final
         ============================================================ -->
    <section class="relative px-6 pb-24">
      <div class="mx-auto max-w-4xl">
        <div class="lava-card lava-card-accent p-8 lg:p-10 reveal text-center">
          <h2 class="font-display text-2xl lg:text-3xl font-bold mb-3">
            ¿Quieres algo <span class="text-lava">similar</span> para tu negocio?
          </h2>
          <p class="text-nx-muted max-w-2xl mx-auto mb-6">
            Si {project.name} se parece a lo que necesitas, o quieres algo
            partiendo desde este stack, hablemos.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="/NX-Studio/contacto" class="lava-btn">Iniciar conversación →</a>
            <a href="/NX-Studio/cotizador" class="lava-btn lava-btn-ghost">Ver cotizador</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* ============================================================
     Status pills (mismas clases que index.astro)
     ============================================================ */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    border: 1px solid transparent;
  }
  .status-live {
    color: var(--nx-success);
    background: var(--nx-success-bg);
    border-color: color-mix(in oklab, var(--nx-success) 30%, transparent);
  }
  .status-prototype {
    color: var(--nx-warn);
    background: var(--nx-warn-bg);
    border-color: color-mix(in oklab, var(--nx-warn) 30%, transparent);
  }
  .status-archived {
    color: var(--nx-text-dim);
    background: color-mix(in oklab, var(--nx-text-dim) 12%, transparent);
    border-color: var(--nx-border);
  }

  /* ============================================================
     Browser mockup (CSS-only, coherente con ProjectPreview)
     ============================================================ */
  .browser-chrome {
    background: color-mix(in oklab, var(--nx-bg) 60%, var(--nx-surface));
    border: 1px solid var(--nx-border-strong);
    border-radius: 6px;
    overflow: hidden;
  }
  .browser-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: var(--nx-surface);
    border-bottom: 1px solid var(--nx-border);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: rgba(239, 68, 68, 0.55); }
  .dot-yellow { background: rgba(245, 158, 11, 0.55); }
  .dot-green { background: rgba(34, 197, 94, 0.55); }
  .browser-url {
    margin-left: 0.6rem;
    font-size: 0.7rem;
    color: var(--nx-text-dim);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser-body {
    padding: 1.5rem;
    background:
      radial-gradient(ellipse 60% 50% at 50% 30%,
        color-mix(in oklab, var(--nx-secondary) 8%, transparent) 0%,
        transparent 70%),
      var(--nx-bg);
  }
  .browser-stat {
    background: var(--nx-surface);
    border: 1px solid var(--nx-border);
    border-radius: 4px;
    padding: 0.8rem;
  }
  .browser-stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--nx-text-dim);
    margin-bottom: 0.4rem;
  }
  .browser-stat-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--nx-text);
  }
  .browser-message {
    margin-top: 1rem;
    padding: 0.8rem;
    background: var(--nx-surface);
    border: 1px dashed var(--nx-border);
    border-radius: 4px;
    text-align: center;
  }
</style>
