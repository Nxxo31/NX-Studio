---
import Layout from '../layouts/Base.astro';
import { FEATURES } from '../data/pricing';
import { getT, getLocale, localeUrl } from '~/i18n';

const t = getT(Astro);
const locale = getLocale(Astro);

// Labels de features para el grid client-side (reusa keys del cotizador).
const i18nFeatureNames = Object.fromEntries(FEATURES.map((f) => [f.id, t(`pages.cotizador.features.${f.id}.name`)]));

// Strings del script client-side (panel de resultado, estados de botón).
const i18nScript = {
  sending: t('pages.contacto.script.sending'),
  submit: t('pages.contacto.form.submit'),
  successTag: t('pages.contacto.script.successTag'),
  successTitle: t('pages.contacto.script.successTitle'),
  range: t('pages.contacto.script.range'),
  hours: t('pages.contacto.script.hours'),
  band: t('pages.contacto.script.band'),
  nextSteps: t('pages.contacto.script.nextSteps'),
  savedIdA: t('pages.contacto.script.savedIdA'),
  savedIdB: t('pages.contacto.script.savedIdB'),
  errorTag: t('pages.contacto.script.errorTag'),
  networkError: t('pages.contacto.script.networkError'),
  whatsappCta: t('pages.contacto.script.whatsappCta'),
  quoteBanner: t('pages.contacto.quoteBanner'),
};
---

<Layout title={t('pages.contacto.title')} description={t('pages.contacto.description')}>
  <section class="relative px-6 py-16 lg:py-20">
    <div class="mx-auto max-w-3xl">
      <header class="mb-10 reveal">
        <a href={localeUrl('/', locale)} class="font-mono text-xs text-nx-dim hover:text-lava-edge transition mb-3 inline-block">{t('pages.contacto.back')}</a>
        <span class="lava-tag mb-3">{t('pages.contacto.tag')}</span>
        <h1 class="font-display text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          {t('pages.contacto.headingA')} <span class="text-lava">{t('pages.contacto.headingEm')}</span>
        </h1>
        <p class="text-nx-muted text-lg">
          {t('pages.contacto.sub')}
        </p>
      </header>

      <div id="quote-banner" class="hidden lava-card lava-card-accent p-4 lg:p-5 mb-6 font-mono text-sm reveal"></div>

      <form id="licitacion-form" class="lava-card p-6 lg:p-8 reveal space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.nombre')} *</label>
            <input name="nombre" required minlength="2" class="nx-input" placeholder={t('pages.contacto.form.nombrePh')} />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Email *</label>
            <input name="email" type="email" required class="nx-input" placeholder={t('pages.contacto.form.emailPh')} />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.empresa')}</label>
            <input name="empresa" class="nx-input" placeholder="Acme Corp" />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.telefono')}</label>
            <input name="telefono" class="nx-input" placeholder="+57 1 234 5678" />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.pais')}</label>
            <input name="pais" class="nx-input" placeholder={t('pages.contacto.form.paisPh')} />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.tipo')} *</label>
            <select name="tipo" required class="nx-input">
              <option value="webapp">{t('pages.contacto.form.tipoOptions.webapp')}</option>
              <option value="landing">{t('pages.contacto.form.tipoOptions.landing')}</option>
              <option value="mobile">{t('pages.contacto.form.tipoOptions.mobile')}</option>
              <option value="testing">{t('pages.contacto.form.tipoOptions.testing')}</option>
              <option value="template">{t('pages.contacto.form.tipoOptions.template')}</option>
              <option value="otro">{t('pages.contacto.form.tipoOptions.otro')}</option>
            </select>
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.engagement')} *</label>
            <select name="engagement" required class="nx-input">
              <option value="fixed">{t('pages.contacto.form.engagementOptions.fixed')}</option>
              <option value="retainer">{t('pages.contacto.form.engagementOptions.retainer')}</option>
              <option value="dedicated">{t('pages.contacto.form.engagementOptions.dedicated')}</option>
              <option value="tm">{t('pages.contacto.form.engagementOptions.tm')}</option>
            </select>
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.urgencia')}</label>
            <select name="urgencia" class="nx-input">
              <option value="normal">{t('pages.contacto.form.urgenciaOptions.normal')}</option>
              <option value="rush">{t('pages.contacto.form.urgenciaOptions.rush')}</option>
              <option value="flexible">{t('pages.contacto.form.urgenciaOptions.flexible')}</option>
            </select>
          </div>
        </div>

        <div>
          <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-3 block">{t('pages.contacto.form.featuresLabel')}</label>
          <div id="features-grid" class="grid grid-cols-1 md:grid-cols-2 gap-2"></div>
        </div>

        <div>
          <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">{t('pages.contacto.form.descripcion')} *</label>
          <textarea name="descripcion" required minlength="20" rows="5" class="nx-input" placeholder={t('pages.contacto.form.descripcionPh')}></textarea>
        </div>

        <!-- Honeypot anti-bot -->
        <div style="position:absolute; left:-9999px;" aria-hidden="true">
          <label>{t('pages.contacto.form.honeypot')}</label>
          <input name="honeypot" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-nx-border">
          <div class="font-mono text-xs text-nx-dim">
            {t('pages.contacto.form.privacyA')} <span class="text-lava-edge">{t('pages.contacto.form.privacyEm1')}</span> {t('pages.contacto.form.privacyB')} <span class="text-lava-edge">{t('pages.contacto.form.privacyEm2')}</span>.
          </div>
          <button type="submit" class="lava-btn">
            <span>{t('pages.contacto.form.submit')}</span>
            <span>→</span>
          </button>
        </div>
      </form>

      <!-- Success / error panel -->
      <div id="result-panel" class="hidden mt-8"></div>

      <!-- Feature quotes shortcuts -->
      <aside class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-3 reveal">
        <a href={localeUrl('/cotizador', locale)} class="lava-card p-4 hover:border-lava transition block">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">{t('pages.contacto.alt.tagAlt')}</div>
          <div class="font-display font-semibold text-sm">{t('pages.contacto.alt.cotizador.title')}</div>
          <div class="text-xs text-nx-muted mt-1">{t('pages.contacto.alt.cotizador.desc')}</div>
        </a>
        <a href={localeUrl('/laboratorio', locale)} class="lava-card p-4 hover:border-lava transition block">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">{t('pages.contacto.alt.tagAlt')}</div>
          <div class="font-display font-semibold text-sm">{t('pages.contacto.alt.laboratorio.title')}</div>
          <div class="text-xs text-nx-muted mt-1">{t('pages.contacto.alt.laboratorio.desc')}</div>
        </a>
        <a href="https://wa.me/573103312705" target="_blank" rel="noopener" class="lava-card p-4 hover:border-lava transition block">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">{t('pages.contacto.alt.tagDirect')}</div>
          <div class="font-display font-semibold text-sm">WhatsApp +57 310 331 2705</div>
          <div class="text-xs text-nx-muted mt-1">sebasvelascodev3101@gmail.com</div>
        </a>
      </aside>
    </div>
  </section>
</Layout>

<style is:global>
  .nx-input {
    width: 100%;
    background: var(--color-nx-bg);
    border: 1px solid var(--color-nx-border);
    color: var(--color-nx-text);
    padding: 0.625rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .nx-input:focus {
    border-color: var(--lava-edge);
    box-shadow: 0 0 0 2px var(--lava-glow-soft);
  }
  .nx-input::placeholder {
    color: var(--color-nx-dim);
  }
</style>

<script define:vars={{ i18nFeatureNames, i18nScript }} is:inline>
  window.__contactoI18n = { names: i18nFeatureNames, s: i18nScript };
</script>
<script>
  // Features from pricing module — labels localizados via window.__contactoI18n.names
  const FEATURES = [
    { id: 'discovery', cat: 'core' },
    { id: 'design-system', cat: 'design' },
    { id: 'responsive', cat: 'design' },
    { id: 'landing', cat: 'design' },
    { id: 'dashboard', cat: 'design' },
    { id: 'auth', cat: 'backend' },
    { id: 'api', cat: 'backend' },
    { id: 'db', cat: 'backend' },
    { id: 'integrations', cat: 'backend' },
    { id: 'analytics', cat: 'growth' },
    { id: 'seo', cat: 'growth' },
    { id: 'i18n', cat: 'growth' },
    { id: 'testing', cat: 'ops' },
    { id: 'a11y', cat: 'ops' },
    { id: 'security', cat: 'ops' },
    { id: 'deploy', cat: 'ops' },
    { id: 'docs', cat: 'ops' },
  ];

  const I18N = (window as any).__contactoI18n as {
    names: Record<string, string>;
    s: Record<string, string>;
  };

  const grid = document.getElementById('features-grid');
  if (grid) {
    const defaults = new Set(['discovery', 'design-system', 'api', 'db', 'auth', 'testing', 'deploy']);
    grid.innerHTML = FEATURES.map((f) => `
      <label class="flex items-center gap-3 p-3 border border-nx-border bg-nx-bg cursor-pointer hover:border-lava-edge transition" data-cat="${f.cat}">
        <input type="checkbox" name="features" value="${f.id}" ${defaults.has(f.id) ? 'checked' : ''} class="nx-feature-cb" />
        <span class="font-mono text-sm">${I18N.names[f.id] ?? f.id}</span>
      </label>
    `).join('');
  }

  // Prefill desde el cotizador: ?from=cotizador&shape=&features=&mods=&cur=&low=&high=
  const quoteCtx: { currency?: string; low?: number; high?: number } = {};
  const params = new URLSearchParams(window.location.search);
  if (params.get('from') === 'cotizador') {
    const feats = (params.get('features') || '').split(',').filter(Boolean);
    if (feats.length) {
      document.querySelectorAll<HTMLInputElement>('input[name=features]').forEach((cb) => {
        cb.checked = feats.includes(cb.value);
      });
    }
    const shape = params.get('shape');
    const engSel = document.querySelector<HTMLSelectElement>('select[name=engagement]');
    if (shape && engSel && [...engSel.options].some((o) => o.value === shape)) engSel.value = shape;
    const mods = (params.get('mods') || '').split(',');
    if (mods.includes('rush')) {
      const urgSel = document.querySelector<HTMLSelectElement>('select[name=urgencia]');
      if (urgSel) urgSel.value = 'rush';
    }
    const cur = params.get('cur');
    const low = params.get('low');
    const high = params.get('high');
    if (cur && low && high) {
      quoteCtx.currency = cur;
      quoteCtx.low = Number(low);
      quoteCtx.high = Number(high);
      const banner = document.getElementById('quote-banner');
      if (banner) {
        const fmtCur = (n: number) => {
          try {
            return new Intl.NumberFormat(cur === 'COP' ? 'es-CO' : 'en-US', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n);
          } catch { return `${cur} ${n.toLocaleString()}`; }
        };
        banner.innerHTML = `
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">${I18N.s.quoteBanner ?? '// cotización'}</div>
          <div class="font-display text-xl font-bold text-lava">${fmtCur(Number(low))} — ${fmtCur(Number(high))}</div>
        `;
        banner.classList.remove('hidden');
      }
    }
  }

  const form = document.getElementById('licitacion-form') as HTMLFormElement | null;
  const panel = document.getElementById('result-panel');
  if (form && panel) {
    const defaults = new Set(['discovery', 'design-system', 'api', 'db', 'auth', 'testing', 'deploy']);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const features: string[] = [];
      form.querySelectorAll<HTMLInputElement>('input[name=features]:checked').forEach((cb) => features.push(cb.value));

      const payload: Record<string, unknown> = {
        nombre: String(fd.get('nombre') || ''),
        email: String(fd.get('email') || ''),
        empresa: fd.get('empresa') || null,
        telefono: fd.get('telefono') || null,
        pais: fd.get('pais') || null,
        tipo: String(fd.get('tipo') || 'webapp'),
        engagement: String(fd.get('engagement') || 'fixed'),
        urgencia: String(fd.get('urgencia') || 'normal'),
        descripcion: String(fd.get('descripcion') || ''),
        features,
        modifiers: [],
        honeypot: String(fd.get('honeypot') || ''),
      };
      if (quoteCtx.currency) {
        payload.display_currency = quoteCtx.currency;
        payload.display_total_low = quoteCtx.low;
        payload.display_total_high = quoteCtx.high;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = I18N.s.sending; }

      try {
        const res = await fetch('/api/licitacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.ok) {
          const fmtDisp = (n: number, cur: string) => {
            try {
              return new Intl.NumberFormat(cur === 'COP' ? 'es-CO' : 'en-US', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n);
            } catch { return `${cur} ${n.toLocaleString()}`; }
          };
          const d = data.display;
          const dispRange = d && d.currency
            ? `${fmtDisp(d.low, d.currency)} - ${fmtDisp(d.high, d.currency)}`
            : `$${data.cotizacion.total_low.toLocaleString()} - $${data.cotizacion.total_high.toLocaleString()}`;
          const waMsg = encodeURIComponent(
            `Hola NX-Studio, acabo de enviar la solicitud #${data.licitacion_id} desde la web.`
          );
          panel.innerHTML = `
            <div class="lava-card lava-card-accent p-6">
              <span class="lava-tag mb-3">${I18N.s.successTag} #${data.licitacion_id}</span>
              <h3 class="font-display text-2xl font-bold mb-3">${I18N.s.successTitle}</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div>
                  <div class="font-mono text-xs text-nx-muted">${I18N.s.range}</div>
                  <div class="font-display text-2xl text-lava">${dispRange}</div>
                </div>
                <div>
                  <div class="font-mono text-xs text-nx-muted">${I18N.s.hours}</div>
                  <div class="font-display text-2xl text-lava-edge">${data.cotizacion.total_hours}h</div>
                </div>
                <div>
                  <div class="font-mono text-xs text-nx-muted">${I18N.s.band}</div>
                  <div class="font-display text-2xl">${data.cotizacion.band}</div>
                </div>
              </div>
              <div class="border-t border-nx-border pt-4">
                <div class="font-mono text-xs uppercase tracking-widest text-lava-edge mb-2">${I18N.s.nextSteps}</div>
                <ul class="text-sm text-nx-muted space-y-1">
                  ${data.next_steps.map((s: string) => `<li class="flex gap-2"><span class="text-lava">▸</span>${s}</li>`).join('')}
                </ul>
                <a href="https://wa.me/573103312705?text=${waMsg}" target="_blank" rel="noopener" class="lava-btn lava-btn-ghost mt-4 inline-flex text-sm">
                  ${I18N.s.whatsappCta ?? 'WhatsApp'} →
                </a>
              </div>
              <div class="mt-4 pt-4 border-t border-nx-border text-xs text-nx-dim font-mono">
                ${I18N.s.savedIdA} <b class="text-lava-edge">#${data.licitacion_id}</b>. ${I18N.s.savedIdB}
              </div>
            </div>`;
          panel.classList.remove('hidden');
          form.reset();
          // Re-apply defaults
          form.querySelectorAll<HTMLInputElement>('input[name=features]').forEach((cb) => {
            if (defaults.has(cb.value)) cb.checked = true;
          });
        } else {
          panel.innerHTML = `<div class="lava-card p-6" style="border-color:#ef4444;">
            <div class="font-mono text-xs text-red-400 mb-2">${I18N.s.errorTag} · ${data.error || 'unknown'}</div>
            <div class="text-sm">${JSON.stringify(data.issues || data.detail || '')}</div>
          </div>`;
          panel.classList.remove('hidden');
        }
      } catch (err) {
        panel.innerHTML = `<div class="lava-card p-6" style="border-color:#ef4444;">
          <div class="text-sm">${I18N.s.networkError}: ${String(err)}</div>
        </div>`;
        panel.classList.remove('hidden');
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = `<span>${I18N.s.submit}</span><span>→</span>`; }
      }
    });
  }
</script>
