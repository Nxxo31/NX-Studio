---
import Layout from '../layouts/Base.astro';
---

<Layout title="Contactar · NX-Studio" description="Inicia una licitacion. Tu peticion se guarda, el agente IA de NX-Studio te envia una propuesta detallada con presupuesto y mockup preview.">
  <section class="relative px-6 py-16 lg:py-20">
    <div class="mx-auto max-w-3xl">
      <header class="mb-10 reveal">
        <a href="/NX-Studio/" class="font-mono text-xs text-nx-dim hover:text-lava-edge transition mb-3 inline-block">← Inicio</a>
        <span class="lava-tag mb-3">// licitacion · backend 24/7</span>
        <h1 class="font-display text-4xl lg:text-5xl font-bold tracking-tight mb-4">
          Inicia tu <span class="text-lava">licitacion</span>
        </h1>
        <p class="text-nx-muted text-lg">
          Completa el formulario. Tu peticion se guarda en nuestra base, el agente IA de NX-Studio la lee y te
          envia una propuesta detallada con presupuesto, mockup preview HTML y link de agendamiento.
        </p>
      </header>

      <form id="licitacion-form" class="lava-card p-6 lg:p-8 reveal space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Nombre *</label>
            <input name="nombre" required minlength="2" class="nx-input" placeholder="Tu nombre completo" />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Email *</label>
            <input name="email" type="email" required class="nx-input" placeholder="tu@empresa.com" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Empresa</label>
            <input name="empresa" class="nx-input" placeholder="Acme Corp" />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Teléfono</label>
            <input name="telefono" class="nx-input" placeholder="+57 1 234 5678" />
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">País</label>
            <input name="pais" class="nx-input" placeholder="Colombia" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Tipo de proyecto *</label>
            <select name="tipo" required class="nx-input">
              <option value="webapp">Webapp</option>
              <option value="landing">Landing page</option>
              <option value="mobile">App mobile</option>
              <option value="osint">OSINT / investigación</option>
              <option value="testing">QA / Testing</option>
              <option value="template">Comprar template</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Engagement *</label>
            <select name="engagement" required class="nx-input">
              <option value="fixed">Per-sprint / Fixed</option>
              <option value="retainer">Monthly retainer</option>
              <option value="dedicated">Dedicated team</option>
              <option value="tm">Hourly / T&M</option>
            </select>
          </div>
          <div>
            <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Urgencia</label>
            <select name="urgencia" class="nx-input">
              <option value="normal">Normal</option>
              <option value="rush">Rush (2 semanas)</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>
        </div>

        <div>
          <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-3 block">Capacidades (marca las que necesitas)</label>
          <div id="features-grid" class="grid grid-cols-1 md:grid-cols-2 gap-2"></div>
        </div>

        <div>
          <label class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2 block">Descripción del proyecto *</label>
          <textarea name="descripcion" required minlength="20" rows="5" class="nx-input" placeholder="Cuéntanos qué necesitas construir, qué problema resuelve, para quién..."></textarea>
        </div>

        <!-- Honeypot anti-bot -->
        <div style="position:absolute; left:-9999px;" aria-hidden="true">
          <label>Si eres humano, deja esto vacío</label>
          <input name="honeypot" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-nx-border">
          <div class="font-mono text-xs text-nx-dim">
            Tu peticion se guarda <span class="text-lava-edge">encriptada</span> y se procesa <span class="text-lava-edge">24/7</span>.
          </div>
          <button type="submit" class="lava-btn">
            <span>Enviar propuesta</span>
            <span>→</span>
          </button>
        </div>
      </form>

      <!-- Success / error panel -->
      <div id="result-panel" class="hidden mt-8"></div>

      <!-- Feature quotes shortcuts -->
      <aside class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-3 reveal">
        <a href="/NX-Studio/cotizador" class="lava-card p-4 hover:border-lava transition block">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">// alternativa</div>
          <div class="font-display font-semibold text-sm">Cotizador interactivo</div>
          <div class="text-xs text-nx-muted mt-1">Calcula el rango de inversion sin compromiso</div>
        </a>
        <a href="/NX-Studio/laboratorio" class="lava-card p-4 hover:border-lava transition block">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">// alternativa</div>
          <div class="font-display font-semibold text-sm">Laboratorio IA</div>
          <div class="text-xs text-nx-muted mt-1">Genera mockups HTML desde tu idea</div>
        </a>
        <div class="lava-card p-4">
          <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">// directo</div>
          <div class="font-display font-semibold text-sm">WhatsApp / email</div>
          <div class="text-xs text-nx-muted mt-1">+57 1 234 5678 · hola@nxstudio.dev</div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style is:global>
  .nx-input {
    width: 100%;
    background: var(--color-nx-bg);
    border: 1px solid var(--color-nx-border);
    color: var(--color-nx-text);
    padding: 0.625rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .nx-input:focus {
    border-color: var(--lava-edge);
    box-shadow: 0 0 0 2px var(--lava-glow-soft);
  }
  .nx-input::placeholder {
    color: var(--color-nx-dim);
  }
</style>

<script>
  // Features from pricing module
  const FEATURES = [
    { id: 'discovery', name: 'Discovery + Scoping', cat: 'core' },
    { id: 'design-system', name: 'Design System', cat: 'design' },
    { id: 'responsive', name: 'Responsive + Mobile', cat: 'design' },
    { id: 'landing', name: 'Landing page', cat: 'design' },
    { id: 'dashboard', name: 'Dashboard / Admin', cat: 'design' },
    { id: 'auth', name: 'Auth + Roles', cat: 'backend' },
    { id: 'api', name: 'API REST/GraphQL', cat: 'backend' },
    { id: 'db', name: 'Database + ORM', cat: 'backend' },
    { id: 'integrations', name: 'Integraciones externas', cat: 'backend' },
    { id: 'osint', name: 'OSINT (investigación)', cat: 'backend' },
    { id: 'analytics', name: 'Analytics + Métricas', cat: 'growth' },
    { id: 'seo', name: 'SEO técnico', cat: 'growth' },
    { id: 'i18n', name: 'i18n multi-idioma', cat: 'growth' },
    { id: 'testing', name: 'Testing (unit + e2e)', cat: 'ops' },
    { id: 'a11y', name: 'Auditoría a11y', cat: 'ops' },
    { id: 'security', name: 'Pen-testing básico', cat: 'ops' },
    { id: 'deploy', name: 'Deploy + CI/CD', cat: 'ops' },
    { id: 'docs', name: 'Docs técnicas', cat: 'ops' },
  ];

  const grid = document.getElementById('features-grid');
  if (grid) {
    const defaults = new Set(['discovery', 'design-system', 'api', 'db', 'auth', 'testing', 'deploy']);
    grid.innerHTML = FEATURES.map((f) => `
      <label class="flex items-center gap-3 p-3 border border-nx-border bg-nx-bg cursor-pointer hover:border-lava-edge transition" data-cat="${f.cat}">
        <input type="checkbox" name="features" value="${f.id}" ${defaults.has(f.id) ? 'checked' : ''} class="nx-feature-cb" />
        <span class="font-mono text-sm">${f.name}</span>
      </label>
    `).join('');
  }

  const form = document.getElementById('licitacion-form') as HTMLFormElement | null;
  const panel = document.getElementById('result-panel');
  if (form && panel) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const features: string[] = [];
      form.querySelectorAll<HTMLInputElement>('input[name=features]:checked').forEach((cb) => features.push(cb.value));

      const payload = {
        nombre: String(fd.get('nombre') || ''),
        email: String(fd.get('email') || ''),
        empresa: fd.get('empresa') || null,
        telefono: fd.get('telefono') || null,
        pais: fd.get('pais') || null,
        tipo: String(fd.get('tipo') || 'webapp'),
        engagement: String(fd.get('engagement') || 'fixed'),
        urgencia: String(fd.get('urgencia') || 'normal'),
        descripcion: String(fd.get('descripcion') || ''),
        features,
        modifiers: [],
        honeypot: String(fd.get('honeypot') || ''),
      };

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando...'; }

      try {
        const res = await fetch('/NX-Studio/api/licitacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.ok) {
          panel.innerHTML = `
            <div class="lava-card lava-card-accent p-6">
              <span class="lava-tag mb-3">// licitacion #${data.licitacion_id} · status: nueva</span>
              <h3 class="font-display text-2xl font-bold mb-3">Propuesta recibida ✓</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div>
                  <div class="font-mono text-xs text-nx-muted">Rango estimado</div>
                  <div class="font-display text-2xl text-lava">$${data.cotizacion.total_low.toLocaleString()} - $${data.cotizacion.total_high.toLocaleString()}</div>
                </div>
                <div>
                  <div class="font-mono text-xs text-nx-muted">Horas</div>
                  <div class="font-display text-2xl text-lava-edge">${data.cotizacion.total_hours}h</div>
                </div>
                <div>
                  <div class="font-mono text-xs text-nx-muted">Banda</div>
                  <div class="font-display text-2xl">${data.cotizacion.band}</div>
                </div>
              </div>
              <div class="border-t border-nx-border pt-4">
                <div class="font-mono text-xs uppercase tracking-widest text-lava-edge mb-2">// próximos pasos</div>
                <ul class="text-sm text-nx-muted space-y-1">
                  ${data.next_steps.map((s: string) => `<li class="flex gap-2"><span class="text-lava">▸</span>${s}</li>`).join('')}
                </ul>
              </div>
              <div class="mt-4 pt-4 border-t border-nx-border text-xs text-nx-dim font-mono">
                // Tu peticion ID es <b class="text-lava-edge">#${data.licitacion_id}</b>. Guarda este número para seguimiento.
              </div>
            </div>`;
          panel.classList.remove('hidden');
          form.reset();
          // Re-apply defaults
          form.querySelectorAll<HTMLInputElement>('input[name=features]').forEach((cb) => {
            if (defaults.has(cb.value)) cb.checked = true;
          });
        } else {
          panel.innerHTML = `<div class="lava-card p-6" style="border-color:#ef4444;">
            <div class="font-mono text-xs text-red-400 mb-2">// error · ${data.error || 'unknown'}</div>
            <div class="text-sm">${JSON.stringify(data.issues || data.detail || '')}</div>
          </div>`;
          panel.classList.remove('hidden');
        }
      } catch (err) {
        panel.innerHTML = `<div class="lava-card p-6" style="border-color:#ef4444;">
          <div class="text-sm">Error de red: ${String(err)}</div>
        </div>`;
        panel.classList.remove('hidden');
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = '<span>Enviar propuesta</span><span>→</span>'; }
      }
    });
  }
</script>
</Layout>