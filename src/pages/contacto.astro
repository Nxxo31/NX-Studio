---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Contacto — NX-Studio">
  <Nav />

  <main class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <header class="text-center">
        <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ contacto</p>
        <h1 class="mt-3 font-display text-5xl font-bold md:text-6xl">Hablemos</h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-nx-muted">
          30 minutos, sin compromiso, sin slide deck.
          Me cuentas tu idea, te digo honestamente si puedo ayudarte y cómo.
        </p>
      </header>

      <div class="mt-16 grid gap-8 lg:grid-cols-5">
        <!-- Form -->
        <form
          class="lg:col-span-3 rounded-3xl border border-nx-border bg-nx-surface p-8"
          action="https://formspree.io/f/REEMPLAZAR"
          method="POST"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="font-mono text-xs uppercase tracking-widest text-nx-dim">Nombre</span>
              <input
                name="name"
                required
                class="mt-2 w-full rounded-lg border border-nx-border bg-nx-bg px-4 py-3 outline-none focus:border-nx-accent"
              />
            </label>
            <label class="block">
              <span class="font-mono text-xs uppercase tracking-widest text-nx-dim">Email</span>
              <input
                type="email"
                name="email"
                required
                class="mt-2 w-full rounded-lg border border-nx-border bg-nx-bg px-4 py-3 outline-none focus:border-nx-accent"
              />
            </label>
          </div>

          <label class="mt-4 block">
            <span class="font-mono text-xs uppercase tracking-widest text-nx-dim">Empresa / Proyecto (opcional)</span>
            <input
              name="company"
              class="mt-2 w-full rounded-lg border border-nx-border bg-nx-bg px-4 py-3 outline-none focus:border-nx-accent"
            />
          </label>

          <label class="mt-4 block">
            <span class="font-mono text-xs uppercase tracking-widest text-nx-dim">¿Qué quieres construir?</span>
            <textarea
              name="message"
              required
              rows="6"
              placeholder="Describe brevemente tu idea, problema o necesidad. No te preocupes por el detalle técnico, eso lo resolvemos juntos."
              class="mt-2 w-full rounded-lg border border-nx-border bg-nx-bg px-4 py-3 outline-none focus:border-nx-accent"
            ></textarea>
          </label>

          <fieldset class="mt-4">
            <legend class="font-mono text-xs uppercase tracking-widest text-nx-dim">¿En qué etapa estás?</legend>
            <div class="mt-2 grid gap-2 sm:grid-cols-2">
              {['Tengo una idea', 'Tengo un prototipo', 'Tengo producto y quiero escalar', 'Busco equipo de mantenimiento'].map((opt) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-nx-border bg-nx-bg p-3 text-sm hover:border-nx-accent transition has-[:checked]:border-nx-accent has-[:checked]:bg-nx-accent/10">
                  <input type="radio" name="stage" value={opt} class="accent-nx-accent" />
                  {opt}
                </label>
              ))}
            </div>
          </fieldset>

          <button
            type="submit"
            class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-nx-accent to-nx-purple px-6 py-3 text-sm font-semibold text-white hover:shadow-lg hover:shadow-nx-accent/30"
          >
            Enviar mensaje →
          </button>

          <p class="mt-4 text-center font-mono text-xs text-nx-dim">
            Respondo en menos de 24h. Habitualmente en menos de 4h.
          </p>
        </form>

        <!-- Sidebar -->
        <aside class="lg:col-span-2 space-y-6">
          <div class="rounded-2xl border border-nx-border bg-nx-surface p-6">
            <h3 class="font-mono text-xs uppercase tracking-widest text-nx-accent">Email directo</h3>
            <a href="mailto:hello@nxstudio.dev" class="mt-2 block font-display text-lg hover:text-nx-accent">
              hello@nxstudio.dev
            </a>
          </div>

          <div class="rounded-2xl border border-nx-border bg-nx-surface p-6">
            <h3 class="font-mono text-xs uppercase tracking-widest text-nx-accent">GitHub</h3>
            <a
              href="https://github.com/Nxxo31"
              target="_blank"
              rel="noopener"
              class="mt-2 block font-display text-lg hover:text-nx-accent"
            >
              github.com/Nxxo31
            </a>
            <p class="mt-2 text-sm text-nx-muted">
              19 repos públicos. El código es la mejor referencia.
            </p>
          </div>

          <div class="rounded-2xl border border-nx-border bg-nx-surface p-6">
            <h3 class="font-mono text-xs uppercase tracking-widest text-nx-accent">Ubicación</h3>
            <p class="mt-2 font-display text-lg">Neiva, Colombia</p>
            <p class="mt-1 font-mono text-xs text-nx-dim">UTC-05 · Servicio remoto LATAM + global</p>
          </div>

          <div class="rounded-2xl border border-nx-border bg-gradient-to-br from-nx-accent/10 to-nx-purple/10 p-6">
            <h3 class="font-display text-lg font-semibold">Prefieres probar primero?</h3>
            <p class="mt-2 text-sm text-nx-muted">
              Usa el Laboratorio IA para generar un mockup de tu idea sin compromiso.
            </p>
            <a href="/NX-Studio/laboratorio" class="mt-4 inline-flex items-center gap-2 rounded-full bg-nx-bg border border-nx-border px-4 py-2 text-sm font-semibold hover:border-nx-accent">
              ◈ Probar Laboratorio →
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Base>