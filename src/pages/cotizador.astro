---
import Layout from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackHome from '../components/BackHome.astro';
import { FEATURES, MODIFIERS, ENGAGEMENT_SHAPES, CATEGORIES, type EngagementShape } from '../data/pricing';
import { PRESETS, MARKET, formatCop, formatUsd } from '../data/pricing-baseline';
import { getT, getLocale, localeUrl } from '~/i18n';

const t = getT(Astro);
const locale = getLocale(Astro);

// Data-driven copy: pricing.ts es request-invariante — labels via t() por id estable.
const featuresByCategory = Object.entries(CATEGORIES).map(([id]) => ({
  id,
  items: FEATURES.filter((f) => f.category === id),
}));

// Mapas id → label traducido para el script client-side (breakdown + band).
const i18nFeatures = Object.fromEntries(FEATURES.map((f) => [f.id, t(`pages.cotizador.features.${f.id}.name`)]));
const i18nShapes = Object.fromEntries(Object.keys(ENGAGEMENT_SHAPES).map((id) => [id, t(`pages.cotizador.shapes.${id}.name`)]));
const i18nModifiers = Object.fromEntries(MODIFIERS.map((m) => [m.id, t(`pages.cotizador.modifiers.${m.id}.name`)]));
const i18nBands = Object.fromEntries(['Starter', 'Standard', 'Growth', 'Enterprise'].map((b) => [b, t(`pages.cotizador.bands.${b}`)]));
const i18nLabels = {
  shape: t('pages.cotizador.breakdown.shape'),
  subtotalFeatures: t('pages.cotizador.breakdown.subtotalFeatures'),
  baseFee: t('pages.cotizador.breakdown.baseFee'),
  multiplier: t('pages.cotizador.breakdown.multiplier'),
};

// Copy nuevo del cotizador — trilingüe inline (data-driven, sin tocar 3 JSONs).
type PresetCopy = { step0: string; presetsSub: string; marketCo: string; marketIntl: string; floor: string; maintenance: string };
const PRESET_COPY: Record<string, PresetCopy> = {
  es: {
    step0: 'Paso 0 — ¿Qué necesitas?',
    presetsSub: 'Rangos reales de mercado: Colombia (COP) e internacional (USD), research 2025-2026. Elige un punto de partida y el motor arma tu cotización exacta abajo.',
    marketCo: 'Mercado Colombia',
    marketIntl: 'Internacional',
    floor: 'Ningún proyecto es gratis: hasta el más simple — un blog, una landing — tiene costo de diseño, desarrollo, dominio y hosting.',
    maintenance: 'Mantenimiento recomendado: 15–25% del valor del desarrollo al año.',
  },
  en: {
    step0: 'Step 0 — What do you need?',
    presetsSub: 'Real market ranges: Colombia (COP) and international (USD), 2025-2026 research. Pick a starting point and the engine builds your exact quote below.',
    marketCo: 'Colombia market',
    marketIntl: 'International',
    floor: 'No project is free: even the simplest one — a blog, a landing — costs design, development, domain and hosting.',
    maintenance: 'Recommended maintenance: 15–25% of the development value per year.',
  },
  pt: {
    step0: 'Passo 0 — O que você precisa?',
    presetsSub: 'Faixas reais de mercado: Colômbia (COP) e internacional (USD), research 2025-2026. Escolha um ponto de partida e o motor monta sua cotação exata abaixo.',
    marketCo: 'Mercado Colômbia',
    marketIntl: 'Internacional',
    floor: 'Nenhum projeto é grátis: até o mais simples — um blog, uma landing — tem custo de design, desenvolvimento, domínio e hospedagem.',
    maintenance: 'Manutenção recomendada: 15–25% do valor do desenvolvimento ao ano.',
  },
};
const C = PRESET_COPY[locale] ?? PRESET_COPY.es;

// Presets serializables para el script client-side.
const presetsData = PRESETS.map((p) => ({ id: p.id, shape: p.shape, features: p.features, cop: p.cop, usd: p.usd }));
const marketCopy = { co: C.marketCo, intl: C.marketIntl, maintenance: C.maintenance };
---

<Layout title={t('pages.cotizador.title')} description={t('pages.cotizador.description')}>
  <Nav />
  <main>
  <section class="relative px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl">

      <!-- Header -->
      <header class="mb-12 reveal">
        <BackHome />
        <span class="lava-tag mb-4">// pricing-engine v0.1</span>
        <h1 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-4">
          {t('pages.cotizador.headingA')} <span class="text-lava">{t('pages.cotizador.headingEm')}</span>
        </h1>
        <p class="text-nx-muted max-w-2xl text-lg">
          {t('pages.cotizador.sub')}
        </p>
        <p class="text-nx-dim text-sm mt-4 font-mono">
          {t('pages.cotizador.disclaimer')}
        </p>
      </header>

      <!-- Paso 0: presets con rangos de mercado (nacional + internacional) -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2">{C.step0}</h2>
        <p class="text-sm text-nx-muted mb-4 max-w-3xl">{C.presetsSub}</p>
        <div id="presets" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {PRESETS.map((p) => (
            <button type="button" data-preset={p.id} class="preset-btn lava-card p-4 text-left transition cursor-pointer" aria-pressed="false">
              <div class="font-display font-semibold text-sm mb-2">{p.label[locale] ?? p.label.es}</div>
              <div class="font-mono text-[10px] text-nx-muted">{formatCop(p.cop[0])} – {formatCop(p.cop[1])}</div>
              <div class="font-mono text-[10px] text-nx-dim">{formatUsd(p.usd[0])} – {formatUsd(p.usd[1])} USD · {p.weeks[0]}–{p.weeks[1]} sem</div>
            </button>
          ))}
        </div>
        <p class="text-xs text-nx-dim mt-3 font-mono">{C.floor}</p>
      </div>

      <!-- Engagement shape selector -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">{t('pages.cotizador.step1')}</h2>
        <div id="shapes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
          {Object.values(ENGAGEMENT_SHAPES).map((s) => (
            <button
              type="button"
              data-shape={s.id}
              class="shape-btn lava-card p-4 text-left transition cursor-pointer"
              aria-pressed="false"
            >
              <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">{s.id}</div>
              <div class="font-display font-semibold mb-2">{t(`pages.cotizador.shapes.${s.id}.name`)}</div>
              <div class="text-xs text-nx-muted leading-relaxed">{t(`pages.cotizador.shapes.${s.id}.description`)}</div>
              <div class="mt-3 font-mono text-xs text-nx-dim">
                base ${s.baseFee} · {s.baseHours || '–'}h
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Features por categoría -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">{t('pages.cotizador.step2')}</h2>
        <div class="space-y-8">
          {featuresByCategory.map((cat) => (
            <div>
              <div class="mb-3">
                <div class="font-display font-semibold text-lg">{t(`pages.cotizador.categories.${cat.id}.name`)}</div>
                <div class="text-xs text-nx-muted">{t(`pages.cotizador.categories.${cat.id}.description`)}</div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {cat.items.map((f) => (
                  <label
                    data-feature={f.id}
                    class="feature-tile lava-card p-4 cursor-pointer flex items-start gap-3 transition"
                  >
                    <input type="checkbox" class="sr-only peer" />
                    <div class="mt-0.5 h-4 w-4 shrink-0 border border-nx-border-strong rounded-sm flex items-center justify-center peer-checked:bg-lava peer-checked:border-lava transition">
                      <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M2 6.5L5 9.5L10 2.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-baseline justify-between gap-2 mb-1">
                        <div class="font-display font-medium text-sm">{t(`pages.cotizador.features.${f.id}.name`)}</div>
                        <div class="font-mono text-xs text-nx-dim shrink-0">{f.hours}h · ${f.hours * f.rate}</div>
                      </div>
                      <p class="text-xs text-nx-muted leading-relaxed">{t(`pages.cotizador.features.${f.id}.description`)}</p>
                      {f.optional && (
                        <span class="lava-tag mt-2" style="font-size: 0.625rem;">{t('pages.cotizador.optional')}</span>
                      )}
                    </div>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Modifiers -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">{t('pages.cotizador.step3')}</h2>
        <div id="modifiers" class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {MODIFIERS.map((m) => (
            <label
              data-modifier={m.id}
              class="modifier-tile lava-card p-4 cursor-pointer flex items-start gap-3 transition"
            >
              <input type="checkbox" class="sr-only peer" />
              <div class="mt-0.5 h-4 w-4 shrink-0 border border-nx-border-strong rounded-sm peer-checked:bg-lava peer-checked:border-lava transition"></div>
              <div class="flex-1">
                <div class="font-display font-medium text-sm mb-1">{t(`pages.cotizador.modifiers.${m.id}.name`)}</div>
                <p class="text-xs text-nx-muted leading-relaxed">{t(`pages.cotizador.modifiers.${m.id}.description`)}</p>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Live quote (sticky right) -->
      <aside id="quote-panel" class="lava-card lava-card-accent p-6 lg:p-8 sticky bottom-4 z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">

          <div class="md:col-span-2">
            <div class="font-mono text-xs uppercase tracking-widest text-lava-edge mb-2">{t('pages.cotizador.panel.range')}</div>
            <div class="flex items-baseline gap-2 flex-wrap">
              <span id="q-low"  class="font-display text-3xl lg:text-4xl font-bold">$0</span>
              <span class="text-nx-dim text-2xl">—</span>
              <span id="q-high" class="font-display text-3xl lg:text-4xl font-bold">$0</span>
              <span id="q-band" class="lava-tag ml-2">{t('pages.cotizador.bands.Starter')}</span>
            </div>
            <div class="text-xs text-nx-muted mt-2 font-mono">
              <span id="q-hours">0h</span> {t('pages.cotizador.panel.estimated')} · base fee <span id="q-base">$0</span>
              <span id="q-usd" class="text-nx-dim"></span>
            </div>
            <div id="q-market" class="mt-3 flex flex-wrap gap-2"></div>
            <div class="mt-3 flex items-center gap-2">
              <label for="q-currency" class="font-mono text-[10px] uppercase tracking-widest text-nx-muted">{t('pages.cotizador.panel.currency')}</label>
              <select id="q-currency" class="font-mono text-xs bg-transparent border border-nx-border px-2 py-1 text-nx-text">
                <option value="COP" selected>COP</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="MXN">MXN</option>
                <option value="BRL">BRL</option>
                <option value="ARS">ARS</option>
                <option value="CLP">CLP</option>
                <option value="PEN">PEN</option>
                <option value="GBP">GBP</option>
              </select>
            </div>
          </div>

          <div class="md:col-span-1">
            <div class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2">Features</div>
            <div id="q-count" class="font-display text-2xl">0</div>
            <div class="text-xs text-nx-muted">{t('pages.cotizador.panel.selected')}</div>
          </div>

          <div class="md:col-span-1 flex flex-col md:items-end gap-2">
            <a id="q-cta" href={localeUrl('/contacto', locale)} class="lava-btn text-center">
              {t('pages.cotizador.panel.cta')}
            </a>
            <a id="q-whatsapp" href="https://wa.me/573103312705" target="_blank" rel="noopener" class="lava-btn lava-btn-ghost text-center text-sm">
              {t('pages.cotizador.panel.whatsappCta')}
            </a>
          </div>
        </div>

        <details class="mt-6">
          <summary class="font-mono text-xs uppercase tracking-widest text-nx-muted cursor-pointer hover:text-lava-edge transition">
            {t('pages.cotizador.panel.breakdown')}
          </summary>
          <div id="q-breakdown" class="mt-4 space-y-2 font-mono text-xs"></div>
        </details>
      </aside>

    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ i18nFeatures, i18nShapes, i18nModifiers, i18nBands, i18nLabels, presetsData, marketCopy }} is:inline>
  // define:vars declara los mapas i18n como consts en este scope; los expongo
  // para el script module (el breakdown client-side los consume).
  window.__cotizadorI18n = { i18nFeatures, i18nShapes, i18nModifiers, i18nBands, i18nLabels, presets: presetsData, marketCopy };
</script>
<script>
  import { computeQuote, ENGAGEMENT_SHAPES, type EngagementShape } from '../data/pricing';

  type State = {
    shape: EngagementShape;
    featureIds: string[];
    modifierIds: string[];
    currency: string;
  };

  const state: State = {
    shape: 'fixed',
    featureIds: ['discovery', 'design-system', 'api', 'db', 'auth', 'responsive', 'testing', 'deploy', 'docs'],
    modifierIds: [],
    currency: 'COP',
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    document.querySelector<T>(sel);

  const fmt = new Intl.NumberFormat('en-US');

  const FALLBACK_RATES: Record<string, number> = {
    USD: 1, COP: 3900, EUR: 0.92, MXN: 17.2, BRL: 5.4, ARS: 1150, CLP: 940, PEN: 3.75, GBP: 0.79,
  };
  let rates: Record<string, number> = { ...FALLBACK_RATES };

  function fmtCurrency(amount: number, cur: string): string {
    try {
      return new Intl.NumberFormat(cur === 'COP' ? 'es-CO' : 'en-US', {
        style: 'currency', currency: cur, maximumFractionDigits: 0,
      }).format(amount);
    } catch {
      return `${cur} ${fmt.format(Math.round(amount))}`;
    }
  }

  async function loadRates(): Promise<void> {
    try {
      const cached = localStorage.getItem('nx-fx-rates');
      if (cached) {
        const { ts, r } = JSON.parse(cached) as { ts: number; r: Record<string, number> };
        if (Date.now() - ts < 24 * 60 * 60 * 1000) { rates = { ...FALLBACK_RATES, ...r }; return; }
      }
      const res = await fetch('https://open.er-api.com/v6/latest/USD');
      const data = await res.json() as { rates?: Record<string, number> };
      if (data?.rates) {
        rates = { ...FALLBACK_RATES, ...data.rates };
        localStorage.setItem('nx-fx-rates', JSON.stringify({ ts: Date.now(), r: data.rates }));
      }
    } catch { /* API caída u offline: se quedan las tasas fallback */ }
  }

  // Labels i18n inyectados server-side por define:vars en el script is:inline anterior
  const L = (window as any).__cotizadorI18n as {
    i18nFeatures: Record<string, string>;
    i18nShapes: Record<string, string>;
    i18nModifiers: Record<string, string>;
    i18nBands: Record<string, string>;
    i18nLabels: { shape: string; subtotalFeatures: string; baseFee: string; multiplier: string };
  };

  function render() {
    const quote = computeQuote(state);

    // Panel header (moneda seleccionada + ancla USD)
    const rate = rates[state.currency] ?? 1;
    const lowConverted = Math.round(quote.totalLow * rate);
    const highConverted = Math.round(quote.totalHigh * rate);
    $('#q-low').textContent  = fmtCurrency(lowConverted, state.currency);
    $('#q-high').textContent = fmtCurrency(highConverted, state.currency);
    $('#q-hours').textContent = fmt.format(quote.totalHours) + 'h';
    $('#q-base').textContent  = '$' + fmt.format(quote.baseFee);
    $('#q-count').textContent = String(state.featureIds.length);
    $('#q-band').textContent  = L.i18nBands[quote.bandLabel] ?? quote.bandLabel;
    const usdNote = $('#q-usd');
    if (usdNote) usdNote.textContent = state.currency === 'USD' ? '' : ` · ≈ $${fmt.format(quote.totalLow)}-$${fmt.format(quote.totalHigh)} USD`;

    // CTAs: /contacto con el contexto completo + WhatsApp prefilled
    const cta = document.getElementById('q-cta') as HTMLAnchorElement | null;
    if (cta) {
      const url = new URL(cta.getAttribute('href') || '/contacto', window.location.origin);
      url.search = new URLSearchParams({
        from: 'cotizador',
        shape: state.shape,
        features: state.featureIds.join(','),
        mods: state.modifierIds.join(','),
        cur: state.currency,
        low: String(lowConverted),
        high: String(highConverted),
      }).toString();
      cta.setAttribute('href', url.pathname + url.search);
    }
    const wa = document.getElementById('q-whatsapp') as HTMLAnchorElement | null;
    if (wa) {
      const msg = [
        'Hola NX-Studio, quiero cotizar un proyecto.',
        `Engagement: ${L.i18nShapes[state.shape] ?? state.shape}`,
        `Moneda: ${state.currency}`,
        `Rango: ${fmtCurrency(lowConverted, state.currency)} - ${fmtCurrency(highConverted, state.currency)}`,
        `Features: ${state.featureIds.map((id) => L.i18nFeatures[id] ?? id).join(', ') || '(base)'}`,
      ].join('\n');
      wa.href = `https://wa.me/573103312705?text=${encodeURIComponent(msg)}`;
    }

    // Breakdown
    const bd = $('#q-breakdown');
    if (bd) {
      bd.innerHTML = `
        <div class="flex justify-between"><span>${L.i18nLabels.shape}: <b>${L.i18nShapes[quote.shape.id] ?? quote.shape.name}</b></span><span>$${fmt.format(quote.baseFee)}</span></div>
        ${quote.features.map(({ feature, subtotal }) => `
          <div class="flex justify-between text-nx-muted">
            <span>· ${L.i18nFeatures[feature.id] ?? feature.name} <span class="text-nx-dim">(${feature.hours}h × $${feature.rate})</span></span>
            <span>$${fmt.format(subtotal)}</span>
          </div>
        `).join('')}
        ${quote.modifiers.length ? `<div class="hairline my-2"></div>` + quote.modifiers.map((m) =>
          `<div class="flex justify-between text-lava-edge"><span>· ${L.i18nModifiers[m.id] ?? m.name}</span><span>×${m.multiplier.toFixed(2)}</span></div>`
        ).join('') : ''}
        <div class="hairline my-2"></div>
        <div class="flex justify-between"><span>${L.i18nLabels.subtotalFeatures}</span><span>$${fmt.format(quote.subtotalFeatures)}</span></div>
        <div class="flex justify-between text-nx-muted"><span>${L.i18nLabels.baseFee}</span><span>$${fmt.format(quote.baseFee)}</span></div>
        <div class="flex justify-between text-nx-muted"><span>${L.i18nLabels.multiplier}</span><span>×${quote.multiplier.toFixed(3)}</span></div>
      `;
    }

    // Visual state of shape buttons
    document.querySelectorAll<HTMLElement>('.shape-btn').forEach((btn) => {
      const isActive = btn.dataset.shape === state.shape;
      btn.classList.toggle('lava-card-accent', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });

    // Visual state of feature tiles
    document.querySelectorAll<HTMLElement>('.feature-tile').forEach((tile) => {
      const id = tile.dataset.feature;
      if (!id) return;
      const isOn = state.featureIds.includes(id);
      tile.classList.toggle('lava-card-accent', isOn);
      const cb = tile.querySelector('input[type=checkbox]');
      if (cb) (cb as HTMLInputElement).checked = isOn;
    });

    // Visual state of modifier tiles
    document.querySelectorAll<HTMLElement>('.modifier-tile').forEach((tile) => {
      const id = tile.dataset.modifier;
      if (!id) return;
      const isOn = state.modifierIds.includes(id);
      tile.classList.toggle('lava-card-accent', isOn);
      const cb = tile.querySelector('input[type=checkbox]');
      if (cb) (cb as HTMLInputElement).checked = isOn;
    });
  }

  // Wire shape buttons
  document.querySelectorAll<HTMLElement>('.shape-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.shape as EngagementShape | undefined;
      if (id && id in ENGAGEMENT_SHAPES) {
        state.shape = id;
        render();
      }
    });
  });

  // Wire feature toggles
  document.querySelectorAll<HTMLElement>('.feature-tile').forEach((tile) => {
    tile.addEventListener('click', (e) => {
      // Avoid double-toggle when clicking the checkbox itself
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT') return;
      const id = tile.dataset.feature;
      if (!id) return;
      const idx = state.featureIds.indexOf(id);
      if (idx >= 0) state.featureIds.splice(idx, 1);
      else state.featureIds.push(id);
      render();
    });
  });

  // Wire modifier toggles
  document.querySelectorAll<HTMLElement>('.modifier-tile').forEach((tile) => {
    tile.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT') return;
      const id = tile.dataset.modifier;
      if (!id) return;
      const idx = state.modifierIds.indexOf(id);
      if (idx >= 0) state.modifierIds.splice(idx, 1);
      else state.modifierIds.push(id);
      render();
    });
  });

  // Wire preset buttons — punto de partida con rangos de mercado (CO + intl)
  const M = (window as any).__cotizadorI18n as {
    presets: Array<{ id: string; shape: EngagementShape; features: string[]; cop: [number, number]; usd: [number, number] }>;
    marketCopy: { co: string; intl: string; maintenance: string };
  };
  let activePreset: string | null = null;

  function renderMarket(): void {
    const el = document.getElementById('q-market');
    if (!el) return;
    const p = M.presets.find((x) => x.id === activePreset);
    if (!p) { el.innerHTML = ''; return; }
    const copF = (n: number) => {
      try {
        return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);
      } catch { return `$${fmt.format(n)} COP`; }
    };
    el.innerHTML = `
      <span class="lava-tag">${M.marketCopy.co}: ${copF(p.cop[0])} – ${copF(p.cop[1])}</span>
      <span class="lava-tag">${M.marketCopy.intl}: $${fmt.format(p.usd[0])} – $${fmt.format(p.usd[1])} USD</span>
      <span class="font-mono text-[10px] text-nx-dim w-full">${M.marketCopy.maintenance}</span>
    `;
  }

  document.querySelectorAll<HTMLElement>('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = M.presets.find((x) => x.id === btn.dataset.preset);
      if (!p) return;
      activePreset = p.id;
      state.shape = p.shape;
      state.featureIds = [...p.features];
      document.querySelectorAll<HTMLElement>('.preset-btn').forEach((b) => {
        const on = b.dataset.preset === p.id;
        b.classList.toggle('lava-card-accent', on);
        b.setAttribute('aria-pressed', String(on));
      });
      render();
      renderMarket();
      document.getElementById('quote-panel')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  // Wire currency selector
  const curSel = document.getElementById('q-currency') as HTMLSelectElement | null;
  curSel?.addEventListener('change', () => {
    if (curSel.value) { state.currency = curSel.value; render(); }
  });

  // Scroll reveal observer (si no está global)
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    reveals.forEach((r) => io.observe(r));
  } else {
    reveals.forEach((r) => r.classList.add('is-visible'));
  }

  render();
  loadRates().then(() => render());
</script>
