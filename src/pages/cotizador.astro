---
import Layout from '../layouts/Base.astro';
import { FEATURES, MODIFIERS, ENGAGEMENT_SHAPES, CATEGORIES, computeQuote, type EngagementShape } from '../data/pricing';

const featuresByCategory = Object.entries(CATEGORIES).map(([id, meta]) => ({
  id,
  meta,
  items: FEATURES.filter((f) => f.category === id),
}));
---

<Layout title="Cotizador · NX-Studio" description="Estimador de proyectos por features. Selecciona capacidades, ve el rango de inversión en tiempo real.">
  <section class="relative px-6 py-20 lg:py-28">
    <div class="mx-auto max-w-6xl">

      <!-- Header -->
      <header class="mb-12 reveal">
        <span class="lava-tag mb-4">// pricing-engine v0.1</span>
        <h1 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-4">
          Cotizador por <span class="text-lava">features</span>
        </h1>
        <p class="text-nx-muted max-w-2xl text-lg">
          Selecciona las capacidades que necesita tu proyecto. El rango de inversión se calcula en tiempo real
          según horas estimadas, tarifa blended, modifiers de urgencia y engagement shape.
        </p>
        <p class="text-nx-dim text-sm mt-4 font-mono">
          ⚠ Rango indicativo. No publicamos precio exacto — depende de scope, complejidad y evoluciones.
        </p>
      </header>

      <!-- Engagement shape selector -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">01 / Engagement shape</h2>
        <div id="shapes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
          {Object.values(ENGAGEMENT_SHAPES).map((s) => (
            <button
              type="button"
              data-shape={s.id}
              class="shape-btn lava-card p-4 text-left transition cursor-pointer"
              aria-pressed="false"
            >
              <div class="font-mono text-[10px] uppercase tracking-widest text-lava-edge mb-1">{s.id}</div>
              <div class="font-display font-semibold mb-2">{s.name}</div>
              <div class="text-xs text-nx-muted leading-relaxed">{s.description}</div>
              <div class="mt-3 font-mono text-xs text-nx-dim">
                base ${s.baseFee} · {s.baseHours || '–'}h
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Features por categoría -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">02 / Selecciona features</h2>
        <div class="space-y-8">
          {featuresByCategory.map((cat) => (
            <div>
              <div class="mb-3">
                <div class="font-display font-semibold text-lg">{cat.meta.name}</div>
                <div class="text-xs text-nx-muted">{cat.meta.description}</div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {cat.items.map((f) => (
                  <label
                    data-feature={f.id}
                    class="feature-tile lava-card p-4 cursor-pointer flex items-start gap-3 transition"
                  >
                    <input type="checkbox" class="sr-only peer" />
                    <div class="mt-0.5 h-4 w-4 shrink-0 border border-nx-border-strong rounded-sm flex items-center justify-center peer-checked:bg-lava peer-checked:border-lava transition">
                      <svg class="w-3 h-3 text-black opacity-0 peer-checked:opacity-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M2 6.5L5 9.5L10 2.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-baseline justify-between gap-2 mb-1">
                        <div class="font-display font-medium text-sm">{f.name}</div>
                        <div class="font-mono text-xs text-nx-dim shrink-0">{f.hours}h · ${f.hours * f.rate}</div>
                      </div>
                      <p class="text-xs text-nx-muted leading-relaxed">{f.description}</p>
                      {f.optional && (
                        <span class="lava-tag mt-2" style="font-size: 0.625rem;">optional</span>
                      )}
                    </div>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Modifiers -->
      <div class="mb-10 reveal">
        <h2 class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-4">03 / Modifiers</h2>
        <div id="modifiers" class="grid grid-cols-1 md:grid-cols-3 gap-3">
          {MODIFIERS.map((m) => (
            <label
              data-modifier={m.id}
              class="modifier-tile lava-card p-4 cursor-pointer flex items-start gap-3 transition"
            >
              <input type="checkbox" class="sr-only peer" />
              <div class="mt-0.5 h-4 w-4 shrink-0 border border-nx-border-strong rounded-sm peer-checked:bg-lava peer-checked:border-lava transition"></div>
              <div class="flex-1">
                <div class="font-display font-medium text-sm mb-1">{m.name}</div>
                <p class="text-xs text-nx-muted leading-relaxed">{m.description}</p>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Live quote (sticky right) -->
      <aside id="quote-panel" class="lava-card lava-card-accent p-6 lg:p-8 sticky bottom-4 z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">

          <div class="md:col-span-2">
            <div class="font-mono text-xs uppercase tracking-widest text-lava-edge mb-2">Rango indicativo</div>
            <div class="flex items-baseline gap-2 flex-wrap">
              <span id="q-low"  class="font-display text-3xl lg:text-4xl font-bold">$0</span>
              <span class="text-nx-dim text-2xl">—</span>
              <span id="q-high" class="font-display text-3xl lg:text-4xl font-bold">$0</span>
              <span id="q-band" class="lava-tag ml-2">Starter</span>
            </div>
            <div class="text-xs text-nx-muted mt-2 font-mono">
              <span id="q-hours">0h</span> estimadas · base fee <span id="q-base">$0</span>
            </div>
          </div>

          <div class="md:col-span-1">
            <div class="font-mono text-xs uppercase tracking-widest text-nx-muted mb-2">Features</div>
            <div id="q-count" class="font-display text-2xl">0</div>
            <div class="text-xs text-nx-muted">seleccionadas</div>
          </div>

          <div class="md:col-span-1 flex md:justify-end">
            <a href="/contacto" class="lava-btn">
              Solicitar scoping →
            </a>
          </div>
        </div>

        <details class="mt-6">
          <summary class="font-mono text-xs uppercase tracking-widest text-nx-muted cursor-pointer hover:text-lava-edge transition">
            Ver desglose
          </summary>
          <div id="q-breakdown" class="mt-4 space-y-2 font-mono text-xs"></div>
        </details>
      </aside>

    </div>
  </section>
</Layout>

<script>
  import { computeQuote, ENGAGEMENT_SHAPES, type EngagementShape } from '../data/pricing';

  type State = {
    shape: EngagementShape;
    featureIds: string[];
    modifierIds: string[];
  };

  const state: State = {
    shape: 'fixed',
    featureIds: ['discovery', 'design-system', 'api', 'db', 'auth', 'responsive', 'testing', 'deploy', 'docs'],
    modifierIds: [],
  };

  const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
    document.querySelector<T>(sel);

  const fmt = new Intl.NumberFormat('en-US');

  function render() {
    const quote = computeQuote(state);

    // Panel header
    $('#q-low').textContent  = '$' + fmt.format(quote.totalLow);
    $('#q-high').textContent = '$' + fmt.format(quote.totalHigh);
    $('#q-hours').textContent = fmt.format(quote.totalHours) + 'h';
    $('#q-base').textContent  = '$' + fmt.format(quote.baseFee);
    $('#q-count').textContent = String(state.featureIds.length);
    $('#q-band').textContent  = quote.bandLabel;

    // Breakdown
    const bd = $('#q-breakdown');
    if (bd) {
      bd.innerHTML = `
        <div class="flex justify-between"><span>Shape: <b>${quote.shape.name}</b></span><span>$${fmt.format(quote.baseFee)}</span></div>
        ${quote.features.map(({ feature, subtotal }) => `
          <div class="flex justify-between text-nx-muted">
            <span>· ${feature.name} <span class="text-nx-dim">(${feature.hours}h × $${feature.rate})</span></span>
            <span>$${fmt.format(subtotal)}</span>
          </div>
        `).join('')}
        ${quote.modifiers.length ? `<div class="hairline my-2"></div>` + quote.modifiers.map((m) =>
          `<div class="flex justify-between text-lava-edge"><span>· ${m.name}</span><span>×${m.multiplier.toFixed(2)}</span></div>`
        ).join('') : ''}
        <div class="hairline my-2"></div>
        <div class="flex justify-between"><span>Subtotal features</span><span>$${fmt.format(quote.subtotalFeatures)}</span></div>
        <div class="flex justify-between text-nx-muted"><span>Base fee (kickoff)</span><span>$${fmt.format(quote.baseFee)}</span></div>
        <div class="flex justify-between text-nx-muted"><span>Multiplier total</span><span>×${quote.multiplier.toFixed(3)}</span></div>
      `;
    }

    // Visual state of shape buttons
    document.querySelectorAll<HTMLElement>('.shape-btn').forEach((btn) => {
      const isActive = btn.dataset.shape === state.shape;
      btn.classList.toggle('lava-card-accent', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });

    // Visual state of feature tiles
    document.querySelectorAll<HTMLElement>('.feature-tile').forEach((tile) => {
      const id = tile.dataset.feature;
      if (!id) return;
      const isOn = state.featureIds.includes(id);
      tile.classList.toggle('lava-card-accent', isOn);
      const cb = tile.querySelector('input[type=checkbox]');
      if (cb) (cb as HTMLInputElement).checked = isOn;
    });

    // Visual state of modifier tiles
    document.querySelectorAll<HTMLElement>('.modifier-tile').forEach((tile) => {
      const id = tile.dataset.modifier;
      if (!id) return;
      const isOn = state.modifierIds.includes(id);
      tile.classList.toggle('lava-card-accent', isOn);
      const cb = tile.querySelector('input[type=checkbox]');
      if (cb) (cb as HTMLInputElement).checked = isOn;
    });
  }

  // Wire shape buttons
  document.querySelectorAll<HTMLElement>('.shape-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.shape as EngagementShape | undefined;
      if (id && id in ENGAGEMENT_SHAPES) {
        state.shape = id;
        render();
      }
    });
  });

  // Wire feature toggles
  document.querySelectorAll<HTMLElement>('.feature-tile').forEach((tile) => {
    tile.addEventListener('click', (e) => {
      // Avoid double-toggle when clicking the checkbox itself
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT') return;
      const id = tile.dataset.feature;
      if (!id) return;
      const idx = state.featureIds.indexOf(id);
      if (idx >= 0) state.featureIds.splice(idx, 1);
      else state.featureIds.push(id);
      render();
    });
  });

  // Wire modifier toggles
  document.querySelectorAll<HTMLElement>('.modifier-tile').forEach((tile) => {
    tile.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'INPUT') return;
      const id = tile.dataset.modifier;
      if (!id) return;
      const idx = state.modifierIds.indexOf(id);
      if (idx >= 0) state.modifierIds.splice(idx, 1);
      else state.modifierIds.push(id);
      render();
    });
  });

  // Scroll reveal observer (si no está global)
  const reveals = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    reveals.forEach((r) => io.observe(r));
  } else {
    reveals.forEach((r) => r.classList.add('is-visible'));
  }

  render();
</script>