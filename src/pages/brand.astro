---
import Base from "../layouts/Base.astro";
import Brand from "../components/Brand.astro";
import { getT, getLocale, localeUrl } from "~/i18n";

const t = getT(Astro);
const locale = getLocale(Astro);
---

<Base title={t('pages.brand.title')} description={t('pages.brand.description')}>
  <main class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <header class="mb-12">
        <span class="lava-tag mb-3">{t('pages.brand.tag')}</span>
        <h1 class="font-display text-4xl lg:text-5xl font-bold tracking-tight">
          {t('pages.brand.heading')} <span class="text-lava">NX-Studio</span>
        </h1>
        <p class="mt-4 text-nx-muted text-lg max-w-2xl">
          {t('pages.brand.sub')}
        </p>
      </header>

      <!-- Variante 1: WORDMARK (para Nav) -->
      <section class="mb-16">
        <div class="font-mono text-xs uppercase tracking-widest text-nx-dim mb-3">{t('pages.brand.v1.tag')}</div>
        <div class="lava-card p-8 flex items-center gap-8">
          <Brand variant="wordmark" size="lg" />
          <Brand variant="wordmark" size="md" />
          <Brand variant="wordmark" size="sm" />
        </div>
        <p class="mt-3 text-xs text-nx-dim">
          {t('pages.brand.v1.note')}
        </p>
      </section>

      <!-- Variante 2: LOCKUP (para hero, footer, OG cards) -->
      <section class="mb-16">
        <div class="font-mono text-xs uppercase tracking-widest text-nx-dim mb-3">{t('pages.brand.v2.tag')}</div>
        <div class="lava-card p-8 flex items-center gap-8">
          <Brand variant="lockup" size="lg" />
          <Brand variant="lockup" size="md" />
        </div>
        <p class="mt-3 text-xs text-nx-dim">
          {t('pages.brand.v2.note')}
        </p>
      </section>

      <!-- Variante 3: MARK (para favicon, badges) -->
      <section class="mb-16">
        <div class="font-mono text-xs uppercase tracking-widest text-nx-dim mb-3">{t('pages.brand.v3.tag')}</div>
        <div class="lava-card p-8 flex items-center gap-8">
          <Brand variant="mark" size="xl" />
          <Brand variant="mark" size="lg" />
          <Brand variant="mark" size="md" />
          <Brand variant="mark" size="sm" />
        </div>
        <p class="mt-3 text-xs text-nx-dim">
          {t('pages.brand.v3.note')}
        </p>
      </section>

      <!-- Sobre fondo oscuro (cómo se ve en producción) -->
      <section class="mb-16">
        <div class="font-mono text-xs uppercase tracking-widest text-nx-dim mb-3">{t('pages.brand.context.tag')}</div>
        <div class="lava-card p-6">
          <div class="border-b border-nx-border bg-nx-bg" style="position:relative;">
            <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
              <Brand variant="wordmark" size="md" />
              <ul class="hidden items-center gap-1 md:flex">
                <li><span class="nav-link">{t('nav.inicio')}</span></li>
                <li><span class="nav-link">{t('nav.servicios')}</span></li>
                <li><span class="nav-link">{t('nav.templates')}</span></li>
              </ul>
              <span class="lava-btn" style="padding: 0.5rem 1.25rem;">{t('nav.cta')}</span>
            </nav>
          </div>
          <div class="px-6 py-12 text-center text-nx-muted">
            <p class="font-mono text-xs">{t('pages.brand.context.placeholder')}</p>
          </div>
        </div>
      </section>

      <!-- Specs técnicas -->
      <section class="lava-card lava-card-accent p-6 lg:p-8">
        <h2 class="font-display text-2xl font-bold mb-4">{t('pages.brand.specs.title')}</h2>
        <ul class="font-mono text-sm text-nx-muted space-y-2">
          <li>· {t('pages.brand.specs.render')}</li>
          <li>· {t('pages.brand.specs.sizes')}</li>
          <li>· {t('pages.brand.specs.palette')} <span style="color:#ff6a00">#ff6a00</span> → <span style="color:#ff4500">#ff4500</span> → <span style="color:#8b0000">#8b0000</span></li>
          <li>· {t('pages.brand.specs.typography')}</li>
          <li>· {t('pages.brand.specs.a11y')}</li>
          <li>· {t('pages.brand.specs.anim')}</li>
          <li>· {t('pages.brand.specs.js')}</li>
        </ul>
      </section>

      <div class="mt-8 text-center">
        <a href={localeUrl('/', locale)} class="font-mono text-xs text-nx-dim hover:text-lava-edge transition">
          {t('pages.brand.back')}
        </a>
      </div>
    </div>
  </main>
</Base>
