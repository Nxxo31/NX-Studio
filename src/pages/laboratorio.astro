---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getT, getLocale, localeUrl } from "~/i18n";

const t = getT(Astro);
const locale = getLocale(Astro);

const i18nLab = {
  questions: [0, 1, 2, 3, 4].map((i) => t(`pages.laboratorio.chat.questions.${i}`)),
  greeting: t('pages.laboratorio.chat.greeting'),
  greetingAgain: t('pages.laboratorio.chat.greetingAgain'),
  waiting: t('pages.laboratorio.mockup.waiting'),
  placeholderA: t('pages.laboratorio.mockup.placeholderA'),
  placeholderB: t('pages.laboratorio.mockup.placeholderB'),
  specTitle: t('pages.laboratorio.spec.title'),
  specProject: t('pages.laboratorio.spec.project'),
  specUser: t('pages.laboratorio.spec.user'),
  specProblem: t('pages.laboratorio.spec.problem'),
  specPlatform: t('pages.laboratorio.spec.platform'),
  specFeel: t('pages.laboratorio.spec.feel'),
  specRefs: t('pages.laboratorio.spec.refs'),
  specCopy: t('pages.laboratorio.spec.copy'),
  regenerating: t('pages.laboratorio.mockup.regenerating'),
  regen: t('pages.laboratorio.mockup.regenerate'),
  noSpec: t('pages.laboratorio.spec.empty'),
  poweredBy: t('pages.laboratorio.poweredBy'),
  types: {
    dashboard: t('pages.laboratorio.types.dashboard'),
    landing: t('pages.laboratorio.types.landing'),
    mobile: t('pages.laboratorio.types.mobile'),
    ecommerce: t('pages.laboratorio.types.ecommerce'),
    tool: t('pages.laboratorio.types.tool'),
  },
};
---

<Base title={t('pages.laboratorio.title')} description={t('pages.laboratorio.description')}>
  <Nav />

  <main class="px-6 py-16">
    <div class="mx-auto max-w-7xl">
      <header class="text-center">
        <span class="lava-tag">{t('pages.laboratorio.tag')}</span>
        <h1 class="mt-3 font-display text-4xl font-bold md:text-5xl">
          {t('pages.laboratorio.heading')}
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-nx-muted">
          {t('pages.laboratorio.sub')}
        </p>
      </header>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <!-- Chat panel -->
        <section class="lava-card p-6" aria-labelledby="lab-chat-title">
          <div class="flex items-center justify-between border-b border-nx-border pb-4">
            <div>
              <h2 id="lab-chat-title" class="font-display text-lg font-bold">{t('pages.laboratorio.chat.title')}</h2>
              <p class="font-mono text-xs text-nx-dim">{t('pages.laboratorio.chat.sub')}</p>
            </div>
            <button id="reset-btn" type="button" class="border-2 border-nx-border-strong bg-nx-surface px-3 py-1 font-mono text-xs font-bold uppercase hover:bg-nx-primary hover:text-nx-text-on-primary">
              {t('pages.laboratorio.chat.reset')}
            </button>
          </div>

          <div id="chat-log" class="mt-4 h-[420px] overflow-y-auto space-y-3 pr-2">
            <div class="flex gap-3">
              <div class="grid h-8 w-8 shrink-0 place-items-center border-2 border-nx-border-strong bg-nx-primary font-mono text-xs font-bold text-nx-text-on-primary">NX</div>
              <div class="border-2 border-nx-border-strong bg-nx-bg p-3 text-sm max-w-[85%]">
                {i18nLab.greeting}
              </div>
            </div>
          </div>

          <form id="chat-form" class="mt-4 flex gap-2">
            <input
              id="chat-input"
              type="text"
              placeholder={t('pages.laboratorio.chat.inputPh')}
              autocomplete="off"
              class="flex-1 border-2 border-nx-border-strong bg-nx-bg px-4 py-3 text-sm font-mono outline-none focus:border-nx-primary"
            />
            <button
              type="submit"
              class="lava-btn"
            >
              {t('common.enviar')}
            </button>
          </form>
        </section>

        <!-- Mockup panel -->
        <section class="lava-card p-6" aria-labelledby="lab-mockup-title">
          <div class="flex items-center justify-between border-b border-nx-border pb-4">
            <div>
              <h2 id="lab-mockup-title" class="font-display text-lg font-bold">{t('pages.laboratorio.mockup.title')}</h2>
              <p class="font-mono text-xs text-nx-dim">{t('pages.laboratorio.mockup.sub')}</p>
            </div>
            <button id="regenerate" type="button" class="hidden border-2 border-nx-border-strong bg-nx-surface px-3 py-1 font-mono text-xs font-bold uppercase hover:bg-nx-primary hover:text-nx-text-on-primary">
              {i18nLab.regen}
            </button>
          </div>

          <div id="mockup-area" class="mt-4 aspect-square w-full border-2 border-dashed border-nx-border bg-nx-bg grid place-items-center">
            <div class="text-center text-nx-dim p-6">
              <div class="text-5xl font-display">◇</div>
              <p class="mt-3 font-mono text-xs uppercase tracking-widest">{i18nLab.placeholderA}</p>
              <p class="mt-1 font-mono text-xs">{i18nLab.placeholderB}</p>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between font-mono text-xs text-nx-dim">
            <span id="mockup-status">{i18nLab.waiting}</span>
            <span>{i18nLab.poweredBy}</span>
          </div>

          <!-- Spec output -->
          <div id="spec-area" class="mt-4 hidden border-t border-nx-border pt-4">
            <div class="flex items-center justify-between">
              <h3 class="font-mono text-xs font-bold uppercase tracking-widest text-nx-text">{i18nLab.specTitle}</h3>
              <button id="spec-copy" type="button" class="border-2 border-nx-border-strong bg-nx-surface px-2 py-1 font-mono text-[10px] font-bold uppercase hover:bg-nx-primary hover:text-nx-text-on-primary">{i18nLab.specCopy}</button>
            </div>
            <pre id="spec-output" class="mt-2 max-h-48 overflow-y-auto border-2 border-nx-border-strong bg-nx-surface p-3 font-mono text-[11px] leading-relaxed text-nx-text whitespace-pre-wrap"></pre>
          </div>
        </section>
      </div>

      <!-- Disclaimer -->
      <p class="mx-auto mt-8 max-w-2xl text-center font-mono text-xs text-nx-dim">
        {t('pages.laboratorio.disclaimer')}
      </p>

      <!-- CTA -->
      <section class="mt-16 lava-card lava-card-accent p-12 text-center">
        <h2 class="font-display text-3xl font-bold md:text-4xl">{t('pages.laboratorio.cta.title')}</h2>
        <p class="mx-auto mt-3 max-w-xl text-nx-muted">
          {t('pages.laboratorio.cta.desc')}
        </p>
        <a
          href={localeUrl('/contacto', locale)}
          class="mt-6 inline-flex"
        >
          <span class="lava-btn">{t('pages.laboratorio.cta.button')}</span>
        </a>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<script define:vars={{ i18nLab }} is:inline>
  window.__labI18n = i18nLab;
</script>

<script>
  import { renderMockup, buildSpec } from '~/lib/mockup';

  const LAB = (window as any).__labI18n as {
    questions: string[];
    greeting: string;
    greetingAgain: string;
    waiting: string;
    placeholderA: string;
    placeholderB: string;
    specTitle: string;
    specProject: string;
    specUser: string;
    specProblem: string;
    specPlatform: string;
    specFeel: string;
    specRefs: string;
    specCopy: string;
    regenerating: string;
    regen: string;
    noSpec: string;
    poweredBy: string;
    types: Record<string, string>;
  };

  type Msg = { role: 'user' | 'bot'; text: string };
  const state: { messages: Msg[]; turn: number; variation: number } = {
    messages: [],
    turn: 0,
    variation: 0,
  };

  const questions = LAB.questions;

  const log = document.getElementById('chat-log') as HTMLDivElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const mockupArea = document.getElementById('mockup-area') as HTMLDivElement;
  const regenBtn = document.getElementById('regenerate') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('mockup-status') as HTMLSpanElement;
  const specArea = document.getElementById('spec-area') as HTMLDivElement;
  const specOut = document.getElementById('spec-output') as HTMLPreElement;
  const specCopy = document.getElementById('spec-copy') as HTMLButtonElement;

  function addMsg(role: 'user' | 'bot', text: string) {
    const wrap = document.createElement('div');
    wrap.className = role === 'user' ? 'flex gap-3 justify-end' : 'flex gap-3';

    if (role === 'bot') {
      const avatar = document.createElement('div');
      avatar.className = 'grid h-8 w-8 shrink-0 place-items-center border-2 border-nx-border-strong bg-nx-primary font-mono text-xs font-bold text-nx-text-on-primary';
      avatar.textContent = 'NX';
      wrap.appendChild(avatar);
    }

    const bubble = document.createElement('div');
    bubble.className = role === 'user'
      ? 'border-2 border-nx-border-strong bg-nx-primary p-3 text-sm font-mono max-w-[85%] text-nx-text-on-primary'
      : 'border-2 border-nx-border-strong bg-nx-bg p-3 text-sm max-w-[85%]';
    bubble.textContent = text;
    wrap.appendChild(bubble);
    log.appendChild(wrap);
    log.scrollTop = log.scrollHeight;
    state.messages.push({ role, text });
  }

  function setStatus(text: string) {
    statusEl.textContent = text;
  }

  function renderMockupInto() {
    const userAnswers = state.messages
      .filter((m) => m.role === 'user')
      .map((m) => m.text);
    const pairs = questions.map((_, i) => ({ q: questions[i], a: userAnswers[i] ?? '' }));
    const spec = buildSpec(pairs, state.variation);
    mockupArea.innerHTML = renderMockup(spec);
    mockupArea.classList.remove('border-dashed');
    mockupArea.classList.add('border-solid');
    setStatus(`✓ ${LAB.types[spec.type]} · v${state.variation + 1}`);
    regenBtn.classList.remove('hidden');
    renderSpec(pairs, spec);
  }

  function renderSpec(pairs: { q: string; a: string }[], spec: ReturnType<typeof buildSpec>) {
    const lines: string[] = [
      `// ${LAB.specTitle}`,
      ``,
      `> ${LAB.specProject}: ${spec.name || '—'}`,
      `> ${LAB.specUser}: ${spec.user || '—'}`,
      `> ${LAB.specProblem}: ${spec.problem || '—'}`,
      `> ${LAB.specPlatform}: ${spec.platform}`,
      `> ${LAB.specFeel}: ${spec.feel}`,
      `> ${LAB.specRefs}: ${spec.refs || '—'}`,
      `> TYPE: ${LAB.types[spec.type] || spec.type}`,
      `> VARIATION: v${state.variation + 1}`,
    ];
    specOut.textContent = lines.join('\n');
    specArea.classList.remove('hidden');
  }

  function generate() {
    if (state.messages.filter((m) => m.role === 'user').length < questions.length) return;
    setStatus(LAB.regenerating);
    requestAnimationFrame(() => {
      try {
        renderMockupInto();
      } catch (e) {
        setStatus('✗ ' + String(e));
      }
    });
  }

  function botRespond() {
    if (state.turn < questions.length) {
      const idx = state.turn;
      setTimeout(() => addMsg('bot', questions[idx]), 400);
      state.turn++;
      if (state.turn === questions.length) {
        setTimeout(generate, 700);
      }
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    addMsg('user', text);
    input.value = '';
    botRespond();
  });

  regenBtn.addEventListener('click', () => {
    state.variation++;
    generate();
  });

  resetBtn.addEventListener('click', () => {
    state.messages = [];
    state.turn = 0;
    state.variation = 0;
    log.innerHTML = '';
    mockupArea.innerHTML = `
      <div class="text-center text-nx-dim p-6">
        <div class="text-5xl font-display">◇</div>
        <p class="mt-3 font-mono text-xs uppercase tracking-widest">${LAB.placeholderA}</p>
        <p class="mt-1 font-mono text-xs">${LAB.placeholderB}</p>
      </div>
    `;
    mockupArea.classList.add('border-dashed');
    mockupArea.classList.remove('border-solid');
    specArea.classList.add('hidden');
    setStatus(LAB.waiting);
    regenBtn.classList.add('hidden');
    addMsg('bot', LAB.greetingAgain);
  });

  specCopy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(specOut.textContent ?? '');
      const original = specCopy.textContent;
      specCopy.textContent = '✓ ' + LAB.specCopy;
      setTimeout(() => { specCopy.textContent = original; }, 1400);
    } catch {
      // fallback: select
      const range = document.createRange();
      range.selectNodeContents(specOut);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    }
  });
</script>

<!-- Pricing engine preview -->
<section class="mx-auto mt-16 max-w-5xl px-6">
  <div class="lava-card lava-card-accent p-8 text-center">
    <span class="lava-tag mb-3 mx-auto">// pricing-engine · live preview</span>
    <h2 class="font-display text-3xl font-bold mb-3">
      {t('pages.laboratorio.pricingCta.title')}
    </h2>
    <p class="text-nx-muted mb-6 max-w-xl mx-auto">
      {t('pages.laboratorio.pricingCta.descA')}
      <b class="text-nx-text">{t('pages.laboratorio.pricingCta.descEm')}</b>
      {t('pages.laboratorio.pricingCta.descB')}
    </p>
    <a href={localeUrl('/cotizador', locale)} class="lava-btn">{t('pages.laboratorio.pricingCta.button')}</a>
  </div>
</section>
