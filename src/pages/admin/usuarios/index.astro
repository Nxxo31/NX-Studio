---
// /admin/usuarios — admin-only (B8 · T09).

import Base from '~/layouts/Base.astro';
import Table from '~/components/ui/Table.astro';
import { env as runtimeEnv } from 'cloudflare:workers';
import { createDb } from '~/db';
import { user } from '~/db/schema';
import { desc } from 'drizzle-orm';

export const prerender = false;

const env = runtimeEnv as unknown as { DB: D1Database };
const db = createDb(env.DB);

let users = [];
try {
  users = await db.select().from(user).orderBy(desc(user.createdAt)).all();
} catch (e) {
  users = [];
}

const ROLES = ['admin', 'gatekeeper', 'designer', 'dev', 'cliente'] as const;
---
<Base title="Usuarios — Admin NX-Studio" description="Gestión de usuarios (admin-only).">
  <main class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--nx-primary);">Operador · admin-only</p>
        <h1 class="mt-2 font-display text-3xl font-bold">Usuarios</h1>
        <p class="mt-1 text-sm text-nx-muted">{users.length} cuentas registradas</p>
      </div>
      <nav class="flex flex-wrap gap-2 text-xs font-mono">
        <a href="/admin" class="admin-nav-link">Dashboard</a>
      </nav>
    </div>

    <div class="mt-8" data-usuarios-table>
      {users.length === 0 ? (
        <Table empty="Sin usuarios registrados">
          <span slot="head" data-empty-message>Sin usuarios registrados</span>
        </Table>
      ) : (
        <Table>
          <tr slot="head">
            <th>Email</th>
            <th>Nombre</th>
            <th>Rol</th>
            <th>Empresa</th>
            <th>País</th>
            <th>Creado</th>
            <th>Acciones</th>
          </tr>
          {users.map((u) => (
            <tr data-usuario-row data-id={u.id}>
              <td>{u.email}</td>
              <td>{u.name}</td>
              <td>
                <form method="POST" action={`/api/admin/users/${u.id}`} class="inline-flex gap-1">
                  <input type="hidden" name="action" value="role-change" />
                  <select name="role" class="admin-select" data-role-select>
                    {ROLES.map((r) => (
                      <option value={r} selected={r === u.role}>{r}</option>
                    ))}
                  </select>
                  <button type="submit" class="admin-tag-btn">Guardar</button>
                </form>
              </td>
              <td>{u.empresa ?? '—'}</td>
              <td>{u.pais ?? '—'}</td>
              <td class="font-mono text-xs">{new Date(u.createdAt).toLocaleDateString('es-CO')}</td>
              <td>
                <div class="flex flex-wrap gap-1">
                  <form method="POST" action={`/api/admin/users/${u.id}`} class="inline">
                    <input type="hidden" name="action" value="reset-password" />
                    <button type="submit" class="admin-tag-btn">Reset password</button>
                  </form>
                  <form method="POST" action={`/api/admin/users/${u.id}`} class="inline">
                    <input type="hidden" name="action" value="revoke-sessions" />
                    <button type="submit" class="admin-tag-btn admin-tag-btn-danger">Revocar sesiones</button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </Table>
      )}
    </div>
  </main>
</Base>

<style>
  .admin-nav-link {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-nx-border, rgba(255,255,255,0.12));
    border-radius: 4px;
    color: var(--color-nx-ink, #e7e9ee);
    text-decoration: none;
  }
  .admin-nav-link:hover { border-color: var(--color-nx-primary, #ff6b3d); }
  .admin-select {
    background: transparent;
    color: var(--color-nx-ink, #e7e9ee);
    border: 1px solid var(--color-nx-border, rgba(255,255,255,0.12));
    border-radius: 4px;
    padding: 0.3rem 0.5rem;
    font-size: 0.8rem;
    font-family: ui-monospace, monospace;
  }
  .admin-tag-btn {
    background: rgba(255, 107, 61, 0.12);
    color: var(--color-nx-primary, #ff6b3d);
    border: 1px solid rgba(255, 107, 61, 0.3);
    border-radius: 4px;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    cursor: pointer;
  }
  .admin-tag-btn:hover { background: rgba(255, 107, 61, 0.2); }
  .admin-tag-btn-danger {
    background: rgba(255, 80, 80, 0.12);
    color: #ff8888;
    border-color: rgba(255, 80, 80, 0.3);
  }
  .admin-tag-btn-danger:hover { background: rgba(255, 80, 80, 0.2); }
</style>
