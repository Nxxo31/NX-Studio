---
// /admin — dashboard de métricas (B8 · T05).
//
// 6 métricas en grid desktop / stack mobile:
//   1. Licitaciones del mes (status='nueva' creadas desde start_of_month)
//   2. Conversion rate del mes (aceptadas+completadas / total)
//   3. MRR (suma de precioMax de licitaciones con status='aceptada')
//   4. Deploys/24h (count de deploy_log con created_at > now-24h)
//   5. Errores abiertos (placeholder)
//   6. Gatekeeper health (placeholder)

import Base from '~/layouts/Base.astro';
import Card from '~/components/ui/Card.astro';
import { env as runtimeEnv } from 'cloudflare:workers';
import { createDb } from '~/db';
import { computeDashboardMetrics } from '~/lib/admin-aggregators';

export const prerender = false;

const env = runtimeEnv as unknown as { DB: D1Database };
let metrics;
try {
  metrics = await computeDashboardMetrics(createDb(env.DB));
} catch (e) {
  metrics = {
    licitacionesMes: 0,
    conversionRate: 0,
    mrrUsd: 0,
    deploys24h: 0,
    erroresAbiertos: 0,
    gatekeeperHealth: 'unknown' as const,
    generatedAt: Date.now(),
  };
}

const fmtUsd = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const fmtPct = (n: number) => `${(n * 100).toFixed(1)}%`;
---
<Base title="Dashboard — Admin NX-Studio" description="Panel de métricas operacionales.">
  <main class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--nx-primary);">Operador</p>
        <h1 class="mt-2 font-display text-3xl font-bold">Dashboard</h1>
        <p class="mt-1 text-sm text-nx-muted">Métricas en vivo · generado {new Date(metrics.generatedAt).toLocaleString('es-CO')}</p>
      </div>
      <nav class="flex flex-wrap gap-2 text-xs font-mono">
        <a href="/admin/licitacion" class="admin-nav-link">Licitaciones</a>
        <a href="/admin/proyectos" class="admin-nav-link">Proyectos</a>
        <a href="/admin/templates" class="admin-nav-link">Templates</a>
        <a href="/admin/usuarios" class="admin-nav-link">Usuarios</a>
        <a href="/admin/audit" class="admin-nav-link">Audit</a>
        <a href="/admin/deploys" class="admin-nav-link">Deploys</a>
        <form method="POST" action="/admin/logout" class="inline">
          <button type="submit" class="admin-nav-link admin-nav-logout">Salir</button>
        </form>
      </nav>
    </div>

    <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-dashboard-grid>
      <Card>
        <p class="admin-metric-label">Licitaciones del mes</p>
        <p class="admin-metric-value" data-metric="licitacionesMes">{metrics.licitacionesMes}</p>
        <p class="admin-metric-help">{metrics.licitacionesMes === 0 ? 'Sin licitaciones nuevas este mes' : 'Licitaciones con status=nueva'}</p>
      </Card>

      <Card>
        <p class="admin-metric-label">Conversion rate (mes)</p>
        <p class="admin-metric-value" data-metric="conversionRate">{fmtPct(metrics.conversionRate)}</p>
        <p class="admin-metric-help">Aceptadas + completadas / total del mes</p>
      </Card>

      <Card>
        <p class="admin-metric-label">MRR estimado</p>
        <p class="admin-metric-value" data-metric="mrrUsd">{fmtUsd.format(metrics.mrrUsd)}</p>
        <p class="admin-metric-help">Suma de precioMax en licitaciones aceptadas</p>
      </Card>

      <Card>
        <p class="admin-metric-label">Deploys (24h)</p>
        <p class="admin-metric-value" data-metric="deploys24h">{metrics.deploys24h}</p>
        <p class="admin-metric-help">{metrics.deploys24h === 0 ? 'Sin deploys en las últimas 24h' : 'Deploys recientes'}</p>
      </Card>

      <Card>
        <p class="admin-metric-label">Errores abiertos</p>
        <p class="admin-metric-value" data-metric="erroresAbiertos">{metrics.erroresAbiertos}</p>
        <p class="admin-metric-help">Sin observabilidad configurada aún</p>
      </Card>

      <Card>
        <p class="admin-metric-label">Gatekeeper health</p>
        <p class="admin-metric-value" data-metric="gatekeeperHealth">{metrics.gatekeeperHealth}</p>
        <p class="admin-metric-help">Scheduler externo (Cloudflare cron)</p>
      </Card>
    </section>
  </main>
</Base>

<style>
  .admin-nav-link {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-nx-border, rgba(255,255,255,0.12));
    border-radius: 4px;
    color: var(--color-nx-ink, #e7e9ee);
    text-decoration: none;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }
  .admin-nav-link:hover { border-color: var(--color-nx-primary, #ff6b3d); }
  .admin-nav-logout { color: var(--color-nx-muted, #9aa0ad); }
  .admin-metric-label {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-nx-muted, #9aa0ad);
    margin: 0 0 0.5rem;
  }
  .admin-metric-value {
    font-family: ui-monospace, monospace;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-nx-ink, #e7e9ee);
    margin: 0;
  }
  .admin-metric-help {
    font-size: 0.75rem;
    color: var(--color-nx-muted, #9aa0ad);
    margin: 0.5rem 0 0;
  }
</style>
