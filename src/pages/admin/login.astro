---
// /admin/login — formulario de login para el panel admin.
//
// El POST se delega al catch-all better-auth en /api/auth/sign-in/email.
// El form action usa la ruta relativa '/api/auth/sign-in/email' para
// que el handler de better-auth valide email+password y cree la sesión.
//
// Si el usuario ya tiene sesión activa y rol de equipo, lo mandamos al
// dashboard directamente (UX: evita loops al refrescar /admin/login).

import { env as runtimeEnv } from 'cloudflare:workers';
import { createAuth } from '~/lib/auth';

export const prerender = false;

const env = runtimeEnv as unknown as Parameters<typeof createAuth>[0];

// Si ya está autenticado, redirigir al dashboard
let alreadyAuthed = false;
try {
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session?.user) {
    const role = (session.user as unknown as { role?: string }).role ?? 'cliente';
    if (['admin', 'gatekeeper', 'designer', 'dev'].includes(role)) {
      alreadyAuthed = true;
    }
  }
} catch {
  // ignore — render login
}

if (alreadyAuthed) {
  return Astro.redirect('/admin', 302);
}

const fromPath = Astro.url.searchParams.get('from') ?? '/admin';
const errorParam = Astro.url.searchParams.get('error');
const errorMsg = errorParam === 'invalid' ? 'Email o contraseña inválidos' : null;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Admin NX-Studio</title>
  <meta name="robots" content="noindex,nofollow" />
  <style>
    :root {
      --bg: #0a0b14;
      --panel: #13141d;
      --border: rgba(255, 255, 255, 0.08);
      --text: #e7e9ee;
      --muted: #9aa0ad;
      --accent: #ff6b3d;
    }
    * { box-sizing: border-box; }
    body {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 1rem;
    }
    .card {
      width: 100%;
      max-width: 24rem;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2rem;
    }
    h1 {
      margin: 0 0 0.25rem;
      font-size: 1.5rem;
      font-weight: 700;
    }
    .sub {
      margin: 0 0 1.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }
    label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin: 1rem 0 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-family: ui-monospace, monospace;
    }
    input[type="email"], input[type="password"] {
      width: 100%;
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.6rem 0.75rem;
      font-size: 0.95rem;
      font-family: inherit;
    }
    input:focus {
      outline: none;
      border-color: var(--accent);
    }
    button {
      width: 100%;
      margin-top: 1.5rem;
      background: var(--accent);
      color: #000;
      border: 0;
      border-radius: 4px;
      padding: 0.75rem;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
    }
    button:hover { filter: brightness(1.05); }
    .err {
      background: rgba(255, 80, 80, 0.1);
      border: 1px solid rgba(255, 80, 80, 0.3);
      color: #ff8888;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 1rem;
      font-size: 0.85rem;
    }
    .foot {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.8rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <main class="card" data-admin-login>
    <h1>NX-Studio</h1>
    <p class="sub">Acceso al panel del operador</p>
    {errorMsg && <div class="err" role="alert">{errorMsg}</div>}
    <form method="POST" action="/api/auth/sign-in/email" data-login-form>
      <input type="hidden" name="from" value={fromPath} />
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required minlength="8" />
      <button type="submit">Entrar</button>
    </form>
    <p class="foot"><a href="/" style="color: var(--muted);">← Volver al sitio</a></p>
  </main>
</body>
</html>
