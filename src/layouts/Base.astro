---
import "../styles/global.css";
import { getLocale, getT, localeUrl, LOCALES, DEFAULT_LOCALE } from "../i18n";

interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro);
const t = getT(locale);

const {
  title = t("meta.defaultTitle"),
  description = t("meta.defaultDescription"),
} = Astro.props;

const site = Astro.site ?? "https://nx-studio.nx-studio.workers.dev";
// Canonical sin prefijo de locale para 'es' (prefixDefaultLocale=false).
const barePath = (() => {
  const seg = Astro.url.pathname.split("/")[1];
  return seg === "en" || seg === "pt" || seg === "es"
    ? Astro.url.pathname.slice(seg.length + 1) || "/"
    : Astro.url.pathname;
})();
const canonical = new URL(localeUrl(barePath, locale), site).toString();
// hreflang: una entrada por locale + x-default al default.
const alternates = LOCALES.map((l) => ({
  lang: l,
  href: new URL(localeUrl(barePath, l), site).toString(),
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0e0c" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrl(barePath, DEFAULT_LOCALE), site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NX-Studio" />
    <meta property="og:image" content={new URL('/projects/nx-studio/desktop-home.png', site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <!-- Anti-FOUC: aplicar tema antes del primer paint.
         1) respeta override del usuario en localStorage
         2) si no, respeta prefers-color-scheme (dark/light)
         3) fallback: brutal-dark (dark default) -->
    <script is:inline>
      (function() {
        try {
          var STORAGE_KEY = 'nx-studio-theme';
          var VALID = ['brutal-dark', 'brutal-cream'];
          var stored = localStorage.getItem(STORAGE_KEY);
          var theme;
          if (stored && VALID.indexOf(stored) !== -1) {
            theme = stored;
          } else {
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = prefersDark ? 'brutal-dark' : 'brutal-cream';
          }
          document.documentElement.setAttribute('data-palette', theme);
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-nx-bg text-nx-text antialiased relative">
    <div class="relative z-10">
      <slot />
    </div>

    <script is:inline>
      // Reveal on scroll — global observer (vanilla, ~30 lines, sin dependencias)
      document.addEventListener('DOMContentLoaded', () => {
        const els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => obs.observe(el));
      });
      // NOTA: el switcher de paleta vive ahora en src/components/PaletteSwitcher.astro
      // (topbar del header). El anti-FOUC está en <head> más arriba.
    </script>
  </body>
</html>