---
import "../styles/global.css";
import WebGLBackground from "../components/WebGLBackground.astro";
import BackgroundDecor from "../components/BackgroundDecor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NX-Studio — Software que escala contigo",
  description = "Estudio de desarrollo LATAM. Arquitectura de software a medida, QA as a service, templates comprables. Cotizador interactivo.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://nxxo31.github.io").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0608" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <link rel="icon" type="image/svg+xml" href="/NX-Studio/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NX-Studio" />
    <meta property="og:image" content="https://raw.githubusercontent.com/Nxxo31/NX-Studio/master/public/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <!-- Anti-FOUC: aplicar tema antes del primer paint.
         1) respeta override del usuario en localStorage
         2) si no, respeta prefers-color-scheme (dark/light)
         3) fallback: steel-indigo (dark default) -->
    <script is:inline>
      (function() {
        try {
          var STORAGE_KEY = 'nx-studio-theme';
          var VALID = ['steel-indigo', 'azure-light'];
          var stored = localStorage.getItem(STORAGE_KEY);
          var theme;
          if (stored && VALID.indexOf(stored) !== -1) {
            theme = stored;
          } else {
            var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            theme = prefersDark ? 'steel-indigo' : 'azure-light';
          }
          document.documentElement.setAttribute('data-palette', theme);
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-nx-bg text-nx-text antialiased relative">
    <BackgroundDecor />
    <WebGLBackground />
    <div class="relative z-10">
      <slot />
    </div>

    <script is:inline>
      // Reveal on scroll — global observer (vanilla, ~30 lines, sin dependencias)
      document.addEventListener('DOMContentLoaded', () => {
        const els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => obs.observe(el));
      });
      // NOTA: el switcher de paleta vive ahora en src/components/PaletteSwitcher.astro
      // (topbar del header). El anti-FOUC está en <head> más arriba.
    </script>
  </body>
</html>