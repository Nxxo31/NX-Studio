---
import "../styles/global.css";
import WebGLBackground from "../components/WebGLBackground.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NX-Studio — Software que escala contigo",
  description = "Estudio de desarrollo LATAM. Arquitectura de software a medida, OSINT, QA as a service, templates comprables. Cotizador interactivo.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://nxxo31.github.io").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0608" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <link rel="icon" type="image/svg+xml" href="/NX-Studio/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="NX-Studio" />
    <meta property="og:image" content="https://raw.githubusercontent.com/Nxxo31/NX-Studio/master/public/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-nx-bg text-nx-text antialiased relative">
    <WebGLBackground />
    <div class="relative z-10">
      <slot />
    </div>

    <!-- ============================================================
         Palette switcher flotante (solo visible si ?palettes en URL)
         Activar: /NX-Studio/?palettes → muestra el switcher en todas las páginas
         ============================================================ -->
    <div id="nx-palette-bar" class="hidden fixed bottom-4 left-4 z-50 lava-card lava-card-accent p-3 max-w-xs">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-[10px] uppercase tracking-widest text-nx-dim">// preview paleta:</span>
        <button id="nx-palette-close" class="ml-auto text-nx-dim hover:text-lava-edge text-xs">✕</button>
      </div>
      <div class="flex flex-wrap gap-1">
        <button data-set-palette="lava-pure" class="palette-chip px-2 py-1 rounded font-mono text-[10px] uppercase border border-nx-border hover:border-lava-edge transition">Lava</button>
        <button data-set-palette="steel-indigo" class="palette-chip px-2 py-1 rounded font-mono text-[10px] uppercase border border-nx-border hover:border-lava-edge transition">Indigo</button>
        <button data-set-palette="obsidian-teal" class="palette-chip px-2 py-1 rounded font-mono text-[10px] uppercase border border-nx-border hover:border-lava-edge transition">Teal</button>
        <button data-set-palette="navy-gold" class="palette-chip px-2 py-1 rounded font-mono text-[10px] uppercase border border-nx-border hover:border-lava-edge transition">Navy</button>
      </div>
    </div>

    <script is:inline>
      // Reveal on scroll — global observer (vanilla, ~30 lines, sin dependencias)
      document.addEventListener('DOMContentLoaded', () => {
        const els = document.querySelectorAll('.reveal');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => obs.observe(el));
      });

      // Palette switcher (global, disponible en todas las páginas si ?palettes en URL)
      (function() {
        const STORAGE_KEY = 'nx-studio-palette';
        const bar = document.getElementById('nx-palette-bar');
        const close = document.getElementById('nx-palette-close');
        if (!bar) return;

        // Show only if ?palettes in URL
        const url = new URL(window.location.href);
        if (!url.searchParams.has('palettes')) return;
        bar.classList.remove('hidden');

        function applyPalette(p) {
          document.documentElement.setAttribute('data-palette', p);
          try { localStorage.setItem(STORAGE_KEY, p); } catch(e) {}
          document.querySelectorAll('[data-set-palette]').forEach((btn) => {
            const target = btn.getAttribute('data-set-palette');
            if (target === p) {
              btn.classList.add('border-lava-edge', 'bg-lava-soft', 'text-lava-edge');
              btn.classList.remove('border-nx-border');
            } else {
              btn.classList.remove('border-lava-edge', 'bg-lava-soft', 'text-lava-edge');
              btn.classList.add('border-nx-border');
            }
          });
        }

        // Restore from localStorage
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) applyPalette(stored);
        else applyPalette('steel-indigo');

        // Bind buttons
        document.querySelectorAll('[data-set-palette]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const p = btn.getAttribute('data-set-palette');
            if (p) applyPalette(p);
          });
        });

        // Close
        if (close) {
          close.addEventListener('click', () => {
            bar.classList.add('hidden');
            url.searchParams.delete('palettes');
            window.history.replaceState({}, '', url.toString());
          });
        }
      })();
    </script>
  </body>
</html>