<section class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal max-w-3xl">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ impacto</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">La tecnología con responsabilidad social</h2>
    </div>

    <!-- Stats marquee -->
    <div class="reveal mt-12 overflow-hidden py-6">
      <div class="marquee gap-16">
        {[
          ["12", "comunidades AguaSegura"],
          ["$2M+", "en microcréditos facilitados"],
          ["3000+", "estudiantes EducaRural"],
          ["10%", "capacidad anual dedicada a proyectos pro-bono"],
          ["500+", "emprendedores beneficiados"],
        ].map(([num, label]) => (
          <div class="flex items-baseline gap-3">
            <span class="font-display text-4xl font-bold text-nx-primary">{num}</span>
            <span class="text-sm text-nx-muted">{label}</span>
          </div>
        ))}
        {[
          ["12", "comunidades AguaSegura"],
          ["$2M+", "en microcréditos facilitados"],
          ["3000+", "estudiantes EducaRural"],
          ["10%", "capacidad anual dedicada a proyectos pro-bono"],
          ["500+", "emprendedores beneficiados"],
        ].map(([num, label]) => (
          <div class="flex items-baseline gap-3" aria-hidden="true">
            <span class="font-display text-4xl font-bold text-nx-primary">{num}</span>
            <span class="text-sm text-nx-muted">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
