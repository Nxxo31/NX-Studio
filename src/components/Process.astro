---
const phases = [
  {
    n: "01",
    title: "Descubrimiento técnico",
    duration: "30–45 min · gratis",
    desc: "Análisis de sistemas actuales, mapeo de stakeholders, definición de métricas de éxito. Sin presupuestos, sin compromiso.",
    deliverable: "Documento de Arquitectura de Solución con ROI estimado",
  },
  {
    n: "02",
    title: "Validación riesgo-cero",
    duration: "1–2 semanas",
    desc: "Prototipo interactivo de alta fidelidad, prueba de concepto técnica, validación con usuarios reales, plan de mitigación.",
    deliverable: "Prototipo funcional + Informe de Validación",
  },
  {
    n: "03",
    title: "Desarrollo ágil con calidad incorp.",
    duration: "Sprints de 2 semanas",
    desc: "Arquitectura evolutiva, ≥80% cobertura de tests, CI/CD desde día uno, documentación viva, métricas en tiempo real.",
    deliverable: "Software funcional en staging con baseline de métricas",
  },
  {
    n: "04",
    title: "Lanzamiento + transferencia",
    duration: "1 semana + hypercare",
    desc: "Capacitación por rol, manuales operativos, plan de soporte definido, transferencia completa, 2 semanas de hypercare.",
    deliverable: "Sistema en producción + equipo capacitado",
  },
  {
    n: "05",
    title: "Optimización basada en datos",
    duration: "Continuo",
    desc: "Monitoreo de métricas de negocio, experimentos A/B, actualizaciones de seguridad, roadmap evolutivo.",
    deliverable: "Informes mensuales + plan de mejora continua",
  },
];
---

<section id="modelo" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ modelo de entrega</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Cinco fases, cero sorpresas.</h2>
    </div>

    <div class="mt-16 space-y-0 border-l border-nx-border">
      {phases.map((p, i) => (
        <div class="reveal group relative pb-16 pl-10 last:pb-0">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-nx-primary transition-all group-hover:scale-150"></div>
          <div class="font-mono text-xs text-nx-dim">FASE {p.n}</div>
          <h3 class="mt-2 font-display text-2xl font-semibold">{p.title}</h3>
          <div class="mt-1 text-xs uppercase tracking-wider text-nx-accent">{p.duration}</div>
          <p class="mt-3 max-w-2xl text-nx-muted">{p.desc}</p>
          <div class="mt-4 inline-block rounded-lg border border-nx-border bg-nx-surface px-4 py-2 text-sm">
            <span class="text-nx-dim">Entregable: </span>{p.deliverable}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
