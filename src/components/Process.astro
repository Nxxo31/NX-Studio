---
const phases = [
  { code: 'SHAPING', title: 'Semana 0', desc: 'Investigación + arquitectura + pitch' },
  { code: 'BUILD', title: 'Semana 1–2', desc: 'Construcción + demo semanal' },
  { code: 'INTEGRATE', title: 'Semana 3', desc: 'QA + onboarding + integración' },
  { code: 'SHIP', title: 'Semana 4', desc: 'Deploy + capacitación + docs' },
];
---

<section id="proceso" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ proceso</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Shape Up · 4 semanas</h2>
      <p class="mx-auto mt-4 max-w-2xl text-nx-muted">
        Metodología de Basecamp adaptada. Fixed time, variable scope.
        Demos reales cada viernes, no slides.
      </p>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {phases.map((p, i) => (
        <article class="reveal relative rounded-2xl border border-nx-border bg-nx-surface p-6 transition hover:border-nx-accent/40">
          <div class="font-display text-3xl font-bold text-nx-accent">{String(i + 1).padStart(2, '0')}</div>
          <div class="mt-2 font-mono text-xs text-nx-dim">{p.code}</div>
          <h3 class="mt-3 font-display text-lg font-semibold">{p.title}</h3>
          <p class="mt-2 text-sm text-nx-muted">{p.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/NX-Studio/proceso"
        class="inline-flex items-center gap-2 rounded-full border border-nx-border px-5 py-2 text-sm hover:border-nx-accent transition"
      >
        Ver proceso completo →
      </a>
    </div>
  </div>
</section>