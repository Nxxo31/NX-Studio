---
/**
 * Brand.astro — Sistema de logo de NX-Studio
 * Componente HTML+CSS puro. Tres variantes disponibles via prop `variant`.
 * Vectorial, animable, retina-ready, zero-runtime.
 *
 * Variantes:
 *   - "mark"      → solo el glifo hexagonal (para favicon, badges, mini)
 *   - "wordmark"  → glifo + texto "NX-Studio" en una línea (default para nav)
 *   - "lockup"    → glifo + texto + tagline "Software Studio" (hero/footer)
 */

interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  class?: string;
}

const {
  variant = 'wordmark',
  size = 'md',
  href,
  class: className = '',
} = Astro.props;

// Tamaños en píxeles para el glifo
const sizes = {
  sm: { glyph: 28, text: '0.875rem', tag: '0.625rem', gap: '0.5rem' },
  md: { glyph: 36, text: '1.0625rem', tag: '0.6875rem', gap: '0.625rem' },
  lg: { glyph: 48, text: '1.375rem', tag: '0.75rem', gap: '0.75rem' },
  xl: { glyph: 64, text: '1.75rem', tag: '0.8125rem', gap: '1rem' },
};
const s = sizes[size];

// Glifo NX hexagonal — clip-path del texto "NX" sobre contenedor hexagonal
// Vectorial, escala perfecto a cualquier tamaño
// Los gradientes usan currentColor (definido en CSS por paleta activa).
---

<a
  href={href ?? '/'}
  class={`brand brand--${variant} brand--${size} ${className}`}
  aria-label="NX-Studio — Inicio"
>
  {/* GLIFO HEXAGONAL — letter N y X fusionadas dentro de un hexágono.
      Brutalismo: trazo lava sólido, sin gradientes ni glow. */}
  {variant !== 'mark' || variant === 'mark' ? (
    <span class="brand-glyph" aria-hidden="true">
      <svg
        viewBox="0 0 64 64"
        width={s.glyph}
        height={s.glyph}
        xmlns="http://www.w3.org/2000/svg"
        class="brand-glyph-svg"
      >
        {/* Hexágono exterior */}
        <polygon
          points="32,2 58,17 58,47 32,62 6,47 6,17"
          style="fill: var(--nx-bg); stroke: var(--nx-primary);"
          stroke-width="4"
          stroke-linejoin="miter"
        />

        {/* Monograma NX */}
        <g
          fill="none"
          style="stroke: var(--nx-primary);"
          stroke-width="5"
          stroke-linecap="square"
          stroke-linejoin="miter"
        >
          <path d="M 18 44 L 18 20 L 30 38 L 30 20" />
          <path d="M 34 20 L 46 44 M 46 20 L 34 44" />
        </g>

        {/* Punto de fusión central */}
        <circle cx="32" cy="32" r="2.5" class="brand-dot" />
      </svg>
    </span>
  ) : null}

  {/* TEXTO — wordmark + tagline opcional */}
  {variant !== 'mark' && (
    <span class="brand-text">
      <span class="brand-wordmark" style={`font-size: ${s.text}`}>
        NX<span class="brand-dash">-</span>Studio
      </span>
      {variant === 'lockup' && (
        <span class="brand-tagline" style={`font-size: ${s.tag}`}>
          SOFTWARE STUDIO · LATAM
        </span>
      )}
    </span>
  )}
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--brand-gap, 0.625rem);
    text-decoration: none;
    color: inherit;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .brand--sm { --brand-gap: 0.5rem; }
  .brand--md { --brand-gap: 0.625rem; }
  .brand--lg { --brand-gap: 0.75rem; }
  .brand--xl { --brand-gap: 1rem; }

  /* Glifo */
  .brand-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .brand-glyph-svg { display: block; }
  .brand:hover .brand-glyph {
    transform: rotate(-8deg) scale(1.05);
  }

  /* Color del glifo — lava sólido, definido por la paleta activa */
  .brand-dot { fill: var(--nx-primary); }

  /* Texto */
  .brand-text {
    display: inline-flex;
    flex-direction: column;
    gap: 0.125rem;
    line-height: 1;
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--nx-text);
  }

  .brand:hover .brand-wordmark {
    text-decoration: underline;
    text-decoration-color: var(--nx-primary);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .brand-dash {
    color: var(--nx-primary);
    -webkit-text-fill-color: var(--nx-primary);
  }

  .brand-tagline {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--nx-text-dim);
    text-transform: uppercase;
  }

  /* Variante mark */
  .brand--mark .brand-text {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand:hover .brand-glyph { transform: none; }
    .brand-glyph { transition: none; }
    .brand-wordmark { transition: none; }
  }
</style>
