---
// TechGlossary — términos técnicos explicados en lenguaje de negocio
// Patrón: cada término tiene definición técnica + significado para el cliente
// + ejemplo concreto. Diseñado para que un dueño de empresa entienda sin saber programar.

const glossary = [
  {
    tag: '// arquitectura',
    term: 'API',
    tech: 'Application Programming Interface',
    biz: 'El "menú digital" que conecta tu sistema con otros (pagos, email, mapas, IA)',
    example: 'Cuando tu tienda online se conecta a Stripe para cobrar, eso es una API.',
    icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  },
  {
    tag: '// datos',
    term: 'Database',
    tech: 'PostgreSQL / MongoDB / SQLite',
    biz: 'Donde viven los datos de tu negocio (clientes, pedidos, productos). Elegir bien la DB es como elegir entre Excel, Access o un sistema bancario.',
    example: 'Postgres = sistema bancario. MongoDB = cajones flexibles. SQLite = una caja fuerte pequeña.',
    icon: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4',
  },
  {
    tag: '// auth',
    term: 'Auth + RBAC',
    tech: 'Authentication & Role-Based Access Control',
    biz: 'Quién puede entrar y qué puede hacer. Login con email, Google, o magic links. Roles: admin, editor, viewer.',
    example: 'Tu contador entra y ve solo facturación. Tu vendedor entra y ve solo inventario. Tú entras y ves todo.',
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  },
  {
    tag: '// deploy',
    term: 'CI/CD',
    tech: 'Continuous Integration / Continuous Deployment',
    biz: 'Cada cambio que haces se prueba y se sube automáticamente. Si algo se rompe, te enteras antes que el cliente.',
    example: 'GitHub Actions corre tus tests. Si pasan, el cambio sale a producción. Si no, te avisa.',
    icon: 'M4 4v5h.6M20 20v-5h-.6M4 9a8 8 0 0114.85-3M20 15a8 8 0 01-14.85 3',
  },
  {
    tag: '// ia',
    term: 'IA / LLM',
    tech: 'GPT, Claude, modelos locales',
    biz: 'Sistemas que "entienden" texto y generan respuestas. Útiles para chatbots, análisis de documentos, automatización.',
    example: 'Subes 1000 facturas en PDF. La IA extrae nombre, monto, fecha en 5 minutos en vez de 40 horas.',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  },
  {
    tag: '// frontend',
    term: 'SSR / SPA',
    tech: 'Server-Side Rendering vs Single-Page App',
    biz: 'Cómo se construye tu web. SSR (Next.js) = rápido para Google, ideal para SEO. SPA = más interactivo, apps internas.',
    example: 'Tu landing page = SSR (rápida + Google la indexa). Tu dashboard admin = SPA (más fluida).',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];
---

<section class="relative px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 reveal">
      <div class="lava-tag mb-4">// glosario · tech-for-non-tech</div>
      <h2 class="font-display text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        Hablamos tu <span class="text-lava">idioma</span>,
        <br>construimos con <span class="text-lava">stack</span>.
      </h2>
      <p class="text-nx-muted max-w-2xl text-lg">
        No necesitas aprender a programar para entender qué construimos.
        Estos son los términos que vas a escuchar, explicados como nos gustaría que nos los explicaran a nosotros.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {glossary.map((item) => (
        <article class="lava-card p-6 lg:p-8 reveal">
          <div class="flex items-start gap-4">
            <div class="shrink-0 grid h-10 w-10 place-items-center rounded-md border border-lava" style="border-color: var(--lava-edge); background: var(--lava-glow-soft);">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--lava-edge);">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-2 mb-1 flex-wrap">
                <span class="font-display font-semibold text-xl text-lava">{item.term}</span>
                <span class="font-mono text-xs text-nx-dim">{item.tech}</span>
              </div>
              <p class="text-sm text-nx-text mb-2 leading-relaxed">{item.biz}</p>
              <p class="text-xs text-nx-muted leading-relaxed font-mono">{item.example}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA final del glosario -->
    <div class="reveal mt-10 text-center">
      <p class="text-nx-muted mb-4">
        ¿Más términos confusos? Los desglosamos en la primera llamada.
      </p>
      <a href="/NX-Studio/cotizador" class="font-mono text-sm text-lava-edge hover:text-lava transition">
        Empezar scoping call →
      </a>
    </div>
  </div>
</section>