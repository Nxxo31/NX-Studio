---
const services = [
  {
    n: "01",
    title: "Arquitectura de Software a Medida",
    desc: "Sistemas escalables desde MVP hasta empresa. Microservicios, serverless, modernización de sistemas legacy.",
    tags: ["Node.js", "Python", "AWS", "Kubernetes"],
    color: "from-nx-primary/20 to-transparent",
  },
  {
    n: "02",
    title: "Experiencias Digitales Centradas en el Humano",
    desc: "Apps nativas, PWAs y experiencias web accesibles diseñadas para el contexto latinoamericano.",
    tags: ["React Native", "Flutter", "Next.js", "WCAG 2.1"],
    color: "from-nx-accent/20 to-transparent",
  },
  {
    n: "03",
    title: "Inteligencia Artificial Aplicada",
    desc: "IA donde aporta valor real: NLP para español latino, visión artificial, sistemas de recomendación, RPA.",
    tags: ["PyTorch", "spaCy", "OpenCV", "MLflow"],
    color: "from-nx-amber/20 to-transparent",
  },
  {
    n: "04",
    title: "Sistemas de Gestión para PYMES",
    desc: "ERP ligeros, POS integrados, facturación electrónica local, plataformas de campo.",
    tags: ["PostgreSQL", "Redis", "Electron", "Elasticsearch"],
    color: "from-rose-500/20 to-transparent",
  },
];
---

<section id="servicios" class="px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ servicios</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Cuatro pilares,<br/>un solo estándar.</h2>
    </div>

    <div class="mt-16 space-y-px">
      {services.map((s) => (
        <article class="reveal group relative overflow-hidden border-t border-nx-border py-10 pl-0 transition-colors hover:bg-nx-surface/50 md:pl-6">
          <div class={`pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r ${s.color} opacity-0 transition-opacity duration-500 group-hover:opacity-100`}></div>
          <div class="relative grid gap-6 md:grid-cols-12 md:items-start">
            <div class="font-mono text-sm text-nx-dim md:col-span-1">{s.n}</div>
            <h3 class="font-display text-2xl font-semibold leading-tight md:col-span-5 md:text-3xl">{s.title}</h3>
            <div class="md:col-span-6">
              <p class="text-nx-muted">{s.desc}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {s.tags.map((t) => (
                  <li class="rounded-full border border-nx-border px-3 py-1 font-mono text-xs text-nx-muted">{t}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
