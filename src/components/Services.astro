---
const services = [
  {
    icon: "🎯",
    title: "Desarrollo Web Premium",
    desc: "Sitios optimizados para SEO y conversión, diseñados para reflejar la identidad de tu marca.",
    items: ["Landing pages de alto rendimiento", "Sitios corporativos", "Plataformas personalizadas", "Optimización de velocidad"],
  },
  {
    icon: "📱",
    title: "Apps Móviles & PWA",
    desc: "Aplicaciones nativas y progresivas que llevan tu negocio al bolsillo de tus clientes.",
    items: ["Apps Android nativas", "Progressive Web Apps", "Experiencias móviles", "Integración backend"],
  },
  {
    icon: "⚙️",
    title: "Sistemas de Gestión",
    desc: "Software a medida para automatizar y optimizar las operaciones de tu negocio.",
    items: ["Inventario y ventas", "Paneles administrativos", "Facturación y contabilidad", "Gestión de RRHH"],
  },
  {
    icon: "🤖",
    title: "Automatización & IA",
    desc: "Lleva tu negocio al siguiente nivel con inteligencia artificial aplicada a procesos reales.",
    items: ["Chatbots WhatsApp/Web", "Integración con LLMs", "Automatización de procesos", "Análisis de datos"],
  },
];
---

<section id="servicios" class="border-t border-nx-border px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-3xl font-bold md:text-4xl">Servicios</h2>
    <p class="mt-3 max-w-2xl text-nx-muted">
      Soluciones completas, desde la idea hasta producción. Cada línea de código escrita para durar.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <article class="group rounded-2xl border border-nx-border bg-nx-surface p-8 transition-colors hover:border-nx-primary/50">
          <div class="text-4xl">{s.icon}</div>
          <h3 class="mt-4 text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-nx-muted">{s.desc}</p>
          <ul class="mt-4 space-y-1.5 text-sm text-nx-muted">
            {s.items.map((it) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 text-nx-accent">▸</span>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
