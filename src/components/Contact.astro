---
---

<section id="contacto" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-4xl">
    <div class="relative overflow-hidden rounded-3xl border border-nx-border bg-gradient-to-br from-nx-surface via-nx-surface to-nx-primary/10 p-12 md:p-16">
      <!-- Decorative -->
      <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-nx-primary/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-nx-accent/15 blur-3xl"></div>

      <div class="relative">
        <p class="reveal font-mono text-sm uppercase tracking-widest text-nx-accent">/ próximo paso</p>
        <h2 class="reveal mt-3 font-display text-4xl font-bold leading-tight md:text-5xl">
          Agenda tu llamada<br/>de descubrimiento.
        </h2>
        <p class="reveal mt-4 text-nx-muted">
          30–45 minutos · Sin compromiso · Arquitectura de solución + ROI estimado incluido.
        </p>

        <form class="reveal mt-10 grid gap-4 sm:grid-cols-2" action="mailto:hello@nxstudio.dev" method="post" enctype="text/plain">
          <input
            type="text"
            name="nombre"
            placeholder="Tu nombre"
            required
            autocomplete="name"
            class="rounded-lg border border-nx-border bg-nx-bg/50 px-4 py-3 outline-none transition-colors placeholder:text-nx-dim focus:border-nx-primary"
          />
          <input
            type="email"
            name="email"
            placeholder="tu@email.com"
            required
            autocomplete="email"
            class="rounded-lg border border-nx-border bg-nx-bg/50 px-4 py-3 outline-none transition-colors placeholder:text-nx-dim focus:border-nx-primary"
          />
          <textarea
            name="mensaje"
            placeholder="Cuéntanos del proyecto..."
            required
            rows="3"
            class="sm:col-span-2 rounded-lg border border-nx-border bg-nx-bg/50 px-4 py-3 outline-none transition-colors placeholder:text-nx-dim focus:border-nx-primary"
          ></textarea>
          <button
            type="submit"
            class="sm:col-span-2 inline-flex items-center justify-center gap-2 rounded-full bg-nx-primary px-8 py-4 font-semibold text-white transition-all hover:bg-nx-primary-soft hover:shadow-lg hover:shadow-nx-primary/30"
          >
            Enviar mensaje →
          </button>
        </form>

        <div class="reveal mt-8 flex flex-wrap items-center gap-6 text-sm text-nx-muted">
          <span class="inline-flex items-center gap-2">
            <span class="font-mono">✉</span> hello@nxstudio.dev
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="font-mono">✆</span> +57 300 123 4567
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="font-mono">◉</span> Neiva, Colombia (servicio remoto LATAM)
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
