---
---

<section id="contacto" class="border-t border-nx-border px-6 py-24">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-display text-3xl font-bold md:text-4xl">¿Listo para transformar tu idea?</h2>
    <p class="mt-4 text-nx-muted">
      Primera consulta gratuita · Prototipo interactivo incluido · Precios transparentes
    </p>
    <form
      class="mx-auto mt-10 grid max-w-xl gap-4 text-left"
      action="mailto:hello@nxstudio.dev"
      method="post"
      enctype="text/plain"
    >
      <input
        type="text"
        name="nombre"
        placeholder="Tu nombre"
        required
        class="rounded-lg border border-nx-border bg-nx-surface px-4 py-3 text-sm outline-none focus:border-nx-primary"
      />
      <input
        type="email"
        name="email"
        placeholder="tu@email.com"
        required
        class="rounded-lg border border-nx-border bg-nx-surface px-4 py-3 text-sm outline-none focus:border-nx-primary"
      />
      <textarea
        name="mensaje"
        placeholder="Cuéntanos sobre tu proyecto..."
        required
        rows="4"
        class="rounded-lg border border-nx-border bg-nx-surface px-4 py-3 text-sm outline-none focus:border-nx-primary"
      ></textarea>
      <button
        type="submit"
        class="rounded-full bg-nx-primary px-8 py-3 font-semibold text-white transition-colors hover:bg-nx-primary-dim"
      >
        Enviar mensaje
      </button>
    </form>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm text-nx-muted">
      <span>📧 hello@nxstudio.dev</span>
      <span>💬 WhatsApp: +57 300 123 4567</span>
    </div>
  </div>
</section>
