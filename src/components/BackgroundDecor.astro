---
/**
 * BackgroundDecor · luces/glows de colores en el fondo (light mode only).
 *
 * Capa fija de luces decorativas grandes que dan personalidad al fondo
 * del light mode y crean contraste de colores con el bg blanco.
 *
 * Variantes:
 *   - 'aurora' (default): 6 blobs circulares grandes en colores vibrantes
 *     (sky blue, indigo, cyan, purple, blue, fuchsia). Look "aurora".
 *   - 'beams': 3 rayos direccionales con rotación. Look "stage lights".
 *   - 'mesh': mesh gradient de 5 puntos. Look "soft mesh".
 *
 * Solo activo en light mode (azure-light). En dark se oculta via
 * MutationObserver sobre data-palette.
 *
 * Props:
 *   intensity: 'subtle' | 'normal' | 'strong' (default 'normal')
 *   variant: 'aurora' (default) | 'beams' | 'mesh'
 */

interface Props {
  intensity?: 'subtle' | 'normal' | 'strong';
  variant?: 'aurora' | 'beams' | 'mesh';
}
const {
  intensity = 'normal',
  variant = 'aurora',
} = Astro.props;

const intensityOpacity: Record<string, number> = {
  subtle: 0.5,
  normal: 0.85,
  strong: 1.2,
};
const opMul = intensityOpacity[intensity] ?? intensityOpacity.normal;

const lights = [
  // Top-left: azul cielo (anchor principal)
  {
    pos: 'top: -10%; left: -8%',
    size: '50vw 55vw',
    color: 'rgba(56, 189, 248, 0.55)',   // sky-400 azul claro brillante
    blur: '70px',
  },
  // Top-right: cyan teal (fresco)
  {
    pos: 'top: 5%; right: -5%',
    size: '35vw 40vw',
    color: 'rgba(20, 184, 166, 0.50)',   // teal-500
    blur: '60px',
  },
  // Top-center: rosa fuchsia (cálido contraste)
  {
    pos: 'top: -5%; left: 40%',
    size: '30vw 30vw',
    color: 'rgba(244, 114, 182, 0.45)',  // pink-400
    blur: '80px',
  },
  // Mid-left: violeta (transición)
  {
    pos: 'top: 35%; left: 20%',
    size: '35vw 35vw',
    color: 'rgba(168, 85, 247, 0.45)',   // purple-500
    blur: '90px',
  },
  // Mid-right: amarillo dorado (acento cálido)
  {
    pos: 'top: 30%; right: 15%',
    size: '28vw 28vw',
    color: 'rgba(250, 204, 21, 0.40)',   // yellow-400
    blur: '70px',
  },
  // Bottom-left: verde esmeralda (vida)
  {
    pos: 'bottom: 20%; left: 5%',
    size: '32vw 32vw',
    color: 'rgba(16, 185, 129, 0.45)',   // emerald-500
    blur: '85px',
  },
  // Bottom-right: indigo profundo (peso visual)
  {
    pos: 'bottom: -15%; right: 5%',
    size: '55vw 55vw',
    color: 'rgba(79, 70, 229, 0.55)',    // indigo-600
    blur: '80px',
  },
  // Bottom-center: naranja coral (acento cálido)
  {
    pos: 'bottom: 5%; left: 35%',
    size: '28vw 28vw',
    color: 'rgba(251, 146, 60, 0.40)',   // orange-400
    blur: '75px',
  },
  // Right-mid: magenta (cálido brillante)
  {
    pos: 'top: 55%; left: 55%',
    size: '30vw 30vw',
    color: 'rgba(217, 70, 239, 0.40)',   // fuchsia-500
    blur: '85px',
  },
];

const beams = [
  {
    pos: 'top: -20%; left: -10%',
    size: '70vw 70vw',
    color: 'rgba(56, 189, 248, 0.50)',   // sky-400
    transform: 'rotate(15deg)',
    blur: '60px',
  },
  {
    pos: 'top: 30%; right: -20%',
    size: '60vw 60vw',
    color: 'rgba(244, 114, 182, 0.40)',  // pink-400
    transform: 'rotate(-25deg)',
    blur: '80px',
  },
  {
    pos: 'bottom: -25%; left: 20%',
    size: '80vw 60vw',
    color: 'rgba(16, 185, 129, 0.45)',   // emerald-500
    transform: 'rotate(10deg)',
    blur: '90px',
  },
];
---

<div
  id="nx-bg-decor"
  aria-hidden="true"
  data-intensity={intensity}
  class="fixed inset-0 z-0 pointer-events-none overflow-hidden"
  style={`opacity:${opMul}; transform: translateZ(0); will-change: opacity;`}
>
  {variant === 'aurora' && lights.map((l) => (
    <div
      class="absolute"
      style={`${l.pos}; width:${l.size.split(' ')[0]}; height:${l.size.split(' ')[1]}; background: radial-gradient(circle, ${l.color} 0%, transparent 60%); filter: blur(${l.blur}); transform: translateZ(0); will-change: opacity;`}
    ></div>
  ))}

  {variant === 'beams' && beams.map((b) => (
    <div
      class="absolute"
      style={`${b.pos}; width:${b.size.split(' ')[0]}; height:${b.size.split(' ')[1]}; background: radial-gradient(ellipse at center, ${b.color} 0%, transparent 70%); filter: blur(${b.blur}); transform: ${b.transform}; will-change: opacity;`}
    ></div>
  ))}

  {variant === 'mesh' && (
    <div
      class="absolute inset-0"
      style={`background:
        radial-gradient(at 15% 20%, rgba(56, 189, 248, 0.45) 0%, transparent 45%),
        radial-gradient(at 85% 10%, rgba(244, 114, 182, 0.40) 0%, transparent 45%),
        radial-gradient(at 75% 80%, rgba(16, 185, 129, 0.40) 0%, transparent 45%),
        radial-gradient(at 20% 85%, rgba(79, 70, 229, 0.45) 0%, transparent 45%),
        radial-gradient(at 50% 50%, rgba(250, 204, 21, 0.30) 0%, transparent 50%);
        transform: translateZ(0); will-change: opacity;`}
    ></div>
  )}
</div>

<script>
  // En dark mode ocultamos las luces (hacen ruido sobre navy bg).
  // Usamos visibility:hidden en vez de display:none para no triggear
  // reflow de los 9 elementos hijos (más rápido al cambiar de tema).
  document.addEventListener('DOMContentLoaded', () => {
    const decor = document.getElementById('nx-bg-decor');
    if (!decor) return;
    const apply = () => {
      const palette = document.documentElement.getAttribute('data-palette');
      // visibility preserva el layer GPU; opacity:0 lo apaga sin repintar
      if (palette === 'azure-light') {
        decor.style.visibility = 'visible';
        decor.style.opacity = String({ subtle: 0.5, normal: 0.85, strong: 1.2 }[decor.dataset.intensity] ?? 0.5);
      } else {
        decor.style.opacity = '0';
        decor.style.visibility = 'hidden';
      }
    };
    apply();
    new MutationObserver(apply).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-palette'],
    });
  });
</script>