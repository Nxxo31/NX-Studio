---
import Brand from './Brand.astro';
import PaletteSwitcher from './PaletteSwitcher.astro';
import { getLocale, getT, localeUrl } from '../i18n';

const locale = getLocale(Astro);
const t = getT(locale);

// Path actual sin prefijo de locale para comparativas de "activo".
const rawPath = Astro.url.pathname;
const seg = rawPath.split('/')[1];
const path = (seg === 'en' || seg === 'pt' || seg === 'es') ? rawPath.slice(seg.length + 1) || '/' : rawPath;
const base = '';
const isActive = (href: string) => {
  // href ya viene con prefijo de locale; comparamos contra el path "lógico".
  const logicalHref = href.replace(new RegExp(`^${base}/(en|pt|es)`), base);
  if (logicalHref === '/') {
    return path === '/';
  }
  return path.startsWith(logicalHref) || rawPath.startsWith(href);
};

const links = [
  { href: localeUrl('/',           locale), label: t('nav.inicio') },
  { href: localeUrl('/servicios/', locale), label: t('nav.servicios') },
  { href: localeUrl('/productos/', locale), label: t('nav.productos') },
  { href: localeUrl('/cotizador',  locale), label: t('nav.cotizador') },
  { href: localeUrl('/templates',  locale), label: t('nav.templates') },
  { href: localeUrl('/laboratorio',locale), label: t('nav.laboratorio') },
  { href: localeUrl('/contacto',   locale), label: t('nav.contacto') },
];
---

<header class="sticky top-0 z-50 border-b border-nx-border bg-nx-surface-overlay backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <Brand variant="lockup" size="md" href={`${base}/`} />

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class={`nav-link ${isActive(l.href) ? 'nav-active' : ''}`}>{l.label}</a>
        </li>
      ))}
      <li class="ml-2"><PaletteSwitcher /></li>
    </ul>

    <a href={localeUrl('/contacto', locale)} class="hidden md:inline-flex items-center gap-2 lava-btn" style="padding: 0.5rem 1.25rem;">
      {t('nav.cta')}
    </a>

    <button id="mobile-toggle" class="md:hidden border-2 border-nx-border-strong bg-nx-surface p-2" aria-label={t('nav.menu')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-nx-border md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {links.map((l) => (
        <li><a href={l.href} class="nav-link block">{l.label}</a></li>
      ))}
    </ul>
    <div class="px-6 pb-4">
      <PaletteSwitcher variant="mobile" />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>