---
import Brand from './Brand.astro';

const path = Astro.url.pathname;
const base = '/NX-Studio';
const isActive = (href: string) => {
  if (href === `${base}/`) {
    return path === `${base}/` || path === `${base}` || path === '/' || path === '/NX-Studio/';
  }
  return path.startsWith(href);
};

const links = [
  { href: `${base}/`,           label: 'Inicio' },
  { href: `${base}/servicios/`, label: 'Servicios' },
  { href: `${base}/productos/`, label: 'Productos' },
  { href: `${base}/cotizador`,  label: 'Cotizador' },
  { href: `${base}/templates`,  label: 'Templates' },
  { href: `${base}/laboratorio`,label: 'Laboratorio' },
  { href: `${base}/contacto`,   label: 'Licitar' },
];
---

<header class="sticky top-0 z-50 border-b border-nx-border bg-nx-bg/80 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <Brand variant="lockup" size="md" href={`${base}/`} />

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class={`nav-link ${isActive(l.href) ? 'nav-active' : ''}`}>{l.label}</a>
        </li>
      ))}
    </ul>

    <a href={`${base}/contacto`} class="hidden md:inline-flex items-center gap-2 lava-btn" style="padding: 0.5rem 1.25rem;">
      Pedir propuesta →
    </a>

    <button id="mobile-toggle" class="md:hidden rounded-md border border-nx-border p-2" aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-nx-border md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {links.map((l) => (
        <li><a href={l.href} class="nav-link block">{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>