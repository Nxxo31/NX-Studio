---
const reasons = [
  { title: "Enfoque personalizado", desc: "No usamos plantillas genéricas. Cada solución se desarrolla desde cero para tu etapa de negocio." },
  { title: "Calidad profesional", desc: "Código limpio, documentado y mantenible siguiendo las mejores prácticas de la industria." },
  { title: "Enfoque en resultados", desc: "Medimos éxito por impacto real: aumento de ventas, eficiencia operativa, satisfacción del cliente." },
  { title: "Soporte continuo", desc: "No solo entregamos y nos vamos. Mantenimiento, actualizaciones y soporte técnico permanente." },
];
---

<section id="porque" class="border-t border-nx-border px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-3xl font-bold md:text-4xl">Por qué NX-Studio</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {reasons.map((r, i) => (
        <div class="rounded-xl border border-nx-border p-6">
          <div class="font-display text-2xl font-bold text-nx-primary">0{i + 1}</div>
          <h3 class="mt-3 font-semibold">{r.title}</h3>
          <p class="mt-2 text-sm text-nx-muted">{r.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
