---
const products = [
  {
    code: "CLF",
    name: "CliniFlow",
    desc: "Gestión clínica para consultorios y pequeños hospitales.",
    impact: "−40% tiempo administrativo",
    time: "6–8 sem",
  },
  {
    code: "MCL",
    name: "MercadoLocal",
    desc: "E-commerce hiperlocal para mercados y emprendedores.",
    impact: "+60% alcance de clientes",
    time: "4–6 sem",
  },
  {
    code: "RTO",
    name: "RutaÓptima",
    desc: "Gestión de flota y logística en tiempo real.",
    impact: "−32% consumo combustible",
    time: "8–10 sem",
  },
  {
    code: "EDF",
    name: "EducaFlex",
    desc: "Plataforma de aprendizaje adaptativo.",
    impact: "+30% tasa de completion",
    time: "10–12 sem",
  },
];
---

<section id="proyectos" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ productos</p>
        <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Soluciones pre-construidas</h2>
      </div>
      <p class="max-w-md text-nx-muted">
        Para desafíos regionales comunes — listas para personalizar e instalar.
      </p>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => (
        <article class="reveal card-hover group relative overflow-hidden rounded-2xl border border-nx-border bg-nx-surface p-6">
          <div class="font-mono text-xs text-nx-dim">{p.code}</div>
          <h3 class="mt-4 font-display text-xl font-semibold">{p.name}</h3>
          <p class="mt-2 text-sm text-nx-muted">{p.desc}</p>
          <div class="mt-6 border-t border-nx-border pt-4">
            <div class="font-mono text-xs text-nx-accent">{p.impact}</div>
            <div class="mt-1 text-xs text-nx-dim">Implementación {p.time}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
