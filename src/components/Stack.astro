---
const groups = [
  {
    name: "Frontend",
    items: ["React", "Vue.js", "Astro", "TypeScript", "Tailwind", "React Native", "Flutter"],
  },
  {
    name: "Backend",
    items: ["Node.js", "Python", "FastAPI", "Django", "PostgreSQL", "MongoDB", "Redis"],
  },
  {
    name: "Herramientas",
    items: ["Git", "GitHub Actions", "Docker", "AWS", "Figma", "Playwright", "Vitest"],
  },
];
---

<section id="stack" class="border-t border-nx-border px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-3xl font-bold md:text-4xl">Stack</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {groups.map((g) => (
        <div class="rounded-xl border border-nx-border bg-nx-surface p-6">
          <h3 class="font-semibold text-nx-accent">{g.name}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.items.map((t) => (
              <li class="rounded-full border border-nx-border px-3 py-1 text-xs text-nx-muted">
                {t}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
