---
const groups = [
  {
    name: "Lenguajes & Frameworks",
    items: ["TypeScript", "Python", "Node.js", "React", "Vue", "Astro", "Flutter", "FastAPI", "Django"],
  },
  {
    name: "Datos & Backend",
    items: ["PostgreSQL", "MongoDB", "Redis", "Elasticsearch", "Kafka", "Prisma"],
  },
  {
    name: "Infraestructura & Cloud",
    items: ["AWS", "GCP", "Docker", "Kubernetes", "Terraform", "Vercel", "Cloudflare"],
  },
  {
    name: "IA & Data",
    items: ["PyTorch", "TensorFlow", "Hugging Face", "OpenCV", "spaCy", "MLflow"],
  },
];
---

<section id="stack" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ stack</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Tecnologías que dominamos</h2>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-2">
      {groups.map((g) => (
        <div class="reveal">
          <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-nx-muted">{g.name}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {g.items.map((t) => (
              <span class="rounded-md border border-nx-border bg-nx-surface px-3 py-1.5 font-mono text-xs transition-colors hover:border-nx-primary/50 hover:bg-nx-primary/10">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
