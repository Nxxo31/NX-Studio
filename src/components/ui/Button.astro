---
type Variant = 'primary' | 'ghost' | 'danger';
type Size = 'sm' | 'md' | 'lg';
interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  id?: string;
  name?: string;
  value?: string;
}
const { variant = 'primary', size = 'md', href, type = 'button', disabled = false, class: className = '', id, name, value } = Astro.props;
const variantClass = variant === 'primary' ? 'nx-btn' : variant === 'danger' ? 'nx-btn-danger' : 'nx-btn-ghost';
const sizeClass = size === 'sm' ? 'nx-btn-sm' : size === 'lg' ? 'nx-btn-lg' : '';
const cls = [variantClass, sizeClass, className].filter(Boolean).join(' ');
---
{href ? (<a href={href} class={cls} id={id}><slot /></a>) : (<button type={type} class={cls} id={id} name={name} value={value} disabled={disabled}><slot /></button>)}