---
type Variant = 'default' | 'raised' | 'ghost';
interface Props { variant?: Variant; class?: string; }
const { variant = 'default', class: className = '' } = Astro.props;
const cls = ['nx-card', variant !== 'default' ? `nx-card-${variant}` : '', className].filter(Boolean).join(' ');
---
<section class={cls}>
  {Astro.slots.has('header') && (<header class="nx-card-header"><slot name="header" /></header>)}
  <div class="nx-card-body"><slot /></div>
  {Astro.slots.has('footer') && (<footer class="nx-card-footer"><slot name="footer" /></footer>)}
</section>
<style>
  .nx-card { background: var(--color-nx-surface, #11132a); border: 1px solid var(--color-nx-border, rgba(255,255,255,0.08)); border-radius: 0.75rem; padding: 1.5rem; color: var(--color-nx-ink, #e8eaf6); }
  .nx-card-raised { background: var(--color-nx-raised, #181a35); box-shadow: 0 6px 24px rgba(0,0,0,0.2); }
  .nx-card-ghost { background: transparent; border-style: dashed; }
  .nx-card-header { margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-nx-border, rgba(255,255,255,0.08)); }
  .nx-card-footer { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-nx-border, rgba(255,255,255,0.08)); }
</style>