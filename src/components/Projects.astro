---
const projects = [
  {
    icon: "🏆",
    title: "Plataforma Educativa Interactiva",
    stack: "React · Node.js · MongoDB · AWS",
    impact: "500+ estudiantes activos · 95% de satisfacción reportada",
  },
  {
    icon: "💰",
    title: "Sistema de Gestión Financiera",
    stack: "Vue.js · Express · PostgreSQL · Docker",
    impact: "Reducción del 40% en tiempo de procesamiento financiero para PYMES",
  },
  {
    icon: "📱",
    title: "App de Salud y Bienestar",
    stack: "React Native · Firebase · Stripe",
    impact: "2000+ descargas · retención del 65% a 3 meses",
  },
];
---

<section id="proyectos" class="border-t border-nx-border px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-3xl font-bold md:text-4xl">Proyectos destacados</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {projects.map((p) => (
        <article class="rounded-2xl border border-nx-border bg-nx-surface p-6">
          <div class="text-3xl">{p.icon}</div>
          <h3 class="mt-4 font-semibold">{p.title}</h3>
          <p class="mt-2 font-mono text-xs text-nx-accent">{p.stack}</p>
          <p class="mt-3 text-sm text-nx-muted">{p.impact}</p>
        </article>
      ))}
    </div>
  </div>
</section>
