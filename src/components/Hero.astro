<section class="relative overflow-hidden px-6 pt-40 pb-24">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 left-1/2 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-nx-primary/15 blur-3xl"></div>
  </div>
  <div class="relative mx-auto max-w-4xl text-center">
    <p class="mb-4 inline-block rounded-full border border-nx-border bg-nx-surface px-4 py-1 text-xs font-medium tracking-wider text-nx-accent uppercase">
      Estudio de desarrollo · Latinoamérica
    </p>
    <h1 class="font-display text-5xl leading-tight font-bold tracking-tight md:text-6xl">
      Transformamos ideas en
      <span class="bg-gradient-to-r from-nx-primary to-nx-accent bg-clip-text text-transparent">
        software de alto impacto
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-nx-muted">
      Desarrollo web premium, aplicaciones móviles, sistemas de gestión y automatización con IA.
      Sin plantillas genéricas — código hecho a la medida de tu negocio.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#contacto"
        class="rounded-full bg-nx-primary px-8 py-3 font-semibold text-white transition-colors hover:bg-nx-primary-dim"
      >
        Primera consulta gratis
      </a>
      <a
        href="#proyectos"
        class="rounded-full border border-nx-border px-8 py-3 font-semibold text-nx-text transition-colors hover:bg-nx-surface"
      >
        Ver proyectos
      </a>
    </div>
  </div>
</section>
