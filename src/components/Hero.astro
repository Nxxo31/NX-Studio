---
import { projects } from "../data/catalog";
const totalStack = Array.from(new Set(projects.flatMap((p) => p.stack))).length;
---

<section id="hero" class="relative overflow-hidden px-6 py-24 md:py-32">
  <!-- Gradient background -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/4 h-96 w-96 rounded-full bg-nx-accent/20 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-nx-purple/20 blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_0%,_var(--nx-bg)_70%)]"></div>
  </div>

  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col items-center text-center">
      <div class="reveal inline-flex items-center gap-2 rounded-full border border-nx-border bg-nx-surface/50 px-4 py-1.5 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono text-xs">Disponible · 4 cupos para Q4 2026</span>
      </div>

      <h1 class="reveal mt-8 font-display text-5xl font-bold leading-tight md:text-7xl lg:text-8xl">
        Software que
        <span class="block bg-gradient-to-r from-nx-accent via-nx-purple to-nx-accent bg-clip-text text-transparent">
          escala contigo
        </span>
      </h1>

      <p class="reveal mx-auto mt-6 max-w-2xl text-lg text-nx-muted md:text-xl">
        Estudio de software LATAM. Construyo producto + servicio con código abierto verificable.
        Bots de trading, ERP multi-tenant, auditoría electoral, experiencias 3D.
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/NX-Studio/laboratorio"
          class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-nx-accent to-nx-purple px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-nx-accent/30 transition hover:shadow-xl hover:shadow-nx-accent/50"
        >
          ◈ Probar Laboratorio IA
        </a>
        <a
          href="/NX-Studio/productos"
          class="inline-flex items-center gap-2 rounded-full border border-nx-border bg-nx-surface/50 px-6 py-3 text-sm font-semibold backdrop-blur transition hover:border-nx-accent"
        >
          Ver {projects.length} productos →
        </a>
      </div>

      <!-- Stats -->
      <div class="reveal mt-20 grid w-full max-w-3xl grid-cols-3 gap-8 border-y border-nx-border py-8">
        <div>
          <div class="font-display text-4xl font-bold text-nx-accent">{projects.length}</div>
          <div class="mt-1 font-mono text-xs text-nx-dim">productos en GitHub</div>
        </div>
        <div>
          <div class="font-display text-4xl font-bold text-nx-accent">{totalStack}+</div>
          <div class="mt-1 font-mono text-xs text-nx-dim">tecnologías dominadas</div>
        </div>
        <div>
          <div class="font-display text-4xl font-bold text-nx-accent">4 sem</div>
          <div class="mt-1 font-mono text-xs text-nx-dim">cycle MVP</div>
        </div>
      </div>
    </div>
  </div>
</section>