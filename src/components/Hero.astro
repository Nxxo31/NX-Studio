---
---

<section class="relative flex min-h-[100svh] items-center overflow-hidden px-6 pt-24 pb-16">
  <!-- Background orbs -->
  <div class="orb h-[540px] w-[540px] -top-40 -left-40 bg-nx-primary/25"></div>
  <div class="orb h-[420px] w-[420px] top-1/3 -right-40 bg-nx-accent/15"></div>
  <div class="orb h-[300px] w-[300px] bottom-0 left-1/3 bg-nx-amber/10"></div>

  <!-- Grid backdrop -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style={`background-image:linear-gradient(to right, currentColor 1px, transparent 1px),linear-gradient(to bottom, currentColor 1px, transparent 1px);background-size:64px 64px;`}
  ></div>

  <div class="relative mx-auto w-full max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Left: headline -->
      <div class="flex flex-col justify-center lg:col-span-7">
        <p class="reveal mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-nx-border bg-nx-surface px-3 py-1.5 text-xs font-medium tracking-wide text-nx-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-nx-accent"></span>
          NEARSHORE TECH PARTNER · LATAM
        </p>
        <h1 class="reveal font-display text-5xl leading-[1.05] font-bold tracking-tight md:text-7xl">
          Software que
          <span class="block bg-gradient-to-r from-nx-primary via-nx-primary-soft to-nx-accent bg-clip-text text-transparent">
            escala negocios
          </span>
          latinoamericanos.
        </h1>
        <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-nx-muted">
          Arquitectura de software a medida, inteligencia artificial aplicada y sistemas de gestión
          para empresas que quieren competir globalmente sin perder el contexto local.
        </p>
        <div class="reveal mt-10 flex flex-wrap gap-4">
          <a href="#contacto" class="group inline-flex items-center gap-2 rounded-full bg-nx-primary px-7 py-3.5 font-semibold text-white transition-all hover:bg-nx-primary-soft hover:shadow-lg hover:shadow-nx-primary/25">
            Agendar llamada
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a href="#modelo" class="inline-flex items-center gap-2 rounded-full border border-nx-border px-7 py-3.5 font-semibold text-nx-text transition-colors hover:bg-nx-surface">
            Ver el modelo
          </a>
        </div>

        <!-- Stats row -->
        <dl class="reveal mt-16 grid grid-cols-3 gap-6 border-t border-nx-border pt-8">
          <div>
            <dt class="text-xs uppercase tracking-wider text-nx-dim">Proyectos entregados</dt>
            <dd class="stat-value font-display text-3xl font-bold text-nx-text">20+</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-nx-dim">Satisfacción cliente</dt>
            <dd class="stat-value font-display text-3xl font-bold text-nx-text">95%</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wider text-nx-dim">Retención LTV</dt>
            <dd class="stat-value font-display text-3xl font-bold text-nx-text">65%</dd>
          </div>
        </dl>
      </div>

      <!-- Right: abstract card stack -->
      <div class="reveal hidden lg:col-span-5 lg:block">
        <div class="relative h-full min-h-[480px]">
          <!-- Floating card 1 -->
          <div class="absolute top-8 left-0 w-72 rotate-[-6deg] rounded-2xl border border-nx-border bg-nx-surface/80 p-5 backdrop-blur-xl">
            <div class="text-xs font-medium uppercase tracking-widest text-nx-dim">CliniFlow</div>
            <div class="mt-2 font-display text-lg font-semibold">Gestión clínica</div>
            <div class="mt-3 h-1.5 w-full rounded-full bg-nx-border">
              <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-nx-primary to-nx-accent"></div>
            </div>
            <div class="mt-2 text-xs text-nx-muted">−40% tiempo administrativo</div>
          </div>
          <!-- Floating card 2 -->
          <div class="absolute top-1/3 right-0 w-64 rotate-[5deg] rounded-2xl border border-nx-border bg-nx-surface/80 p-5 backdrop-blur-xl">
            <div class="text-xs font-medium uppercase tracking-widest text-nx-dim">MercadoLocal</div>
            <div class="mt-2 font-display text-lg font-semibold">E-commerce hiperlocal</div>
            <div class="mt-3 flex gap-1">
              <div class="h-6 flex-1 rounded bg-nx-primary/40"></div>
              <div class="h-6 flex-[1.5] rounded bg-nx-accent/40"></div>
              <div class="h-6 flex-1 rounded bg-nx-amber/40"></div>
            </div>
            <div class="mt-2 text-xs text-nx-muted">+60% alcance</div>
          </div>
          <!-- Floating card 3 -->
          <div class="absolute bottom-8 left-12 w-60 rotate-[-3deg] rounded-2xl border border-nx-border bg-nx-surface/80 p-5 backdrop-blur-xl">
            <div class="text-xs font-medium uppercase tracking-widest text-nx-dim">RutaÓptima</div>
            <div class="mt-2 font-display text-lg font-semibold">Logística inteligente</div>
            <div class="mt-3 font-mono text-xs text-nx-accent">−32% combustible</div>
          </div>
          <!-- Decorative grid -->
          <div class="absolute inset-x-8 top-1/4 -z-10 h-48 rounded-3xl border border-dashed border-nx-border-strong"></div>
        </div>
      </div>
    </div>
  </div>
</section>
