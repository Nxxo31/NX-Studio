---
const research = [
  {
    title: "IA para Español Latinoamericano",
    desc: "Modelos NLP especializados en variantes regionales y modismos.",
    metric: "−35% errores vs modelos genéricos",
  },
  {
    title: "Conectividad Intermitente",
    desc: "Apps que funcionan óptimamente con conexiones inestables o costosas.",
    metric: "−60% consumo de banda ancha",
  },
  {
    title: "Interfaces Inclusivas",
    desc: "UI validada con usuarios de 60+ años y baja alfabetización digital.",
    metric: "+45% éxito en tareas",
  },
];
---

<section id="lita" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-16 lg:grid-cols-2">
      <div class="reveal">
        <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ lita</p>
        <h2 class="mt-3 font-display text-4xl font-bold leading-tight md:text-5xl">
          Laboratorio de Innovación Tecnológica Aplicada
        </h2>
        <p class="mt-6 text-nx-muted">
          Dedicamos el 20% de nuestro tiempo a investigación enfocada en desafíos específicos
          de la región latinoamericana.
        </p>
        <a href="#contacto" class="mt-8 inline-flex items-center gap-2 text-nx-accent transition-colors hover:text-nx-text">
          Colabora con el lab <span>→</span>
        </a>
      </div>

      <div class="space-y-6">
        {research.map((r) => (
          <article class="reveal card-hover rounded-xl border border-nx-border bg-nx-surface p-6">
            <h3 class="font-display text-lg font-semibold">{r.title}</h3>
            <p class="mt-2 text-sm text-nx-muted">{r.desc}</p>
            <div class="mt-3 font-mono text-xs text-nx-accent">{r.metric}</div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
