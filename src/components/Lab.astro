---
const steps = ['Idea', 'Refinamiento', 'Mockup brutalista'];
---

<section id="laboratorio" class="border-t border-nx-border bg-nx-bg px-6 py-32">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <span class="lava-tag">/ laboratorio</span>
        <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">
          Describe tu idea → recibe un mockup brutalista
        </h2>
        <p class="mt-6 text-lg text-nx-muted">
          Chat conversacional + generador de wireframes brutalistas en el navegador.
          Sin registro, sin backend, sin APIs externas. Refinamos tu producto en 5
          mensajes y te entrego un mockup + spec copyable que puedes usar para pitch
          o para enseñarle a tu equipo cómo se ve tu idea.
        </p>

        <div class="mt-8 space-y-3">
          {steps.map((s, i) => (
            <div class="flex items-center gap-3">
              <span class="grid h-8 w-8 shrink-0 place-items-center border-2 border-nx-border-strong bg-nx-primary font-mono text-xs font-bold text-nx-text-on-primary">
                {i + 1}
              </span>
              <span class="text-nx-text font-mono text-sm uppercase tracking-widest">{s}</span>
            </div>
          ))}
        </div>

        <a
          href="/laboratorio"
          class="mt-10 inline-flex"
        >
          <span class="lava-btn">Probar Laboratorio →</span>
        </a>
      </div>

      <!-- Visual demo del laboratorio -->
      <div class="reveal">
        <div class="lava-card p-6">
          <!-- Header simulado -->
          <div class="flex items-center gap-2 border-b-2 border-nx-border-strong pb-3">
            <div class="flex gap-1.5">
              <span class="h-2.5 w-2.5 bg-rose-500/60"></span>
              <span class="h-2.5 w-2.5 bg-amber-500/60"></span>
              <span class="h-2.5 w-2.5 bg-emerald-500/60"></span>
            </div>
            <span class="ml-auto font-mono text-xs text-nx-dim">laboratorio.nxstudio.dev</span>
          </div>

          <!-- Chat simulado -->
          <div class="mt-4 space-y-3">
            <div class="flex gap-2">
              <div class="grid h-7 w-7 shrink-0 place-items-center border-2 border-nx-border-strong bg-nx-primary font-mono text-xs font-bold text-nx-text-on-primary">NX</div>
              <div class="border-2 border-nx-border-strong bg-nx-bg p-2 text-sm max-w-[80%]">
                ¿Qué producto quieres construir?
              </div>
            </div>
            <div class="flex gap-2 justify-end">
              <div class="border-2 border-nx-border-strong bg-nx-primary p-2 text-sm font-mono text-nx-text-on-primary max-w-[80%]">
                App para que restaurantes gestionen inventario
              </div>
            </div>
            <div class="flex gap-2">
              <div class="grid h-7 w-7 shrink-0 place-items-center border-2 border-nx-border-strong bg-nx-primary font-mono text-xs font-bold text-nx-text-on-primary">NX</div>
              <div class="border-2 border-nx-border-strong bg-nx-bg p-2 text-sm max-w-[80%]">
                Interesante. ¿En qué plataforma?
              </div>
            </div>
            <div class="flex gap-2 justify-end">
              <div class="border-2 border-nx-border-strong bg-nx-primary p-2 text-sm font-mono text-nx-text-on-primary max-w-[80%]">
                Mobile, Android primero
              </div>
            </div>
          </div>

          <!-- Mockup placeholder -->
          <div class="mt-4 aspect-video border-2 border-nx-border-strong bg-nx-surface grid place-items-center">
            <div class="text-center">
              <div class="text-4xl font-display text-nx-primary">◇</div>
              <p class="mt-2 font-mono text-xs uppercase tracking-widest text-nx-dim">Mockup brutalista · v1</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>