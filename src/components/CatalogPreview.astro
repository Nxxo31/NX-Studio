---
import { projects } from "../data/catalog";
const featured = projects.slice(0, 6);
---

<section id="productos" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ catálogo</p>
        <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">
          Productos construidos, no prometidos
        </h2>
        <p class="mt-3 max-w-md text-nx-muted">
          Cada uno es un repositorio público en github.com/Nxxo31.
          Mismo stack, misma calidad que entrego a clientes.
        </p>
      </div>
      <a
        href="/NX-Studio/productos"
        class="inline-flex items-center gap-2 rounded-full border border-nx-border px-5 py-2 text-sm hover:border-nx-accent transition"
      >
        Ver catálogo completo ({projects.length}) →
      </a>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <a
          href={`/NX-Studio/productos/${p.slug}`}
          class="reveal card-hover group relative overflow-hidden rounded-2xl border border-nx-border bg-nx-surface p-6 transition hover:border-nx-accent/40 hover:shadow-2xl hover:shadow-nx-accent/10"
        >
          <div class="flex items-start justify-between">
            <div class="font-mono text-xs text-nx-dim">{p.code}</div>
            <span class="rounded-md bg-nx-bg px-2 py-1 font-mono text-xs text-nx-dim">{p.category}</span>
          </div>

          <h3 class="mt-4 font-display text-xl font-semibold">{p.name}</h3>
          <p class="mt-2 text-sm text-nx-muted">{p.tagline}</p>

          <div class="mt-6 flex flex-wrap gap-1.5">
            {p.stack.slice(0, 3).map((s) => (
              <span class="rounded-md bg-nx-bg px-2 py-1 font-mono text-xs text-nx-dim">{s}</span>
            ))}
          </div>

          <div class="mt-6 border-t border-nx-border pt-4 flex items-center justify-between">
            <span class="font-mono text-xs text-nx-accent">{p.impact}</span>
            <span class="font-mono text-xs text-nx-dim group-hover:text-nx-accent transition">Ver →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>