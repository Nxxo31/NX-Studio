---
const testimonials = [
  {
    text: "NX-Studio transformó nuestra idea en una aplicación que superó todas nuestras expectativas. El profesionalismo y atención al detalle fueron excepcionales.",
    author: "Cliente",
    role: "Sector Educación",
    metric: "95% satisfacción",
  },
  {
    text: "Gracias al sistema de gestión desarrollado, redujimos nuestros costos operativos en un 30% y mejoramos significativamente la experiencia de nuestros clientes.",
    author: "Emprendedor",
    role: "Sector Retail",
    metric: "−30% costos operativos",
  },
];
---

<section id="testimonios" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ testimonios</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Clientes que ya confían</h2>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-2">
      {testimonials.map((t) => (
        <figure class="reveal card-hover rounded-2xl border border-nx-border bg-nx-surface p-8">
          <svg class="h-8 w-8 text-nx-primary" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <blockquote class="mt-4 text-lg leading-relaxed text-nx-text">
            {t.text}
          </blockquote>
          <figcaption class="mt-6 flex items-center justify-between border-t border-nx-border pt-4">
            <div>
              <div class="font-semibold">{t.author}</div>
              <div class="text-sm text-nx-muted">{t.role}</div>
            </div>
            <div class="rounded-full border border-nx-primary/30 bg-nx-primary/10 px-3 py-1 font-mono text-xs text-nx-primary">
              {t.metric}
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
