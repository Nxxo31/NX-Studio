---
// ArchitectureDiagram — visual simplificado del stack típico
// Diseñado para clientes no técnicos: muestra cómo se conectan las piezas
// de un producto digital. SVG inline, interactivo al hover (resaltar capas).

const layers = [
  {
    id: 'user',
    label: 'Tus usuarios',
    sub: 'Web · Mobile · PWA',
    biz: 'La persona que usa tu sistema. Lo que ve y cómo interactúa.',
    color: '#ff6a00',
  },
  {
    id: 'frontend',
    label: 'Frontend',
    sub: 'React · Next.js · Astro',
    biz: 'Lo que se ve en la pantalla. Botones, formularios, animaciones.',
    color: '#ff4500',
  },
  {
    id: 'api',
    label: 'API',
    sub: 'Endpoints · Validación',
    biz: 'El "cajero" que recibe pedidos del frontend y devuelve respuestas.',
    color: '#d97706',
  },
  {
    id: 'backend',
    label: 'Backend',
    sub: 'Node.js · Go · Python',
    biz: 'La lógica de negocio. Reglas, cálculos, automatizaciones, integraciones.',
    color: '#8b0000',
  },
  {
    id: 'data',
    label: 'Datos',
    sub: 'Postgres · Redis · Storage',
    biz: 'Donde vive todo: clientes, pedidos, archivos, historial.',
    color: '#5a1a0a',
  },
  {
    id: 'ai',
    label: 'IA',
    sub: 'OpenAI · Claude · RAG',
    biz: 'Capa opcional que entiende texto, imágenes o patrones. Si tu negocio la necesita.',
    color: '#ff8c00',
  },
];

const flows = [
  { from: 'user', to: 'frontend' },
  { from: 'frontend', to: 'api' },
  { from: 'api', to: 'backend' },
  { from: 'backend', to: 'data' },
  { from: 'backend', to: 'ai' },
];
---

<section class="relative px-6 py-20 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 reveal">
      <div class="lava-tag mb-4">// arquitectura · cómo se construye un sistema</div>
      <h2 class="font-display text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        Anatomía de un <span class="text-lava">producto digital</span>
      </h2>
      <p class="text-nx-muted max-w-2xl text-lg">
        Cómo se conectan las piezas de un sistema moderno. Esta es la arquitectura típica que construimos.
        Click en cada capa para entender qué hace.
      </p>
    </header>

    <!-- Diagram: vertical stack con SVG connectors -->
    <div class="lava-card p-6 lg:p-10 reveal">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">

        <!-- Visual diagram -->
        <div class="relative">
          <svg viewBox="0 0 400 520" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="lavaFlow" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#ff6a00" stop-opacity="0.6" />
                <stop offset="100%" stop-color="#8b0000" stop-opacity="0.2" />
              </linearGradient>
              <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
                <polygon points="0 0, 10 5, 0 10" fill="#ff6a00" />
              </marker>
            </defs>

            {/* Layer boxes */}
            {layers.map((layer, i) => {
              const y = 20 + i * 80;
              const isAI = layer.id === 'ai';
              return (
                <g>
                  <rect
                    x="50" y={y} width="300" height="60"
                    fill={`${layer.color}22`}
                    stroke={layer.color}
                    stroke-width="1.5"
                    rx="6"
                  />
                  <text x="70" y={y + 25} fill="#f5e6d3" font-family="Space Grotesk" font-weight="600" font-size="15">
                    {layer.label}
                  </text>
                  <text x="70" y={y + 45} fill="#a89580" font-family="JetBrains Mono" font-size="10">
                    {layer.sub}
                  </text>
                  {isAI && (
                    <text x="320" y={y + 25} fill="#ff8c00" font-family="JetBrains Mono" font-size="10" text-anchor="end">
                      opcional
                    </text>
                  )}
                </g>
              );
            })}

            {/* Flow arrows */}
            {flows.map((flow, i) => {
              const fromIdx = layers.findIndex((l) => l.id === flow.from);
              const toIdx = layers.findIndex((l) => l.id === flow.to);
              const y1 = 20 + fromIdx * 80 + 60;
              const y2 = 20 + toIdx * 80;
              return (
                <line
                  x1="200" y1={y1} x2="200" y2={y2 - 5}
                  stroke="url(#lavaFlow)"
                  stroke-width="2"
                  marker-end="url(#arrowhead)"
                  stroke-dasharray="3 3"
                />
              );
            })}

            {/* Vertical accent line */}
            <line x1="200" y1="10" x2="200" y2="510" stroke="#ff4500" stroke-width="0.5" stroke-opacity="0.2" />
          </svg>
        </div>

        <!-- Layer descriptions -->
        <div class="space-y-2">
          {layers.map((layer) => (
            <details class="lava-card p-4 group">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <div class="flex items-center gap-3">
                  <span class="h-3 w-3 rounded-sm shrink-0" style={`background: ${layer.color}`}></span>
                  <span class="font-display font-semibold">{layer.label}</span>
                  <span class="font-mono text-xs text-nx-dim">{layer.sub}</span>
                </div>
                <span class="font-mono text-xs text-nx-dim group-open:rotate-90 transition">▸</span>
              </summary>
              <p class="mt-3 text-sm text-nx-muted leading-relaxed pl-6">{layer.biz}</p>
            </details>
          ))}
        </div>

      </div>

      <!-- Caption final -->
      <div class="mt-8 pt-6 border-t border-nx-border flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <p class="text-sm text-nx-muted">
          <b class="text-nx-text">¿Por qué importa?</b> Porque cada capa puede fallar o costar caro por separado.
          Diseñamos pensando en qué pasa cuando tienes 10 usuarios... y cuando tienes 10,000.
        </p>
        <a href="/NX-Studio/cotizador" class="font-mono text-xs text-lava-edge hover:text-lava transition shrink-0">
          ver pricing por capa →
        </a>
      </div>
    </div>
  </div>
</section>