---
// WebGLBackground — fondo visual lava neon.
// Implementación: puro CSS (gradiente radial + grid lines).
// Razón: NX-Studio es SSG en GitHub Pages — sin three.js, sin GSAP, sin lenis.
// Beneficio: zero JS, mejor Core Web Vitals, sin superficie de ataque extra.
// El fallback CSS ya existía en global.css; aquí consolidamos el overlay decorativo.
---

<div id="nx-bg-fallback" aria-hidden="true" class="fixed inset-0 pointer-events-none" style="z-index: -2;"></div>

<div class="lava-vignette-mask" aria-hidden="true"></div>

<style>
  #nx-bg-fallback {
    background:
      radial-gradient(ellipse at 50% 0%, #1f0a08 0%, #0a0608 50%),
      linear-gradient(to right, rgba(255, 69, 0, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 69, 0, 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 80px 56px, 80px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 30%, transparent 80%);
  }
  @media (prefers-reduced-motion: reduce) {
    #nx-bg-fallback { opacity: 0.6; }
  }
</style>