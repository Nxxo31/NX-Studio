---
// WebGLBackground — fondo cyber interactivo full-page
// Three.js vanilla + GSAP (sin R3F para mantener bundle ligero)
// Cubre TODA la página con un canvas fixed, todas las páginas lo incluyen
// Renderiza: cubos/tetraedros/octaedros flotando + red de partículas conectadas
// + grid lines sutiles. Mouse-reactive, scroll-aware, reduced-motion safe.
---

<canvas
  id="nx-bg-canvas"
  aria-hidden="true"
  class="fixed inset-0 w-full h-full pointer-events-none"
  style="z-index: -1;"
></canvas>

<div id="nx-bg-fallback" aria-hidden="true" class="fixed inset-0 pointer-events-none" style="z-index: -2;"></div>

<style>
  #nx-bg-canvas {
    background: radial-gradient(ellipse at 50% 0%, #1f0a08 0%, #0a0608 50%);
  }
  #nx-bg-fallback {
    background:
      linear-gradient(to right, rgba(255, 69, 0, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 69, 0, 0.04) 1px, transparent 1px);
    background-size: 80px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, black 30%, transparent 80%);
  }
  @media (prefers-reduced-motion: reduce) {
    #nx-bg-canvas { display: none; }
  }
</style>

<script>
  import * as THREE from 'three';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion) {
    const canvas = document.getElementById('nx-bg-canvas') as HTMLCanvasElement;
    if (!canvas) throw new Error('nx-bg-canvas not found');

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x0a0608, 8, 25);

    const camera = new THREE.PerspectiveCamera(
      55,
      window.innerWidth / window.innerHeight,
      0.1,
      100
    );
    camera.position.set(0, 0, 14);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight, false);
    renderer.setClearColor(0x000000, 0);

    // ============================================================
    // 1. Floating geometries — cubos, tetraedros, octaedros
    // ============================================================
    type Mesh = THREE.Mesh<THREE.BufferGeometry, THREE.MeshBasicMaterial>;
    const meshes: Mesh[] = [];
    const geometries = [
      new THREE.BoxGeometry(0.3, 0.3, 0.3),
      new THREE.TetrahedronGeometry(0.25),
      new THREE.OctahedronGeometry(0.25),
      new THREE.IcosahedronGeometry(0.22),
    ];

    const colors = [0xff4500, 0xff6a00, 0x8b0000, 0xd97706];

    for (let i = 0; i < 60; i++) {
      const geo = geometries[Math.floor(Math.random() * geometries.length)];
      const color = colors[Math.floor(Math.random() * colors.length)];
      const mat = new THREE.MeshBasicMaterial({
        color,
        wireframe: true,
        transparent: true,
        opacity: 0.45 + Math.random() * 0.35,
      });
      const mesh = new THREE.Mesh(geo, mat) as Mesh;
      const scale = 0.4 + Math.random() * 1.6;
      mesh.scale.setScalar(scale);

      // Distribución en 3D con z lejano
      mesh.position.set(
        (Math.random() - 0.5) * 24,
        (Math.random() - 0.5) * 16,
        (Math.random() - 0.5) * 12 - 2
      );

      const rotSpeed = {
        x: (Math.random() - 0.5) * 0.005,
        y: (Math.random() - 0.5) * 0.008,
        z: (Math.random() - 0.5) * 0.004,
      };
      const floatSpeed = 0.0005 + Math.random() * 0.0015;
      const floatAmp = 0.3 + Math.random() * 0.6;

      (mesh as any).userData = { rotSpeed, floatSpeed, floatAmp, baseY: mesh.position.y };

      meshes.push(mesh);
      scene.add(mesh);
    }

    // ============================================================
    // 2. Particle lattice — red de partículas conectadas
    // ============================================================
    const PARTICLE_COUNT = 220;
    const particlePositions = new Float32Array(PARTICLE_COUNT * 3);
    const particleVelocities = new Float32Array(PARTICLE_COUNT * 3);

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particlePositions[i * 3 + 0] = (Math.random() - 0.5) * 28;
      particlePositions[i * 3 + 1] = (Math.random() - 0.5) * 18;
      particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 14 - 2;
      particleVelocities[i * 3 + 0] = (Math.random() - 0.5) * 0.003;
      particleVelocities[i * 3 + 1] = (Math.random() - 0.5) * 0.003;
      particleVelocities[i * 3 + 2] = 0;
    }

    const particleGeo = new THREE.BufferGeometry();
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    const particleMat = new THREE.PointsMaterial({
      color: 0xff6a00,
      size: 0.04,
      transparent: true,
      opacity: 0.85,
      sizeAttenuation: true,
    });
    const particles = new THREE.Points(particleGeo, particleMat);
    scene.add(particles);

    // Lineas conectando partículas cercanas
    const MAX_LINES = 320;
    const linePositions = new Float32Array(MAX_LINES * 2 * 3);
    const lineColors = new Float32Array(MAX_LINES * 2 * 3);
    const lineGeo = new THREE.BufferGeometry();
    lineGeo.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
    lineGeo.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));
    const lineMat = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.35,
      blending: THREE.AdditiveBlending,
    });
    const lines = new THREE.LineSegments(lineGeo, lineMat);
    scene.add(lines);

    // ============================================================
    // 3. Grid plane sutil — referencia espacial
    // ============================================================
    const grid = new THREE.GridHelper(40, 40, 0xff4500, 0x4a1a0a);
    grid.position.y = -8;
    grid.material.transparent = true;
    (grid.material as THREE.Material).opacity = 0.18;
    scene.add(grid);

    // ============================================================
    // 4. Mouse + scroll state
    // ============================================================
    const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
    let scrollY = 0;

    window.addEventListener('mousemove', (e) => {
      mouse.tx = (e.clientX / window.innerWidth - 0.5) * 2;
      mouse.ty = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    }, { passive: true });

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight, false);
    });

    // ============================================================
    // 5. Animation loop
    // ============================================================
    let lineIndex = 0;

    function updateLines() {
      const posAttr = lineGeo.getAttribute('position') as THREE.BufferAttribute;
      const colAttr = lineGeo.getAttribute('color') as THREE.BufferAttribute;
      lineIndex = 0;

      for (let i = 0; i < PARTICLE_COUNT && lineIndex < MAX_LINES; i++) {
        const ix = particlePositions[i * 3 + 0];
        const iy = particlePositions[i * 3 + 1];
        const iz = particlePositions[i * 3 + 2];

        for (let j = i + 1; j < PARTICLE_COUNT && lineIndex < MAX_LINES; j++) {
          const jx = particlePositions[j * 3 + 0];
          const jy = particlePositions[j * 3 + 1];
          const jz = particlePositions[j * 3 + 2];
          const dx = ix - jx;
          const dy = iy - jy;
          const dz = iz - jz;
          const distSq = dx * dx + dy * dy + dz * dz;
          const maxDist = 2.4;

          if (distSq < maxDist * maxDist) {
            const dist = Math.sqrt(distSq);
            const alpha = 1 - dist / maxDist;
            linePositions[lineIndex * 6 + 0] = ix;
            linePositions[lineIndex * 6 + 1] = iy;
            linePositions[lineIndex * 6 + 2] = iz;
            linePositions[lineIndex * 6 + 3] = jx;
            linePositions[lineIndex * 6 + 4] = jy;
            linePositions[lineIndex * 6 + 5] = jz;
            lineColors[lineIndex * 6 + 0] = 1.0 * alpha;
            lineColors[lineIndex * 6 + 1] = 0.42 * alpha;
            lineColors[lineIndex * 6 + 2] = 0.0;
            lineColors[lineIndex * 6 + 3] = 1.0 * alpha;
            lineColors[lineIndex * 6 + 4] = 0.42 * alpha;
            lineColors[lineIndex * 6 + 5] = 0.0;
            lineIndex++;
          }
        }
      }

      // Ocultar líneas no usadas colapsando a (0,0,0)
      for (let i = lineIndex; i < MAX_LINES; i++) {
        for (let k = 0; k < 6; k++) linePositions[i * 6 + k] = 0;
      }
      posAttr.needsUpdate = true;
      colAttr.needsUpdate = true;
      lineGeo.setDrawRange(0, lineIndex * 2);
    }

    function animate() {
      // Mouse damping
      mouse.x += (mouse.tx - mouse.x) * 0.05;
      mouse.y += (mouse.ty - mouse.y) * 0.05;

      // Camera slight parallax
      camera.position.x = mouse.x * 1.2;
      camera.position.y = -mouse.y * 0.8 + scrollY * 0.001;
      camera.lookAt(0, 0, 0);

      // Rotate geometries
      for (const mesh of meshes) {
        const { rotSpeed, floatSpeed, floatAmp, baseY } = mesh.userData;
        mesh.rotation.x += rotSpeed.x;
        mesh.rotation.y += rotSpeed.y;
        mesh.rotation.z += rotSpeed.z;
        mesh.position.y = baseY + Math.sin(Date.now() * floatSpeed) * floatAmp;
      }

      // Update particle positions
      const posAttr = particleGeo.getAttribute('position') as THREE.BufferAttribute;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particlePositions[i * 3 + 0] += particleVelocities[i * 3 + 0];
        particlePositions[i * 3 + 1] += particleVelocities[i * 3 + 1];

        // Mouse repulsion
        const px = particlePositions[i * 3 + 0];
        const py = particlePositions[i * 3 + 1];
        const dx = px - mouse.x * 6;
        const dy = py + mouse.y * 4;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 2.5) {
          const force = (2.5 - dist) / 2.5;
          particlePositions[i * 3 + 0] += (dx / dist) * force * 0.05;
          particlePositions[i * 3 + 1] += (dy / dist) * force * 0.05;
        }

        // Wrap-around boundaries
        if (particlePositions[i * 3 + 0] > 14) particlePositions[i * 3 + 0] = -14;
        if (particlePositions[i * 3 + 0] < -14) particlePositions[i * 3 + 0] = 14;
        if (particlePositions[i * 3 + 1] > 9) particlePositions[i * 3 + 1] = -9;
        if (particlePositions[i * 3 + 1] < -9) particlePositions[i * 3 + 1] = 9;
      }
      posAttr.needsUpdate = true;

      updateLines();

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    animate();
  }
</script>