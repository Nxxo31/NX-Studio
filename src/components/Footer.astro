---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocale, getT, localeUrl } from '../i18n';

const year = new Date().getFullYear();
const locale = getLocale(Astro);
const t = getT(locale);
---

<footer class="border-t border-nx-border bg-nx-surface px-6 py-16">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 md:grid-cols-4">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold">
          <span class="grid h-10 w-10 place-items-center rounded-md font-mono text-sm text-black" style="background: linear-gradient(135deg, var(--lava-core), var(--lava-edge));">NX</span>
          <span>NX-Studio</span>
        </a>
        <p class="mt-4 max-w-md text-sm text-nx-muted">
          {t('footer.tagline')}
        </p>
        <p class="mt-6 font-mono text-xs text-nx-dim">
          {t('footer.author')}
        </p>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-widest" style="color: var(--lava-edge);">{t('footer.colSitio')}</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={localeUrl('/cotizador', locale)} class="text-nx-muted hover:text-nx-text">{t('footer.linkCotizador')}</a></li>
          <li><a href={localeUrl('/laboratorio', locale)} class="text-nx-muted hover:text-nx-text">{t('footer.linkLaboratorio')}</a></li>
          <li><a href={localeUrl('/contacto', locale)} class="text-nx-muted hover:text-nx-text">{t('footer.linkContacto')}</a></li>
          <li><a href={localeUrl('/docs', locale)} class="text-nx-muted hover:text-nx-text">{t('footer.linkDocs')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-widest" style="color: var(--lava-edge);">{t('footer.colContacto')}</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="mailto:hola@nxstudio.dev" class="text-nx-muted hover:text-nx-text">hola@nxstudio.dev</a></li>
          <li><a href="https://github.com/Nxxo31" target="_blank" rel="noopener" class="text-nx-muted hover:text-nx-text">GitHub · Nxxo31</a></li>
          <li><a href="https://github.com/Nxxo31/NX-Studio" target="_blank" rel="noopener" class="text-nx-muted hover:text-nx-text">Repo NX-Studio</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-nx-border pt-8 md:flex-row md:items-center md:justify-between">
      <p class="font-mono text-xs text-nx-dim">© {year} NX-Studio · Neiva, COL · UTC-05</p>
      <LanguageSwitcher />
      <p class="font-mono text-xs text-nx-dim">{t('footer.built')}</p>
    </div>
  </div>
</footer>