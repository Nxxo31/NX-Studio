---
const tiers = [
  { name: 'Prototipo', price: '$0', period: '14 días', badge: 'GRATIS' },
  { name: 'MVP', price: 'Desde $3.500', period: 'USD · 4 sem', badge: 'POPULAR', highlight: true },
  { name: 'Retainer', price: '$1.200', period: 'USD / mes', badge: 'EVOLUCIÓN' },
];
---

<section id="precios" class="border-t border-nx-border px-6 py-32">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center">
      <p class="font-mono text-sm uppercase tracking-widest text-nx-accent">/ precios</p>
      <h2 class="mt-3 font-display text-4xl font-bold md:text-5xl">Precios transparentes</h2>
      <p class="mx-auto mt-4 max-w-2xl text-nx-muted">
        Sin sorpresas, sin cláusulas ocultas.
        Empieza gratis, escala cuando tenga sentido.
      </p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {tiers.map((t) => (
        <article class={`reveal rounded-3xl border p-8 ${t.highlight ? 'border-nx-accent bg-gradient-to-br from-nx-accent/5 to-nx-purple/5 scale-105 shadow-2xl shadow-nx-accent/20' : 'border-nx-border bg-nx-surface'}`}>
          <span class={`inline-block rounded-full px-3 py-1 font-mono text-xs ${t.highlight ? 'bg-nx-accent text-white' : 'bg-nx-bg text-nx-dim'}`}>{t.badge}</span>
          <h3 class="mt-6 font-display text-2xl font-bold">{t.name}</h3>
          <div class="mt-4 font-display text-3xl font-bold">{t.price}</div>
          <div class="mt-1 font-mono text-xs text-nx-dim">{t.period}</div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/NX-Studio/precios"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-nx-accent to-nx-purple px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-nx-accent/30"
      >
        Ver detalles completos →
      </a>
    </div>
  </div>
</section>