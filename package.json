{
  "name": "nx-studio",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "node scripts/preview-clean.mjs dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:clean": "node scripts/preview-clean.mjs preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "seed:proyectos": "tsx scripts/seed-proyectos.ts --apply-sql > _seed-proyectos.sql && echo 'Generated: _seed-proyectos.sql'",
    "seed:templates": "tsx scripts/seed-templates.ts --apply-sql > _seed-templates.sql && echo 'Generated: _seed-templates.sql'",
    "seed:dry": "tsx scripts/seed-proyectos.ts --dry-run && tsx scripts/seed-templates.ts",
    "db:create": "wrangler d1 create nx-studio-db",
    "db:migrate:local": "wrangler d1 execute nx-studio-db --local --file .wrangler/init.sql",
    "db:migrate:remote": "wrangler d1 execute nx-studio-db --remote --file .wrangler/init.sql",
    "db:seed:local": "npm run seed:proyectos && npm run seed:templates && wrangler d1 execute nx-studio-db --local --file _seed-proyectos.sql && wrangler d1 execute nx-studio-db --local --file _seed-templates.sql",
    "db:seed:remote": "npm run seed:proyectos && npm run seed:templates && wrangler d1 execute nx-studio-db --remote --file _seed-proyectos.sql && wrangler d1 execute nx-studio-db --remote --file _seed-templates.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/db": "^0.21.3",
    "astro": "^7.3.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "vitest": "^5.0.3"
  }
}
